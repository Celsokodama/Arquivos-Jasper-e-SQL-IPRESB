	<detail>
		<band height="686" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="440" height="20" uuid="b8bcd072-e914-4d61-aece-41f7fcd0ccf8"/>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="64" width="459" height="116" uuid="bda60040-5264-44d9-a9ac-f085530c4745"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["De: IPRESB – Instituto de Previdência Social dos Servidores Municipais de Barueri"+"<br/>Unidade de Gestão de Benefícios Previdenciários"+"<br/><br/>Para: "+$F{DESTINATÁRIO}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="180" width="459" height="506" uuid="b66aaa8a-cb7f-46fd-bb6c-79b518441900"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Ref.: "+$F{REF}+

"</style><br/><br/>"+($F{CONDICAO BENEF}.equals("AP")? "	Comunicamos que foi "+$F{EMITIDA OU CONCEDIDA}+" a <style isBold='true'>"+UPPER($F{BENEFICIO})+ "</style> para o(a) servidor(a) <style isBold='true'>"+$F{NOME}+"</style>, matrícula <style isBold='true'>"+$F{MATRICULA}+"</style>.<br/><br/>"+"	Seguem anexos os seguintes documentos:<br/><br/>"+ "	\u2022  Portaria<br/>" +"	\u2022  Carta de Concessão<br/>"+"	\u2022  Certidão de Concessão<br/>": 
	
($F{CONDICAO BENEF}.equals("AB")? "	Comunicamos que foi "+$F{EMITIDA OU CONCEDIDA}+" a <style isBold='true'>"+UPPER($F{BENEFICIO})+ "</style> para o(a) servidor(a) <style isBold='true'>"+$F{NOME}+"</style>, matrícula <style isBold='true'>"+$F{MATRICULA}+"</style>.<br/><br/>"+"	Seguem anexos os seguintes documentos:<br/><br/>"+ "	\u2022  Requerimento do Processo<br/>" +"	\u2022  Certidão de Abono de Permanência<br/>":
	
($F{CONDICAO BENEF}.equals("PM")? "	Comunicamos que foi "+$F{EMITIDA OU CONCEDIDA}+" a <style isBold='true'>"+UPPER($F{BENEFICIO})+ "</style> "+"<style isUnderline='true'>"+$F{DESCRIÇÃO ATIVO APOSENTADO}+"</style> <style isBold='true'>"+$F{NOME}+"</style>, matrícula <style isBold='true'>"+$F{MATRICULA}+"</style>, através da <style isBold='true'><style isUnderline='true'>Portaria nº "+$F{PORTARIA}+" de "+$F{DATA PORTARIA EXTENSO}+"</style></style> aos dependente(s):<br/><br/>"
+($F{DESCRICAO DEP 1} !=null ? "	\u2022  "+ $F{DESCRICAO DEP 1} : "")
+($F{DESCRICAO DEP 2} !=null ? "<br/>" + "	\u2022  "+ $F{DESCRICAO DEP 2} : "") 
+($F{DESCRICAO DEP 3} !=null ? "<br/>" + "	\u2022  "+ $F{DESCRICAO DEP 3} : "")
+($F{DESCRICAO DEP 4} !=null ? "<br/>" + "	\u2022  "+ $F{DESCRICAO DEP 4} : "")
+"<br/><br/><br/>"+"	Seguem anexos os seguintes documentos:<br/><br/>"+ "	\u2022  Cópia da Portaria<br/>" +"	\u2022  Certidão de Concessão<br/>"+"	\u2022  RG dos dependentes/representante legal<br/>":"")))+"<br/><br/>Atenciosamente,<br/><br/><style isBold='true'>"+$F{USUARIO}+"<br/>Matrícula "+$F{MATRICULA_USUARIO_IPRESB}+"</style>"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
