	<detail>
		<band height="686" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="440" height="20" uuid="b8bcd072-e914-4d61-aece-41f7fcd0ccf8"/>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="210" width="459" height="476" uuid="56f12c80-4e9d-4a33-8377-728873908f07"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Ref.: Solicitação de documentos - "
+ $F{DESCRIÇÃO BENEFÍCIO}
+"</style><br/><br/>	Solicitamos deste órgão a documentação abaixo para darmos prosseguimento ao processo de <style isBold='true'>"
+UPPER($F{DESCRIÇÃO BENEFÍCIO})
+ "</style> do(a) servidor(a) <style isBold='true'>"+$F{NOME}+"</style>, matrícula <style isBold='true'>"+$F{MATRICULA}+"</style>.<br/><br/>"

+"\u2022   " +"Laudo Técnico de Condições Ambientais de Trabalho - LTCAT, conforme Inciso II, do Art. 7º da Instrução Normativa MPS/SPPS Nº1 de 22/07/2010<br/><br/>"

+"\u2022   " +"Perfil Profissiográfico Previdenciário -PPP<br/>"

+"<br/><br/>Atenciosamente,<br/><br/><style isBold='true'>"+$F{USUARIO}+"<br/>Matrícula "+$F{MATRICULA_USUARIO_IPRESB}+"</style>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="64" width="459" height="146" uuid="bda60040-5264-44d9-a9ac-f085530c4745"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["De: IPRESB – Instituto de Previdência Social dos Servidores Municipais de Barueri"+"<br/>Unidade de Gestão de Benefícios Previdenciários"+"<br/><br/>Para: Secretaria  de  Administração - DTMST - Departamento  Técnico  de  Medicina  e Segurança do Trabalho"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
