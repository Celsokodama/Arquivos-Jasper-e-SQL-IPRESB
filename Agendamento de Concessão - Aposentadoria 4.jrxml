				<textElement textAlignment="Justified" markup="styled">
					<font fontName="Times New Roman" size="12"/>
					<paragraph lineSpacing="Double" firstLineIndent="56"/>
				</textElement>
				<textFieldExpression><![CDATA["Dou-me por ciente que os adicionais, evoluções funcionais, licenças por assiduidade em pecúnia e demais vantagens <style isBold='true'>não "+"</style>" +"adquiridas até a data da concessão da aposentadoria" + " <style isBold='true'>não "+"</style>" +"farão parte do acerto de haveres (rescisão) e nem serão computados no benefício. <br></br>A aposentadoria, uma vez concedida,<style isBold='true'> não será revogada. </style>"]]></textFieldExpression>
