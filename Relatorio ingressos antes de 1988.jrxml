		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<queryString language="SQL">
		<![CDATA[set language portuguese

DECLARE @DATA_COMP VARCHAR (20)										
declare @CL_CONT NUMERIC(10)										
DECLARE @GRUPO NUMERIC(10)	  									
										
SET @DATA_COMP = GETDATE()
SET @CL_CONT = 2										
SET @GRUPO = 1										
										
/*										
delete RESUMOPAGAMENTOBANCO										
from RESUMOPAGAMENTOBANCO as rpb										
join BENEFICIOPESSOA AS BP										
ON BP.N_PROT_BNFPESSOA = rpb.N_PROT_BNFPESSOA										
JOIN TIPOBENEFICIO AS TB										
ON TB.N_TIPBNF_TIPBNF = BP.N_TIPBNF_TIPBNF 										
where DT_PAGTO_RESMPAGTOBCO ='2021-11-30' AND TB.N_GRPBNF_GRPBNF = 1 AND BP.N_COD_CLSCTB = 2*/										
										
----AND S_TIPCTACORR_RESMPAGTOBCO='C'										
--order by 1										
select 	distinct									
P.n_pessoa_pessoa										
,NOMETITULAR										
,CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS NASC										
,CPFTITULAR										
,ISNULL(S_PISPASEP_PESSOA,'')S_PISPASEP_PESSOA										
,S_RG_PESSOA										
,ISNULL(CONVERT(VARCHAR,p.DT_EMISSRG_PESSOA,103),'') AS EMISSAO_RG										
,CASE WHEN P.S_ESTCIVIL_PESSOA ='C' THEN 'CASADO'										
	  WHEN P.S_ESTCIVIL_PESSOA ='S' THEN 'SOLTEIRO'									
	  WHEN P.S_ESTCIVIL_PESSOA ='D' THEN 'DIVORCIADO'									
	  WHEN P.S_ESTCIVIL_PESSOA ='P' THEN 'SEPARADO'									
	  WHEN P.S_ESTCIVIL_PESSOA ='U' THEN 'UNIAO ESTAVEL'									
	  WHEN P.S_ESTCIVIL_PESSOA ='V' THEN 'VIUVO'									
	  END ESTADO_CIVIL									
,PROTOCOLO										
,s_dcr_org										
,MATRICULA										
,DATA_ORGAO										
,DATA_INGRESSO_MUNICIPIO										
,DATA_INICIO_BENEFICIO										
,DATA_FIM_BENEFICIO										
,Proventos										
--,Descontos										
--,Liquido										
,N_BCO_BCO										
,S_DCR_BCO										
,N_AGE_AGE										
--,S_DCR_AGE										
,S_CTACORR_EPFPESSOAAGENCIA										
,										
ISNULL((SELECT TOP 1 '('+CAST(N_DDD_TELPESSOA AS VARCHAR)+') ' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),1,4) + '-' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),5,4) FROM TELEFONEPESSOA AS TP WHERE TP.N_PESSOA_PESSOA = TA.N_PESSOA_PESSOA AND S_TIP_TELPESSOA='R' ),'') AS TELEFONE_RESIDENCIAL,										
ISNULL((SELECT TOP 1 '('+CAST(N_DDD_TELPESSOA AS VARCHAR)+') ' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),1,5) + '-' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),6,4) FROM TELEFONEPESSOA AS TP WHERE TP.N_PESSOA_PESSOA = TA.N_PESSOA_PESSOA AND S_TIP_TELPESSOA='E' ),'') AS TELEFONE_CELULAR,										
ISNULL((SELECT TOP 1 '('+CAST(N_DDD_TELPESSOA AS VARCHAR)+') ' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),1,5) + '-' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),6,4) FROM TELEFONEPESSOA AS TP WHERE TP.N_PESSOA_PESSOA = TA.N_PESSOA_PESSOA AND S_TIP_TELPESSOA='D' ),'') AS TELEFONE_RECADO,										
ISNULL((SELECT TOP 1 '('+CAST(N_DDD_TELPESSOA AS VARCHAR)+') ' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),1,5) + '-' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),6,4) FROM TELEFONEPESSOA AS TP WHERE TP.N_PESSOA_PESSOA = TA.N_PESSOA_PESSOA AND S_TIP_TELPESSOA='C' ),'') AS TELEFONE_COMERCIAL,										
ISNULL((SELECT TOP 1 '('+CAST(N_DDD_TELPESSOA AS VARCHAR)+') ' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),1,5) + '-' + SUBSTRING(CAST(N_NUM_TELPESSOA AS VARCHAR),6,4) FROM TELEFONEPESSOA AS TP WHERE TP.N_PESSOA_PESSOA = TA.N_PESSOA_PESSOA AND S_TIP_TELPESSOA='O' ),'') AS TELEFONE_OUTROS										
,ISNULL(S_EMAIL_PESSOA,'') AS EMAIL										
--,S_DGV_EPFPESSOAAGENCIA										
--,DATAPAGTO										
--,S_DGV_AGE										
--,RATEIO										
,ISNULL(NOMEREPRES,'')	AS NOMEREPRES									
--,CPFREPRES										
--,S_DCRRESM_PLN										
--,S_DCRRESM_ORG										
--,DescFormLanc										
--,S_DCR_GRPBNF										
--,Flag										
,ISNULL(S_DCRRUA_HISTENDPESSOA,'') AS S_DCRRUA_HISTENDPESSOA										
,ISNULL(S_NUMLOGRAD_HISTENDPESSOA,'') AS S_NUMLOGRAD_HISTENDPESSOA										
,ISNULL(S_DCRBAIRRO_HISTENDPESSOA,'') AS S_DCRBAIRRO_HISTENDPESSOA										
,ISNULL(S_NOM_MUN,'') AS MUNICIPIO										
,ISNULL(S_CEP_HISTENDPESSOA,'') AS S_CEP_HISTENDPESSOA										
,ISNULL(S_DCRUF_HISTENDPESSOA,'') AS S_DCRUF_HISTENDPESSOA										
,S_DCR_GRPBNF										
,S_DCR_TIPBNF										
										
										
from(										
Select										
ORGANIZACAO.s_dcr_org,										
CONVERT(VARCHAR,(select min(op1.DT_ADM_ORGPESSOA) from ORGANIZACAOPESSOA as op1 where op1.N_PESSOA_PESSOA = titular.N_PESSOA_PESSOA),103) As DATA_INGRESSO_MUNICIPIO,										
 CONVERT(VARCHAR,OP.DT_ADM_ORGPESSOA,103) As DATA_ORGAO,										
 ISNULL(CONVERT(VARCHAR,BP.DT_DCB_BNFPESSOA,103),'') As DATA_FIM_BENEFICIO,										
  titular.n_pessoa_pessoa  ,										
  titular.DT_NASC_PESSOA,										
  TITULAR.S_NOM_PESSOA As NOMETITULAR,										
  TITULAR.S_CPF_PESSOA As CPFTITULAR,										
  BP.N_PROT_BNFPESSOA As PROTOCOLO,										
  BP.N_CODORI_ORGPESSOA As MATRICULA,	  									
  CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) As DATA_INICIO_BENEFICIO,										
  Sum(Case When R.S_NAT_RUB	= 'P' Then (HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO)									
		when r.n_rub_rub in(912,933) then (HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO) *-1  Else 0								
  End) As Proventos  ,										
  --Sum(Case R.S_NAT_RUB										
  --  When 'D' Then (( -1) * ((HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO)))										
  --  Else 0 End) As Descontos,										
  --Sum(Case R.S_NAT_RUB										
  --  When 'D' Then (( -1) * ((HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO)))										
  --  Else (HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO) End) As Liquido,										
  BANCO.N_BCO_BCO,										
  BANCO.S_DCR_BCO,										
  AGENCIA.N_AGE_AGE,										
  AGENCIA.S_DCR_AGE,										
  EPA.S_CTACORR_EPFPESSOAAGENCIA,										
  EPA.S_DGV_EPFPESSOAAGENCIA,										
  --HP.DT_PGTO_HISTPGTO As DATAPAGTO,										
  AGENCIA.S_DGV_AGE,										
  'N' As RATEIO,										
  Null As NOMEREPRES,										
  Null As CPFREPRES,										
  PLANO.S_DCRRESM_PLN,										
  ORGANIZACAO.S_DCRRESM_ORG,										
  Case EPA.S_FRMLANC_EPFPESSOAAGENCIA When 01 Then 'Crédito Conta Corrente'										
    When 02 Then 'Cheque Administrativo' When 03 Then 'DOC'										
    When 04 Then 'Crédito Conta Salário' When 05 Then 'Crédito Poupança'										
    When 10 Then 'Ordem de Pagamento' When 41 Then 'TED' End As DescFormLanc,										
  GB.S_DCR_GRPBNF,										
  Case When @DATA_COMP Is Null Then 1 Else 0 End As Flag,										
  TB.S_DCR_TIPBNF										
From										
  BENEFICIOPESSOA BP										
  Inner Join TIPOBENEFICIO TB On BP.N_TIPBNF_TIPBNF = TB.N_TIPBNF_TIPBNF										
  Inner Join HISTORICOPAGAMENTO HP On BP.N_PROT_BNFPESSOA = HP.N_PROT_BNFPESSOA										
  Inner Join ESPECIFICACAOPESSOAAGENCIA EPA On BP.N_PESSOA_PESSOA =										
    EPA.N_PESSOA_PESSOA And BP.N_TIPPESSOA_TIPPESSOA = EPA.N_TIPPESSOA_TIPPESSOA										
  Inner Join AGENCIA On EPA.N_BCO_BCO = AGENCIA.N_BCO_BCO And										
    EPA.N_AGE_AGE = AGENCIA.N_AGE_AGE And ((EPA.N_PROT_BNFPESSOA =										
        BP.N_PROT_BNFPESSOA) Or (EPA.N_PROT_BNFPESSOA Is Null))										
  Inner Join BANCO On AGENCIA.N_BCO_BCO = BANCO.N_BCO_BCO										
  Inner Join RUBRICA R On HP.N_RUB_RUB = R.N_RUB_RUB										
  Inner Join PESSOA As TITULAR On BP.N_PESSOA_PESSOA = TITULAR.N_PESSOA_PESSOA										
  Left Join PLANO On BP.N_PLN_PLN = PLANO.N_PLN_PLN										
  Left Join ORGANIZACAO On BP.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG										
  Left Join GRUPOBENEFICIO GB On TB.N_GRPBNF_GRPBNF = GB.N_GRPBNF_GRPBNF										
  JOIN ORGANIZACAOPESSOA AS OP										
  ON OP.N_CODORI_ORGPESSOA = BP.N_CODORI_ORGPESSOA AND OP.N_ORG_ORG = BP.N_ORG_ORG										
Where (										
  TB.S_RATEIO_TIPBNF = 'N' And										
  --(BANCO.N_BCO_BCO = :banco Or										
  --  :banco Is Null) And										
  ----(HP.DT_PGTO_HISTPGTO = @DATA_COMP and										
  ----  (HP.N_ANOCOMPET_HISTPGTO = Year(@DATA_COMP) And										
  ----    HP.N_MESCOMPET_HISTPGTO = Month(@DATA_COMP))) And										
   year(HP.DT_PGTO_HISTPGTO) = 2025 and										
  ((EPA.DT_INIVIG_EPFPESSOAAGENCIA <= @DATA_COMP) Or										
    (EPA.DT_INIVIG_EPFPESSOAAGENCIA <= @DATA_COMP)) And										
  ((EPA.DT_FIMVIG_EPFPESSOAAGENCIA >= @DATA_COMP) Or										
    (EPA.DT_FIMVIG_EPFPESSOAAGENCIA >= @DATA_COMP) Or										
    EPA.DT_FIMVIG_EPFPESSOAAGENCIA Is Null)) --And										
										
	--And EXISTS(SELECT 1 FROM HISTORICOPAGAMENTO AS HP1									
	--			WHERE HP1.N_PROT_BNFPESSOA = HP.N_PROT_BNFPESSOA						
	--			AND year(HP1.DT_PGTO_HISTPGTO) = 2025						
	--			AND MONTH(HP1.DT_PGTO_HISTPGTO) = 12)						
 -- (BP.N_PLN_PLN = :Plano Or										
 --   :Plano Is Null) And										
 -- (BP.N_ORG_ORG = :Patroc Or										
 --   :Patroc Is Null) And										
 -- (TB.N_GRPBNF_GRPBNF = :Grupo Or										
 --   :Grupo Is Null) And										
 -- (TB.N_TIPBNF_TIPBNF = :TipBnf Or										
 --   :TipBnf Is Null) And										
 -- (EPA.S_FRMLANC_EPFPESSOAAGENCIA = :FrmLct Or										
 --   :FrmLct Is Null) 										
	--And									
  --Not Exists(Select 1										
  --From RELACAOPESSOA RP Inner Join ESPECIFICACAOPESSOAAGENCIA EPA										
  --    On RP.N_PESSOARELAC_PESSOA = EPA.N_PESSOA_PESSOA And										
  --    EPA.N_TIPPESSOA_TIPPESSOA = RP.N_TIPPESSOARELAC_TIPPESSOA										
  --Where EPA.N_TIPPESSOA_TIPPESSOA In (5, 12) And RP.N_PESSOA_PESSOA =										
  --  TITULAR.N_PESSOA_PESSOA And (RP.DT_FIMVIG_RELACPESSOA Is Null Or										
  --    RP.DT_FIMVIG_RELACPESSOA >= @DATA_COMP Or RP.DT_FIMVIG_RELACPESSOA >=										
  --    @DATA_COMP)) 										
	 -- And									
  --(BP.N_COD_CLSCTB = @CL_CONT )										
  --AND (TB.N_GRPBNF_GRPBNF = @GRUPO)										
  --Or										
  --  :ClassCtb Is Null)										
	--)									
/*WHERE_ADD*/										
Group By										
titular.n_pessoa_pessoa,										
 BP.N_CODORI_ORGPESSOA,										
titular.DT_NASC_PESSOA,										
  TITULAR.S_NOM_PESSOA,										
  TITULAR.S_CPF_PESSOA,										
  BP.N_PROT_BNFPESSOA,										
  BANCO.N_BCO_BCO,										
  BANCO.S_DCR_BCO,										
  AGENCIA.N_AGE_AGE,										
  AGENCIA.S_DCR_AGE,										
  EPA.S_CTACORR_EPFPESSOAAGENCIA,										
  EPA.S_DGV_EPFPESSOAAGENCIA,										
  --HP.DT_PGTO_HISTPGTO,										
  AGENCIA.S_DGV_AGE,										
  PLANO.S_DCRRESM_PLN,										
  ORGANIZACAO.S_DCRRESM_ORG,										
  GB.S_DCR_GRPBNF,										
  EPA.S_FRMLANC_EPFPESSOAAGENCIA										
  ,TB.S_DCR_TIPBNF										
  ,CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) 										
  ,OP.DT_ADM_ORGPESSOA										
  ,BP.DT_DCB_BNFPESSOA										
  ,ORGANIZACAO.s_dcr_org										
Having										
  Sum(Case R.S_NAT_RUB										
    When 'D' Then ( -1) * ((HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO))										
    Else (HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO) End) > 0										
--Union										
--Select										
--	REPRESENTANTE.n_pessoa_pessoa,									
--	REPRESENTANTE.DT_NASC_PESSOA,									
--  REPRESENTANTE.S_NOM_PESSOA,										
--  REPRESENTANTE.S_CPF_PESSOA,										
--  BP.N_PROT_BNFPESSOA As PROTOCOLO,										
--   BP.N_CODORI_ORGPESSOA As MATRICULA,										
--   CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) As DATA_INICIO_BENEFICIO,										
--  Sum(Case R.S_NAT_RUB										
--    When 'P' Then ((HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO)) Else 0										
--  End) As Proventos,										
--  Sum(Case R.S_NAT_RUB										
--    When 'D' Then (( -1) * ((HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO)))										
--    Else 0 End) As Descontos,										
--  Sum(Case R.S_NAT_RUB										
--    When 'D' Then (( -1) * ((HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO)))										
--    Else (HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO) End) As Liquido,										
--  BANCO.N_BCO_BCO,										
--  BANCO.S_DCR_BCO,										
--  AGENCIA.N_AGE_AGE,										
--  AGENCIA.S_DCR_AGE,										
--  EPA.S_CTACORR_EPFPESSOAAGENCIA,										
--  EPA.S_DGV_EPFPESSOAAGENCIA,										
--  HP.DT_PGTO_HISTPGTO As DATAPAGTO,										
--  AGENCIA.S_DGV_AGE,										
--  'S' As RATEIO,										
--  REPRESENTANTE.S_NOM_PESSOA As NOMEREPRES,										
--  REPRESENTANTE.S_CPF_PESSOA As CPFREPRES,										
--  PLANO.S_DCRRESM_PLN,										
--  ORGANIZACAO.S_DCRRESM_ORG,										
--  Case EPA.S_FRMLANC_EPFPESSOAAGENCIA When 01 Then 'Crédito Conta Corrente'										
--    When 02 Then 'Cheque Administrativo' When 03 Then 'DOC'										
--    When 04 Then 'Crédito Conta Salário' When 05 Then 'Crédito Poupança'										
--    When 10 Then 'Ordem de Pagamento' When 41 Then 'TED' End As DescFormLanc,										
--  GB.S_DCR_GRPBNF,										
--  Case When @DATA_COMP Is Null Then 1 Else 0 End As Flag	,									
--  TB.S_DCR_TIPBNF										
--From										
--  BENEFICIOPESSOA BP										
--  Inner Join TIPOBENEFICIO TB On BP.N_TIPBNF_TIPBNF = TB.N_TIPBNF_TIPBNF										
--  Inner Join HISTORICOPAGAMENTO HP On BP.N_PROT_BNFPESSOA = HP.N_PROT_BNFPESSOA										
--  Inner Join PESSOA As REPRESENTANTE On HP.N_PESSOAREPRES_PESSOA =										
--    REPRESENTANTE.N_PESSOA_PESSOA										
--  Inner Join RUBRICA R On HP.N_RUB_RUB = R.N_RUB_RUB										
--  Inner Join PESSOA As TITULAR On BP.N_PESSOA_PESSOA = TITULAR.N_PESSOA_PESSOA										
--  Inner Join ESPECIFICACAOPESSOAAGENCIA EPA On HP.N_PESSOAREPRES_PESSOA =										
--    EPA.N_PESSOA_PESSOA And HP.N_TIPPESSOAREPRES_TIPPESSOA =										
--    EPA.N_TIPPESSOA_TIPPESSOA And ((EPA.N_PROT_BNFPESSOA = BP.N_PROT_BNFPESSOA)										
--      Or (EPA.N_PROT_BNFPESSOA Is Null))										
--  Inner Join AGENCIA On EPA.N_BCO_BCO = AGENCIA.N_BCO_BCO And										
--    EPA.N_AGE_AGE = AGENCIA.N_AGE_AGE										
--  Inner Join BANCO On AGENCIA.N_BCO_BCO = BANCO.N_BCO_BCO										
--  Left Join PLANO On BP.N_PLN_PLN = PLANO.N_PLN_PLN										
--  Left Join ORGANIZACAO On BP.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG										
--  Left Join GRUPOBENEFICIO GB On TB.N_GRPBNF_GRPBNF = GB.N_GRPBNF_GRPBNF										
--Where										
--  TB.S_RATEIO_TIPBNF = 'S' And										
--  --(BANCO.N_BCO_BCO = :banco Or										
--  --  :banco Is Null) And										
--  (HP.DT_PGTO_HISTPGTO = @DATA_COMP and										
--    (HP.N_ANOCOMPET_HISTPGTO = Year(@DATA_COMP) And										
--      HP.N_MESCOMPET_HISTPGTO = Month(@DATA_COMP))) And										
--  ((EPA.DT_INIVIG_EPFPESSOAAGENCIA <= @DATA_COMP) Or										
--    (EPA.DT_INIVIG_EPFPESSOAAGENCIA <= @DATA_COMP)) And										
--  ((EPA.DT_FIMVIG_EPFPESSOAAGENCIA >= @DATA_COMP) Or										
--    (EPA.DT_FIMVIG_EPFPESSOAAGENCIA >= @DATA_COMP) Or										
--    EPA.DT_FIMVIG_EPFPESSOAAGENCIA Is Null) And										
--  --(BP.N_PLN_PLN = :Plano Or										
--  --  :Plano Is Null) And										
--  --(BP.N_ORG_ORG = :Patroc Or										
--  --  :Patroc Is Null) And										
--  --(TB.N_GRPBNF_GRPBNF = :Grupo Or										
--  --  :Grupo Is Null) And										
--  --(TB.N_TIPBNF_TIPBNF = :TipBnf Or										
--  --  :TipBnf Is Null) And										
--  --(EPA.S_FRMLANC_EPFPESSOAAGENCIA = :FrmLct Or										
--  --  :FrmLct Is Null) And										
--  Not Exists(Select 1										
--  From RELACAOPESSOA RP Inner Join ESPECIFICACAOPESSOAAGENCIA EPA										
--      On RP.N_PESSOARELAC_PESSOA = EPA.N_PESSOA_PESSOA And										
--      EPA.N_TIPPESSOA_TIPPESSOA = RP.N_TIPPESSOARELAC_TIPPESSOA										
--  Where EPA.N_TIPPESSOA_TIPPESSOA In (5, 12) And RP.N_PESSOA_PESSOA =										
--    REPRESENTANTE.N_PESSOA_PESSOA And (RP.DT_FIMVIG_RELACPESSOA Is Null Or										
--      RP.DT_FIMVIG_RELACPESSOA >= @DATA_COMP Or RP.DT_FIMVIG_RELACPESSOA >=										
--      @DATA_COMP)) --And										
--	 -- And									
--  --(BP.N_COD_CLSCTB = @CL_CONT )										
--  --AND (TB.N_GRPBNF_GRPBNF = @GRUPO)										
--Group By										
--REPRESENTANTE.DT_NASC_PESSOA,										
-- BP.N_CODORI_ORGPESSOA,										
--REPRESENTANTE.n_pessoa_pessoa,										
--  REPRESENTANTE.S_NOM_PESSOA,										
--  REPRESENTANTE.S_CPF_PESSOA,										
--  BP.N_PROT_BNFPESSOA,										
--  BANCO.N_BCO_BCO,										
--  BANCO.S_DCR_BCO,										
--  AGENCIA.N_AGE_AGE,										
--  AGENCIA.S_DCR_AGE,										
--  EPA.S_CTACORR_EPFPESSOAAGENCIA,										
--  EPA.S_DGV_EPFPESSOAAGENCIA,										
--  HP.DT_PGTO_HISTPGTO,										
--  AGENCIA.S_DGV_AGE,										
--  PLANO.S_DCRRESM_PLN,										
--  ORGANIZACAO.S_DCRRESM_ORG,										
--  GB.S_DCR_GRPBNF,										
--  TITULAR.S_NOM_PESSOA,										
--  TITULAR.S_CPF_PESSOA,										
--  EPA.S_FRMLANC_EPFPESSOAAGENCIA, TB.S_DCR_TIPBNF	,									
--  CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103)										
--Having										
--  Sum(Case R.S_NAT_RUB										
--    When 'D' Then (( -1) * (HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO))										
--    Else (HP.N_VLRPGTO_HISTPGTO + HP.N_VLRCORR_HISTPGTO) End) > 0										
) as ta										
join PESSOA as p										
ON p.N_PESSOA_PESSOA = ta.N_PESSOA_PESSOA										
LEFT JOIN HISTORICOENDERECOPESSOA AS HEP										
ON HEP.N_PESSOA_PESSOA = ta.N_PESSOA_PESSOA										
	AND HEP.DT_INIVIG_HISTENDPESSOA IN (SELECT MAX(HEP1.DT_INIVIG_HISTENDPESSOA) FROM HISTORICOENDERECOPESSOA HEP1									
										WHERE HEP1.N_PESSOA_PESSOA = HEP.N_PESSOA_PESSOA)
LEFT JOIN MUNICIPIO AS M										
ON M.N_COD_MUN = HEP.N_COD_MUN										
where S_DCR_TIPBNF not like '%Estágio Remunerado%'										
AND CONVERT(DATETIME,DATA_ORGAO,103)<'1989-01-01'										
--WHERE TA.N_BCO_BCO <> 33										
order by S_DCR_GRPBNF,2										
--ORDER BY 2,7										
]]>
	</queryString>
