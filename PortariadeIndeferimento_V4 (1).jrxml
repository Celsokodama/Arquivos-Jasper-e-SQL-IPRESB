			<textField>
				<reportElement x="-5" y="31" width="454" height="474" uuid="7a4e5094-44f2-4a5d-be08-650e75d532ba"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="0.95" spacingAfter="0"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{TIPO REQUERIMENTO} == 1 ? "" : "<br/>") +

"<style isBold='true'>"+UPPER($F{NOME_PRESIDENTE})+"</style>"+$F{COND_PRESIDENTE}+" e <style isBold='true'>"+UPPER($F{NOME_DIRETOR})+"</style>"+$F{COND_DIRETOR}+", usando das atribuições que lhes são conferidas por lei;<br/><br/>"

+($F{TIPO REQUERIMENTO} == 1 ? 
	"Considerando que <style isBold='true'>" +new java.util.Scanner($F{NOME}.toLowerCase()).useDelimiter("\\s+").tokens()
    .map(word -> word.substring(0, 1).toUpperCase() + word.substring(1))
    .collect(java.util.stream.Collectors.joining(" ")) +"</style>"+new java.util.Scanner($F{DADOS SEGURADO}.toLowerCase()).useDelimiter("\\s+").tokens()
    .map(word -> word.substring(0, 1).toUpperCase() + word.substring(1))
    .collect(java.util.stream.Collectors.joining(" "))+";<br/><br/>"
	+"Considerando a Súmula Vinculante nº 33/2014 do STF;<br/><br/>" 
	+"Considerando o Anexo IV do Decreto nº 3048, de 06/05/1999;<br/><br/>"
	+"Considerando a Lei 8.213/91 em seu artigo 57, que trata da Aposentadoria Especial do Regime Geral de Previdência e a Instrução Normativa MPS/SPS nº 1, de 22/07/2010, que estabelece as regras para análise da aposentadoria especial e finalmente;<br/><br/>"
	
: ("Considerando que <style isBold='true'>" +new java.util.Scanner($F{NOME}.toLowerCase()).useDelimiter("\\s+").tokens()
    .map(word -> word.substring(0, 1).toUpperCase() + word.substring(1))
    .collect(java.util.stream.Collectors.joining(" "))+"</style>"+new java.util.Scanner($F{DADOS SEGURADO}.toLowerCase()).useDelimiter("\\s+").tokens()
    .map(word -> word.substring(0, 1).toUpperCase() + word.substring(1))
    .collect(java.util.stream.Collectors.joining(" "))+";<br/><br/>")

)
+"Considerando o que consta no Processo Administrativo n° <style isBold='true'>" +$F{NUMPROC}+"</style> "
+$F{Parte 1 FINAL}

+($F{TIPO REQUERIMENTO} == 1 ? "<br/><br/>" : "<br/><br/>")

+($F{TIPO REQUERIMENTO} == 4 ? $F{Tconvert} +"<br/><br/>"	
: ("")

)

+"<style isBold='true'>RESOLVEM:</style>"

+($F{TIPO REQUERIMENTO} == 1 ? "<br/><br/>" : "<br/><br/><br/>")

+"I - Indeferir o pedido do benefício de "+"Assunto: " + new java.util.Scanner($F{TIPO DE BENEFICIO}.toLowerCase()).useDelimiter("\\s+").tokens()
    .map(word -> word.substring(0, 1).toUpperCase() + word.substring(1))
    .collect(java.util.stream.Collectors.joining(" "))
+ " " +$F{AO SEGURADO OU AO REQUERENTE}
+" <style isBold='true'>"+($F{TIPO REQUERIMENTO} == 3 ? $F{REQUERENTE DADOS} : $F{NOME})+"</style>, "
+$F{BASE LEGAL}+".<br/><br/>"

+$F{INCISO II}+"<br/><br/>"

+$F{INCISO III}]]></textFieldExpression>
			</textField>
