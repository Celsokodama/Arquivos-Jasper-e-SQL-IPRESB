			<textField>
				<reportElement x="-10" y="432" width="461" height="24" isPrintWhenDetailOverflows="true" uuid="13521653-5f53-48a1-86c7-2fd02fcb11ad"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+$F{EMISSAO}+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-10" y="80" width="461" height="350" uuid="18bb7ea6-aaad-4a45-ba41-42d1004148b5"/>
				<box padding="6">
					<pen lineWidth="1.0"/>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Arial" size="11" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="2.5"/>
				</textElement>
				<textFieldExpression><![CDATA["	CERTIFICAMOS, para fins de obtenção de <style isBold='true'>"+"ABONO DE PERMANÊNCIA, "+"</style>"+"que consta do Processo Administrativo nº <style isBold='true'>"+$F{PROTOCOLO}+"</style>"+", que "+$F{ARTIGO}+" "+$F{GENERO}+" <style isBold='true'>"+$F{Nome}+"</style>"+", "+$F{PORTADOR}+" do CPF nº <style isBold='true'>"+$F{CPF}+"</style>"+", com matrícula funcional nº <style isBold='true'>"+$F{Matricula}+"</style>"+", na qualidade de "+$F{FUNCIONARIO}+" municipal "+ $F{VINCULADO}+" à "+$F{Ente}+" onde é titular do cargo efetivo de "+UPPER($F{CARGO})+", <style isUnderline='true'>"+"cumpriu as exigências para a aposentadoria por tempo de contribuição e idade"+"</style>"+" pela regra permanente prevista no "+$F{COND_MAGISTERIO}+"*, fazendo jus, perante o ente municipal ao qual está "+$F{VINCULADO}+", ao ABONO DE PERMANÊNCIA previsto no § 19º do artigo 40 da Constituição Federal*, desde que permaneça em atividade.   \n\n"  +"	Informa-se, ainda, que o servidor implementou os requisitos para a aposentadoria em " +" <style isBold='true'>"+ $F{dataSimulacao} +"</style>"+  ", conforme apuração constante dos autos" ]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-10" y="472" width="460" height="19" uuid="c4f77f87-18cf-4dd1-85ac-4d72a6ab5510"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["ASSINADO DIGITALMENTE POR"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-10" y="543" width="460" height="19" uuid="042f87cd-2443-4ffa-b7df-b6baa77baf66"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
