	<detail>
		<band height="649" splitType="Stretch">
			<textField>
				<reportElement x="-12" y="10" width="482" height="30" uuid="b8bcd072-e914-4d61-aece-41f7fcd0ccf8"/>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="-12" y="80" width="482" height="90" uuid="45c3b5a3-72f4-423f-b748-25c2bc1f12a1"/>
				<textElement>
					<font fontName="Arial" size="12" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[Ao
GOVERNO DO ESTADO DE SÃO PAULO
Secretaria de Educação/Saúde]]></text>
			</staticText>
			<textField>
				<reportElement x="-12" y="180" width="482" height="410" uuid="434db025-9c65-4f33-9df7-1df8d43b4078"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["	Solicitamos a <style isBold='true'>"+"Certidão de Tempo de Contribuição com os respectivos salários de contribuição"+"</style>"+" de <style isBold='true'>"+$F{NOME}+"</style>"+", servidor(a) da "+$F{ENTE}+" desde "+$F{ADMISSAO ENTE}+", cargo "+$F{CARGO}+", sob a matrícula funcional "+$F{MATRICULA}+", RG "+$F{RG}+" e CPF "+$F{CPF}.substring(0, 3)+"."+$F{CPF}.substring(3, 6)+"."+$F{CPF}.substring(6, 9)+"-"+$F{CPF}.substring(9, 11)+", para averbação junto ao IPRESB - Instituto de Previdência Social dos Servidores Municipais de Barueri.<br/><br/><style isUnderline='true'>"+ "Obs: A referida Certidão precisa ser homologada pelo SPPREV."+"</style>"+"<br/><br/><br/>	Atenciosamente."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
