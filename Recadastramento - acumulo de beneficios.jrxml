<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="470" leftMargin="85" rightMargin="40" topMargin="14" bottomMargin="0" uuid="d946ebe6-2e92-44c5-aed7-8f7380925278">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ipresb"/>
	<property name="com.jaspersoft.studio.unit." value="cm"/>
	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Protocolo" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="ACBenef" class="java.lang.String"/>
	<parameter name="ACBenefO" class="java.lang.String"/>
	<parameter name="ACBenefV" class="java.lang.String"/>
	<parameter name="ACBenefD" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @PROT AS INTEGER
SET @PROT = $P{Protocolo}

DECLARE @ANO AS INTEGER
SET @ANO =  $P{Ano}

DECLARE @ACUMULOBENEFICIOS AS VARCHAR(1)
SET @ACUMULOBENEFICIOS =  $P{ACBenef}

DECLARE @ACUMULOBENEFICIOSORGAO AS VARCHAR(100)
SET @ACUMULOBENEFICIOSORGAO =  $P{ACBenefO}

DECLARE @ACUMULOBENEFICIOSVALOR AS VARCHAR(15)
SET @ACUMULOBENEFICIOSVALOR =  $P{ACBenefV}

DECLARE @ACUMULOBENEFICIOSDATA AS VARCHAR(15)
SET @ACUMULOBENEFICIOSDATA =  $P{ACBenefD}




SELECT TOP 1

--PROTOCOLO DO PROCESSO
				(CASE	WHEN CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) <=2018 
						THEN 'BI-'+ CONVERT(VarChar(5), SP.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) 
						ELSE 'PA-'+ CONVERT(VarChar(5), SP.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) 
						END) AS NOMEPROT,

						FORMAT(SP.DT_SLCT_SERVPESSOA,'dd/MM/yyyy') AS DATA_SOLICITAÇAO,

						(CASE SP.S_TIPRESP_SERVPESSOA
						WHEN 'S' THEN 'Solicitante'
						WHEN 'O' THEN 'Outro(a)'
						WHEN 'P' THEN 'Procurador(a)'
						END ) AS TIPOSOLICITANTE,

						(CASE SP.S_TIPRESP_SERVPESSOA
						WHEN 'S' THEN  dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA))
						WHEN 'O' THEN dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P2.S_NOM_PESSOA))
						WHEN 'P' THEN dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(SP.S_NOMRESP_SERVPESSOA))
						END ) AS [NOME SOLICITANTE],


						--(CASE SP.S_NOMRESP_SERVPESSOA
						--WHEN NULL THEN  P2.S_NOM_PESSOA 
						--ELSE SP.S_NOMRESP_SERVPESSOA
						--END) AS [NOME SOLICITANTE],

dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [NOMESERVIDOR],
P.S_RG_PESSOA AS [RG],
--CPF
				RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF,
				
	

SP.N_CODORI_ORGPESSOA AS [MATRÍCULA],

		(CASE CARGO.S_DCR_CARGO
		WHEN 'PEB I' THEN 'PEB I'
		WHEN 'PEB II' THEN 'PEB II'
		WHEN 'PEB III' THEN 'PEB III'
		ELSE dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO))END) AS CARGO,
		CONVERT(VARCHAR, OP.DT_ADM_ORGPESSOA, 103)  AS [DATA DE INGRESSO],

			(CASE SP.N_ORG_ORG 
			WHEN 1 THEN 'Prefeitura Municipal de Barueri'
			WHEN 2 THEN 'Câmara Municipal de Barueri'
			WHEN 3 THEN 'FIEB'
			WHEN 4 THEN 'IPRESB'
			END)AS [ENTE],

			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(TIPOSERVICO.S_DCRSERV_TIPSERV)) AS [TIPO SOLICITAÇÃO],
			TIPOSERVICO.N_TIPSERV_TIPSERV AS [N_TIPO_SERVICO],

				dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER( DEP.S_NOM_PESSOA)) AS NOME_DEP,
				RTRIM(SUBSTRING(DEP.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(DEP.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(DEP.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(DEP.S_CPF_PESSOA,10,2)) AS CPF_DEP,
				DEP.S_RG_PESSOA AS RG_DEP,


			
			
			
			(CASE @ACUMULOBENEFICIOS 
				when 'S' THEN (CASE SP.N_TIPSERV_TIPSERV 

								--APOSENTADORIA
								WHEN 9 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'
								WHEN 32 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'
								WHEN 41 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'
								WHEN 42 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'
								WHEN 43 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'
								WHEN 57 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'
								WHEN 66 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'
								WHEN 91 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:<br>'

								--PENSÃO POR MORTE
								WHEN 21 THEN 'Recebo aposentadoria ou pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'	
								END)
					--Órgão:_____________________	Valor:________________________<br>Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
					ELSE (CASE SP.N_TIPSERV_TIPSERV 
							WHEN 9 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							WHEN 32 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							WHEN 41 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							WHEN 42 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							WHEN 43 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							WHEN 57 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							WHEN 66 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							WHEN 91 THEN  'Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'

							--PENSÃO POR MORTE
							WHEN 21 THEN 'Não recebo aposentadoria nem pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>'
							END)
			
			
				END) AS ACBenef,
				@ACUMULOBENEFICIOS AS ACUMULOBENEF2, 
				(case SP.N_TIPSERV_TIPSERV 
				WHEN 9 THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN 32 THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN 41 THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN 42 THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN 43 THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN 57 THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN 66 THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN 91 THEN 'Declaro ainda, caso venha a receber pensão por morte ou aposentadoria de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				END) AS TEXTO2,
				
					
			(CASE @ACUMULOBENEFICIOS 
				when 'S' THEN 'Órgão: ' + @ACUMULOBENEFICIOSORGAO + ' - '
				ELSE ''
			END) AS ACBenefO,
				(CASE @ACUMULOBENEFICIOS 
				when 'S' THEN 'Valor: R$ ' + @ACUMULOBENEFICIOSVALOR  + ' - '
				ELSE ''
			END) AS ACBenefV,
				(CASE @ACUMULOBENEFICIOS 
				when 'S' THEN 'Data de início do benefício: ' + @ACUMULOBENEFICIOSDATA
				ELSE ''
			END) AS ACBenefD,



			-- DECLARAÇÃO DE ACÚMULO TEXTO PARA PENSÃO TIPSERV=21 OU APOSENTADORIA
			(CASE WHEN SP.N_TIPSERV_TIPSERV = 21 THEN dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(DEP.S_NOM_PESSOA))
			ELSE dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) END) AS NOME_DECL,
			(CASE WHEN SP.N_TIPSERV_TIPSERV = 21 THEN DEP.S_CPF_PESSOA
			ELSE 	RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) END) AS CPF_DECL,
			(CASE WHEN SP.N_TIPSERV_TIPSERV = 21 THEN DEP.S_RG_PESSOA
			ELSE P.S_RG_PESSOA END) AS RG_DECL

			



FROM 

SERVICOPESSOA SP INNER JOIN PESSOA P ON SP.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA 
INNER JOIN TIPOSERVICO ON SP.N_TIPSERV_TIPSERV = TIPOSERVICO.N_TIPSERV_TIPSERV
LEFT JOIN HISTORICOENDERECOPESSOA H ON P.N_PESSOA_PESSOA = H.N_PESSOA_PESSOA 
LEFT JOIN PESSOA P2 ON SP.N_PESSOA_RESP = P2.N_PESSOA_PESSOA
LEFT JOIN RELACAOPESSOA RP1 ON P.N_PESSOA_PESSOA = RP1.N_PESSOA_PESSOA AND RP1.N_GRAUPARENT_GRAUPARENT IN (1,2) AND RP1.DT_FIMVIG_RELACPESSOA IS NULL
LEFT JOIN PESSOA DEP ON DEP.N_PESSOA_PESSOA = RP1.N_PESSOARELAC_PESSOA
LEFT JOIN CARGOORGANIZACAOPESSOA COP ON SP.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND SP.N_ORG_ORG = COP.N_ORG_ORG
LEFT JOIN ORGANIZACAOPESSOA OP ON SP.N_CODORI_ORGPESSOA = OP.N_CODORI_ORGPESSOA AND SP.N_ORG_ORG = OP.N_ORG_ORG
LEFT JOIN CARGO ON COP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND COP.N_ORG_ORG = CARGO.N_ORG_ORG




WHERE SP.N_NUMPROT_SERVPESSOA = @PROT AND SP.N_ANOREFER_SERVPESSOA = @ANO AND H.DT_FIMVIG_HISTENDPESSOA IS NULL AND
SP.N_TIPSERV_TIPSERV IN (6,7,8,9,10,21,32,41,42,43,57,58,59,60,64,66,91)]]>
	</queryString>
	<field name="NOMEPROT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMEPROT"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMEPROT"/>
	</field>
