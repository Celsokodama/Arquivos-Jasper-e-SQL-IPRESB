		<property name="com.jaspersoft.studio.field.label" value="CARGO"/>
	</field>
	<field name="DATA DE INGRESSO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="DATA DE INGRESSO"/>
		<property name="com.jaspersoft.studio.field.label" value="DATA DE INGRESSO"/>
	</field>
