		<property name="com.jaspersoft.studio.field.name" value="DATA_SOLICITAÇAO"/>
		<property name="com.jaspersoft.studio.field.label" value="DATA_SOLICITAÇAO"/>
	</field>
	<field name="TIPOSOLICITANTE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="TIPOSOLICITANTE"/>
		<property name="com.jaspersoft.studio.field.label" value="TIPOSOLICITANTE"/>
