	<subDataset name="Dataset1" uuid="bba6931d-06f4-496b-9544-6e85a7cee52a">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ASPPREV"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="CELULAR" class="java.lang.String"/>
		<queryString>
			<![CDATA[DECLARE @CELULAR AS INT
SET @CELULAR = $P{CELULAR}

SELECT DISTINCT
		PESSOA.S_NOM_PESSOA AS [NOME DO SERVIDOR],
		P.S_NOM_PESSOA AS [Name],
		GRAUDEPARENTESCO.S_DCR_GRAUPARENT AS [Parentesco],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF

		
		

			
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR

ORDER BY Pessoa.S_NOM_PESSOA]]>
		</queryString>
		<field name="NOME DO SERVIDOR" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOME DO SERVIDOR"/>
			<property name="com.jaspersoft.studio.field.label" value="NOME DO SERVIDOR"/>
		</field>
		<field name="Name" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Name"/>
			<property name="com.jaspersoft.studio.field.label" value="Name"/>
		</field>
		<field name="Parentesco" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Parentesco"/>
			<property name="com.jaspersoft.studio.field.label" value="Parentesco"/>
		</field>
		<field name="DataNascimento" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="DataNascimento"/>
			<property name="com.jaspersoft.studio.field.label" value="DataNascimento"/>
		</field>
		<field name="CPF" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CPF"/>
			<property name="com.jaspersoft.studio.field.label" value="CPF"/>
		</field>
	</subDataset>
	<parameter name="CELULAR" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @CELULAR AS INT
SET @CELULAR = $P{CELULAR}

--DECLARE @CELULAR AS INTEGER
--SET @CELULAR = 988196563




SELECT

		
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [Name],
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [Matricula1],
		
		(CASE OP.N_CODORI_ORGPESSOA
		WHEN ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA
		THEN ''
		ELSE CONVERT(VARCHAR,OP.N_CODORI_ORGPESSOA)
		END) 
		AS [Matricula2],

		PESSOA.S_RG_PESSOA AS [RG],
		RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS CPF,
		PESSOA.S_SEXO_PESSOA AS [Sexo],
		'SERVIDOR ATIVO' AS [TipoUsuario],
		CONVERT(VARCHAR(10),PESSOA.DT_NASC_PESSOA,103) AS [DataNascimento],
		(CASE PESSOA.S_ESTCIVIL_PESSOA 
		WHEN 'U' THEN 'UNIÃO ESTÁVEL'
		WHEN 'C' THEN 'CASADO(A)'
		WHEN 'S' THEN 'SOLTEIRO(A)'
		WHEN 'D' THEN 'DIVORCIADO(A)'
		WHEN 'V' THEN 'VIÚVO(A)'
		WHEN 'P' THEN 'SEPARADO(A)'
				END)
		AS [EstadoCivil],
		(CASE WHEN PESSOA.S_EMAIL_PESSOA IS NULL THEN 'NÃO CADASTRADO'
		ELSE LOWER(PESSOA.S_EMAIL_PESSOA) END) AS [Email],


		-- ENDEREÇO
		UPPER(CASE HISTORICOENDERECOPESSOA.N_TIPLOGRAD_HISTENDPESSOA	
												WHEN 4 THEN 'Alameda'  
												WHEN 8 THEN 'Av.' 
												WHEN 31 THEN 'Estrada' 
												WHEN 65 THEN 'Praça' 
												WHEN 77 THEN 'Quadra' 
												WHEN 81 THEN 'Rua' 
												WHEN 90 THEN 'Rodovia' 
												WHEN 100 THEN 'Travessa' 
												WHEN 104 THEN 'Vila' 
												ELSE 'R.'
												END ) + ' ' + +(RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRRUA_HISTENDPESSOA, ''))) + 

												CASE 
												WHEN HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
												THEN '' 
												ELSE ', ' +RTRIM(HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA) END +
												' - ' +
												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
												THEN '' 
												ELSE +' '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA)) END +

												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA IS NULL
												THEN ''
												ELSE ', '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA)) END + 
												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA IS NULL 
												THEN ''
												ELSE ', '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA)) END +
												' - ' +
												RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRUF_HISTENDPESSOA, '')) AS ENDEREÇO,
			   		 
		-- TELEFONE
				
				(CASE WHEN LEN (CONCAT (TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA)) = 9 THEN CONCAT ('5511',TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA)
				ELSE CONCAT ('55',TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA) END) AS [tel],

	

		--(SELECT P.S_NOM_PESSOA AS [DEPENDENTE1],
		--RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)+'.'+SUBSTRING(P.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(P.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS [CPFDEP1],
		--GRAUDEPARENTESCO.S_DCR_GRAUPARENT AS [PARENTESCO1]
		--FROM PESSOA P INNER JOIN RELACAOPESSOA ON 
		--WHERE 

				-- DEPENDENTES
		--(SELECT P.S_NOM_PESSOA
		--FROM PESSOA P
		--WHERE PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND RELACAOPESSOA.N_SEQ_RELACPESSOA = 1) AS DEP1,

		--(SELECT GRAUDEPARENTESCO.S_DCR_GRAUPARENT
		--FROM GRAUPARENTESCO
		--WHERE GRAUPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENTE_GRAUPARENT) AS GRAUPARENTESCO1,

		--(SELECT P.S_NOM_PESSOA
		--FROM PESSOA P
		--WHERE PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND RELACAOPESSOA.N_SEQ_RELACPESSOA = 2) AS DEP2,

		
				-- EMPREGOS
		CARGOORGANIZACAOPESSOA.S_DCRORG_CARGOORGPESSOA  AS EMPRESA,
		
		CONVERT(VARCHAR,CARGOORGANIZACAOPESSOA.DT_INIVIG_CARGOORGPESSOA,103) AS DT_INI,
		CONVERT(VARCHAR,CARGOORGANIZACAOPESSOA.DT_FIMVIG_CARGOORGPESSOA,103) AS DT_FIM,


		dep1.nome1,
		dep1.datanascimento1,
		dep1.parentesco1,
		dep1.cpf1,

		dep2.nome2,
		dep2.datanascimento2,
		dep2.parentesco2,
		dep2.cpf2,

		dep3.nome3,
		dep3.datanascimento3,
		dep3.parentesco3,
		dep3.cpf3,

		dep4.nome4,
		dep4.datanascimento4,
		dep4.parentesco4,
		dep4.cpf4,

		dep5.nome5,
		dep5.datanascimento5,
		dep5.parentesco5,
		dep5.cpf5,

		dep6.nome6,
		dep6.datanascimento6,
		dep6.parentesco6,
		dep6.cpf6,

		dep7.nome7,
		dep7.datanascimento7,
		dep7.parentesco7,
		dep7.cpf7



		

FROM
	
			
			PESSOA 
			FULL OUTER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
			INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
			INNER JOIN ORGANIZACAOPESSOA AS OP ON PESSOA.N_PESSOA_PESSOA = OP.N_PESSOA_PESSOA
			INNER JOIN TELEFONEPESSOA ON TELEFONEPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
			INNER JOIN HISTORICOENDERECOPESSOA ON HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
			--FULL OUTER JOIN RELACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA
			--FULL OUTER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT, PESSOA P

		
	OUTER APPLY 
	
	--DEP SEQ 1
(SELECT 
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [nome1],
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(GRAUDEPARENTESCO.S_DCR_GRAUPARENT)) AS [Parentesco1],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento1],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF1		
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE 

P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR
AND (RELACAOPESSOA.DT_FIMVIG_RELACPESSOA > GETDATE() OR RELACAOPESSOA.DT_FIMVIG_RELACPESSOA IS NULL)
order by RELACAOPESSOA.DT_INCDEP_RELACPESSOA

OFFSET 0 ROWS
FETCH NEXT 1 ROWS ONLY)

DEP1(nome1,parentesco1,datanascimento1,cpf1)

OUTER APPLY 
	
	--DEP SEQ 2
(SELECT 
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [nome2],
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(GRAUDEPARENTESCO.S_DCR_GRAUPARENT)) AS [Parentesco2],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento2],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF2		
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR
AND (RELACAOPESSOA.DT_FIMVIG_RELACPESSOA > GETDATE() OR RELACAOPESSOA.DT_FIMVIG_RELACPESSOA IS NULL)

order by RELACAOPESSOA.DT_INCDEP_RELACPESSOA

OFFSET 1 ROWS
FETCH NEXT 1 ROWS ONLY)

DEP2(nome2,parentesco2,datanascimento2,cpf2)

OUTER APPLY 
	
	--DEP SEQ 3
(SELECT 
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [nome3],
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(GRAUDEPARENTESCO.S_DCR_GRAUPARENT)) AS [Parentesco3],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento3],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF3	
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR
AND (RELACAOPESSOA.DT_FIMVIG_RELACPESSOA > GETDATE() OR RELACAOPESSOA.DT_FIMVIG_RELACPESSOA IS NULL)
order by RELACAOPESSOA.DT_INCDEP_RELACPESSOA

OFFSET 2 ROWS
FETCH NEXT 1 ROWS ONLY)

DEP3(nome3,parentesco3,datanascimento3,cpf3)


OUTER APPLY 
	
	--DEP SEQ 4
(SELECT 
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [nome4],
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(GRAUDEPARENTESCO.S_DCR_GRAUPARENT)) AS [Parentesco4],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento4],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF4	
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR
AND (RELACAOPESSOA.DT_FIMVIG_RELACPESSOA > GETDATE() OR RELACAOPESSOA.DT_FIMVIG_RELACPESSOA IS NULL)
order by RELACAOPESSOA.DT_INCDEP_RELACPESSOA

OFFSET 3 ROWS
FETCH NEXT 1 ROWS ONLY)

DEP4(nome4,parentesco4,datanascimento4,cpf4)



OUTER APPLY 
	
	--DEP SEQ 5
(SELECT 
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [nome5],
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(GRAUDEPARENTESCO.S_DCR_GRAUPARENT)) AS [Parentesco5],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento5],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF5	
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR
AND (RELACAOPESSOA.DT_FIMVIG_RELACPESSOA > GETDATE() OR RELACAOPESSOA.DT_FIMVIG_RELACPESSOA IS NULL)
order by RELACAOPESSOA.DT_INCDEP_RELACPESSOA

OFFSET 4 ROWS
FETCH NEXT 1 ROWS ONLY)
DEP5(nome5,parentesco5,datanascimento5,cpf5)

OUTER APPLY 
	
	--DEP SEQ 6
(SELECT
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [nome6],
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(GRAUDEPARENTESCO.S_DCR_GRAUPARENT)) AS [Parentesco6],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento6],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF6
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR
AND (RELACAOPESSOA.DT_FIMVIG_RELACPESSOA > GETDATE() OR RELACAOPESSOA.DT_FIMVIG_RELACPESSOA IS NULL)
order by RELACAOPESSOA.DT_INCDEP_RELACPESSOA

OFFSET 5 ROWS
FETCH NEXT 1 ROWS ONLY)

DEP6(nome6,parentesco6,datanascimento6,cpf6)

OUTER APPLY 
	
	--DEP SEQ 7
(SELECT 
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(P.S_NOM_PESSOA)) AS [nome7],
			dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(GRAUDEPARENTESCO.S_DCR_GRAUPARENT)) AS [Parentesco7],
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento7],

			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF7	
		
FROM RELACAOPESSOA INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA 
INNER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT 
INNER JOIN TELEFONEPESSOA ON PESSOA.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA , PESSOA P


WHERE P.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOARELAC_PESSOA AND
GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT <> 99
AND TELEFONEPESSOA.S_TIP_TELPESSOA = 'E'
AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR
AND (RELACAOPESSOA.DT_FIMVIG_RELACPESSOA > GETDATE() OR RELACAOPESSOA.DT_FIMVIG_RELACPESSOA IS NULL)

order by RELACAOPESSOA.DT_INCDEP_RELACPESSOA

OFFSET 6 ROWS
FETCH NEXT 1 ROWS ONLY)

DEP7(nome7,parentesco7,datanascimento7,cpf7)


		WHERE

		
		TELEFONEPESSOA.S_TIP_TELPESSOA = 'E' AND
		LEN (CONCAT (TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA)) IN (9,11) and
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA <= OP.N_CODORI_ORGPESSOA AND
		TELEFONEPESSOA.N_NUM_TELPESSOA IS NOT NULL AND
		HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL AND


		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = (SELECT
													MIN(OP2.N_CODORI_ORGPESSOA) 
													FROM	
															ORGANIZACAOPESSOA OP2
													WHERE
															OP2.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA AND OP2.DT_DSL_ORGPESSOA IS NULL
															) AND

		OP.N_CODORI_ORGPESSOA = (SELECT
													MAX(OP4.N_CODORI_ORGPESSOA) 
													FROM	
															ORGANIZACAOPESSOA OP4
													WHERE
															OP4.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA AND OP4.DT_DSL_ORGPESSOA IS NULL
															)

		AND HISTORICOENDERECOPESSOA.DT_INIVIG_HISTENDPESSOA = (SELECT MAX(HEND2.DT_INIVIG_HISTENDPESSOA)
											FROM HISTORICOENDERECOPESSOA HEND2
											WHERE HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA = HEND2.N_PESSOA_PESSOA)

		AND TELEFONEPESSOA.N_NUM_TELPESSOA = @CELULAR


		ORDER BY CARGOORGANIZACAOPESSOA.DT_INIVIG_CARGOORGPESSOA]]>
	</queryString>
