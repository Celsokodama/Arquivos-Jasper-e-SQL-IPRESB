					<font fontName="Arial" size="12" isUnderline="true"/>
				</textElement>
				<text><![CDATA[<style isBold='true'>DECLARAÇÃO DE ACUMULAÇÃO DE BENEFÍCIOS </style>]]></text>
			</staticText>
		</band>
	</pageHeader>
