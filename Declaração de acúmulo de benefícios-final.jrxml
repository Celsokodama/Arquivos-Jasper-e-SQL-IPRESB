	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 4]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matr" class="java.lang.String"/>
	<parameter name="Ente" class="java.lang.String"/>
	<parameter name="Assunto" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @Assunto varchar(2)
	SET @Assunto = $P{Assunto}

SELECT TOP 1 
	PESSOA.S_NOM_PESSOA AS NOME,
	PESSOA.S_CPF_PESSOA AS CPF,
	PESSOA.S_SEXO_PESSOA AS SEXO,
	PESSOA.S_RG_PESSOA AS RG,
	PESSOA.N_PESSOA_PESSOA AS PESSOA,
	ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRÍCULA,
	ORGANIZACAOPESSOA.N_ORG_ORG AS ENTE,
	

	
		(CASE  @Assunto
				WHEN UPPER('A') 
				THEN 
				'declaro, para fins de obtenção de benefício junto ao Instituto de Previdência Social dos Servidores
				Municipais de Barueri - IPRESB, que:<br><br>
				( ) Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio 	de Previdência Social (RPPS) ou decorrentes de atividades militares;<br><br>
				( ) Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>
				Órgão:_______________________<br>
				Valor: _______________________<br>
				Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios. '
		

				WHEN  UPPER('P')  
				THEN
				'declaro, para fins de obtenção de benefício junto ao Instituto de Previdência Social dos Servidores
				Municipais de Barueri - IPRESB, que:<br><br>
				( ) Não recebo aposentadoria ou pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br><br>
				( ) Recebo aposentadoria ou pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de 	Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>
				Órgão:_______________________<br>
				Valor: _______________________<br>
				Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que
				estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				

				WHEN UPPER('RA')  
				THEN
				'declaro, para fins de Recadastramento anual (Prova de Vida) junto ao Instituto de Previdência Social dos Servidores Municipais de Barueri - IPRESB, que:<br>
				( ) Não recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>
				( ) Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>
				Órgão:_______________________<br>
				Valor: _______________________<br>
				Data da Concessão do Benefício: _________________________<br>
				Declaro ainda, caso venha a receber pensão por morte ou aposentadoria de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.' 
				
				WHEN UPPER('RP')  
				THEN
				'declaro, para fins de Recadastramento anual (Prova de Vida) junto ao Instituto de Previdência Social dos Servidores Municipais de Barueri - IPRESB, que:<br>
				( ) Não recebo aposentadoria ou pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br><br>
				( ) Recebo aposentadoria ou pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;<br>
				Órgão:_______________________<br>
				Valor: _______________________<br>
				Data da Concessão do Benefício: _________________________<br>
				Declaro ainda, caso venha a receber pensão por morte ou aposentadoria de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'END) AS TEXTO
				
				




FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 



WHERE        (ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = $P{Matr} AND ORGANIZACAOPESSOA.N_ORG_ORG =  $P{Ente})]]>
	</queryString>
