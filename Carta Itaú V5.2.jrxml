	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Codigo" class="java.lang.String"/>
	<parameter name="Remun" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE Português

DECLARE @DInt as VARCHAR(30)
SET @DInt = $P{DInt}

SELECT        PESSOA.N_PESSOA_PESSOA AS CODIGOPESSOA, PESSOA.S_NOM_PESSOA AS NOME, substring(PESSOA.S_CPF_PESSOA,1,3)+'.'+substring(PESSOA.S_CPF_PESSOA,4,3)+'.'+substring(PESSOA.S_CPF_PESSOA,7,3)+'-'+substring(PESSOA.S_CPF_PESSOA,10,2) AS CPF, PESSOA.S_RG_PESSOA AS RG,		-- CNPJ IPRESB	
				(SELECT RTRIM(SUBSTRING(ORG.S_CNPJ_ORG,1,2))+'.'+ SUBSTRING(ORG.S_CNPJ_ORG,3,3)+'.'+ SUBSTRING(ORG.S_CNPJ_ORG,6,3)+'/'+ SUBSTRING(ORG.S_CNPJ_ORG,9,4)+'-'+ SUBSTRING(ORG.S_CNPJ_ORG,13,2) 
				FROM ORGANIZACAO ORG
				where ORG.N_ORG_ORG = 4)  AS [CNPJ IPRESB], $P{Remun} AS [REMUNERÇÃO MENSAL],
				
			  ISNULL(CASE N_TIPLOGRAD_HISTENDPESSOA 
			  									WHEN 4 THEN 'Alameda'  
			 									WHEN 8 THEN 'Av.' 
												WHEN 31 THEN 'Estrada' 
												WHEN 65 THEN 'Praça' 
												WHEN 77 THEN 'Quadra' 
												WHEN 81 THEN 'Rua' 
												WHEN 90 THEN 'Rodovia' 
												WHEN 100 THEN 'Travessa' 
												WHEN 101 THEN 'Via'
												WHEN 104 THEN 'Vila' 
												WHEN 105 THEN 'Viela'
			  	
			  	END,''
			  ) +' '+
			  dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(S_DCRRUA_HISTENDPESSOA, '') +
			  CASE WHEN S_NUMLOGRAD_HISTENDPESSOA IS NULL THEN ''  ELSE ', '+RTRIM(S_NUMLOGRAD_HISTENDPESSOA) END +
		      CASE WHEN S_DCRBAIRRO_HISTENDPESSOA IS NULL THEN '' ELSE +', '+RTRIM(S_DCRBAIRRO_HISTENDPESSOA) END +
			  CASE WHEN S_DCRCOMPL_HISTENDPESSOA IS NULL THEN '' ELSE ', '+RTRIM(S_DCRCOMPL_HISTENDPESSOA) END +
			  CASE WHEN S_DCRMUN_HISTENDPESSOA IS NULL THEN '' ELSE ', '+RTRIM(S_DCRMUN_HISTENDPESSOA) END))+
		      ', '+RTRIM(ISNULL(S_DCRUF_HISTENDPESSOA, '')))+
			  ', CEP: '+RTRIM(ISNULL(substring(S_CEP_HISTENDPESSOA, 1,5) + '-' + substring(S_CEP_HISTENDPESSOA, 6, 9), '')) as ENDERECO,
			  
			  --NOMENCLATURA DO CARGO DE GESTOR
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nomenclatura_Cargo 
							ELSE GESTOR_TITULAR.Nomenclatura_Cargo
							END) AS CARGO_DIRETOR,

				--NOME DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nome
							ELSE GESTOR_TITULAR.Nome
							END) AS NOME_DIRETOR

FROM            PESSOA INNER JOIN
                         HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA
                       
			OUTER APPLY

			--DADOS DO GESTOR TITULAR
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
						
						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) AS [NOMENCLATURA CARGO DIREÇÃO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_TITULAR(Nome,Cargo_Efetivo,Matrícula,Nomenclatura_Cargo)

			OUTER APPLY

			--DADOS DO GESTOR INTERINO
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
						
						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) AS [NOMENCLATURA CARGO DIREÇÃO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_INTERINO(Nome,Cargo_Efetivo,Matrícula,Nomenclatura_Cargo)



WHERE PESSOA.N_PESSOA_PESSOA = $P{Codigo} AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL]]>
	</queryString>
