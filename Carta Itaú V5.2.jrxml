	<detail>
		<band height="691" splitType="Stretch">
			<textField>
				<reportElement x="-8" y="1" width="454" height="30" uuid="d95e8383-9820-4837-8baa-109eec176f5d"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy")+".")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-8" y="41" width="454" height="190" uuid="b998975e-d92b-499f-ac13-bab6e1080608"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>Ao Banco Itaú S.A.<br><br>"

+"Assunto: Abertura de Conta para fins de pagamento de Benefício</b><br><br><br>"

+"O Instituto de Previdência Social dos Servidores Municipais de Barueri, CNPJ: "+$F{CNPJ IPRESB} +", com conta-pagadora no Banco Itaú, Agência 0024, Conta 79680-7, apresenta o(a) participante abaixo qualificado(a) e solicita que essa instituição providencie a abertura de uma conta destinada ao crédito dos seus proventos."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-8" y="244" width="454" height="200" uuid="7b82c3db-1894-40d2-a4ea-3978dd516e83"/>
				<textElement textAlignment="Left" verticalAlignment="Top" markup="html">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double" lineSpacingSize="2.4"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>Dados: </b><br>"
+"<b>1. Nome Completo:  </b>"+$F{NOME}
+"<br><b>2. CPF:  </b>"+$F{CPF}
+"<br><b>3. RG:  </b>"+$F{RG}
+"<br><b>4. Endereço Residencial:  </b>"+$F{ENDERECO}
+"<br><b>5. Valor da Remuneração Mensal:  </b>"+"R$ "+$F{REMUNERÇÃO MENSAL}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="-8" y="549" width="454" height="140" uuid="0f2eb426-f4eb-4067-a90e-78026bf078e5"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="12" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[NOTA 1: Junto com esta correspondência, deve-se apresentar os seguintes documentos (cópias e originais): Documento de identidade, CPF próprio ou CNH ativa.

NOTA 2: Após a abertura da conta, realizar antecipadamente o aceite nos caixas eletrônicos, em uma das agências Itaú ou na internet através da rota: Salário > Cadastrar conta para recebimento de salário.]]></text>
			</staticText>
			<textField>
				<reportElement x="-8" y="486" width="454" height="20" uuid="22c29bb7-210b-4026-8241-2c6d7e811a5e"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Arial" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CARGO_DIRETOR}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-8" y="447" width="454" height="19" uuid="3252abd9-9340-49d4-9658-313eb650b2a5"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["ASSINADO DIGITALMENTE POR"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-8" y="466" width="454" height="20" uuid="9ce95b57-4155-4d49-9041-6291ebd143d0"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
