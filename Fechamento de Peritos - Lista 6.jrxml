<!-- Created with Jaspersoft Studio version 6.12.2.final using JasperReports Library version 6.12.2-75c5e90a222ab406e416cbf590a5397028a52de3  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="teste3" pageWidth="1684" pageHeight="1191" orientation="Landscape" columnWidth="1684" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="10e901fa-5e86-47b7-b42c-c525b163fcad">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
	<parameter name="Mes" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT        FORMAT(ATENDIMENTOAGENDADO.DT_DATA_ATENAGD, 'dd/MM/yyyy') AS DATA_PERICIA, 

						 (CASE ATENDIMENTOAGENDADO.N_MEDICO_PESSOA WHEN 2182 THEN 'ELZA MARIA PEREIRA BENTO' WHEN 2442 THEN 'MAMORU KITAMURA' 
						 WHEN 40351 THEN 'GILMERSON DA COSTA E SILVA' WHEN 10919 THEN 'ALEX VENEZIANO OLIVEIRA JUNIOR' WHEN 17149 THEN 'GILBERTO AMBROGINI' 
						 WHEN 40593 THEN 'JUNTA MEDICA' WHEN 46769 THEN 'SERGIO RACHMAN' END) AS NOME_MEDICO,

						 (CASE WHEN ATENDIMENTOAGENDADO.N_MEDICO_PESSOA <> 40593 THEN '-' ELSE
						 (CASE JUNTAMEDICAATENDIMENTO.N_PESSOA_PESSOA WHEN 2182 THEN 'ELZA MARIA PEREIRA BENTO' WHEN 2442 THEN 'MAMORU KITAMURA' 
						 WHEN 40351 THEN 'GILMERSON DA COSTA E SILVA' WHEN 10919 THEN 'ALEX VENEZIANO OLIVEIRA JUNIOR' WHEN 17149 THEN 'GILBERTO AMBROGINI' 
						 WHEN 40593 THEN 'JUNTA MEDICA' WHEN 46769 THEN 'SERGIO RACHMAN' END)END) AS NOME_MÉDICO_JUNTA,
						 
						 ATENDIMENTOAGENDADO.N_PACI_PESSOA AS N_PESSOA, 
                         CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRÍCULA, 
						 (CASE N_ORG_ORG WHEN 1 THEN 'PMB' WHEN 2 THEN 'CMB' WHEN 3 THEN 'FIEB' WHEN 4 THEN 'IPRESB' END) AS ENTE, 
                         PESSOA.S_NOM_PESSOA AS NOME_SERVIDOR, 
						 RECURSOMEDICO.S_DESREC_RECMEDICO AS TIPO_PERICIA, 
						 REPLACE(CAST(ITEMATENDIMENTOREALIZADO.N_VLRPREV_ITEMATENDREALZ AS varchar(12)), '.', ',') AS VALOR_PERÍCIA, 
                         ('CREM ' + CAST(ATENDIMENTOAGENDADO.N_RESULPERIC_ATENDAGD AS VARCHAR(80))) AS RESULTADO_PERÍCIA, 
						 ATENDIMENTOAGENDADO.N_TIP_ATENDAGD, 
						 ATENDIMENTOAGENDADO.N_MOTINC_MOTGUIASAUDE, 
                         MOTIVOSGUIASAUDE.S_DCR_MOTGUIASAUDE

FROM            ITEMATENDIMENTOREALIZADO INNER JOIN
                         ATENDIMENTOAGENDADO ON ITEMATENDIMENTOREALIZADO.N_SEQ_ATENDAGD = ATENDIMENTOAGENDADO.N_SEQ_ATENDAGD AND 
                         ITEMATENDIMENTOREALIZADO.N_SEQ_AGDPLNJ = ATENDIMENTOAGENDADO.N_SEQ_AGDPLNJ INNER JOIN
                         PESSOA ON ATENDIMENTOAGENDADO.N_PACI_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN
                         MOTIVOSGUIASAUDE ON ATENDIMENTOAGENDADO.N_MOTINC_MOTGUIASAUDE = MOTIVOSGUIASAUDE.N_COD_MOTGUIASAUDE INNER JOIN
                         RECURSOMEDICO ON ITEMATENDIMENTOREALIZADO.N_REC_RECMEDICO = RECURSOMEDICO.N_REC_RECMEDICO INNER JOIN
                         JUNTAMEDICAATENDIMENTO ON ATENDIMENTOAGENDADO.N_SEQ_ATENDAGD = JUNTAMEDICAATENDIMENTO.N_SEQ_ATENDAGD AND 
                         ATENDIMENTOAGENDADO.N_SEQ_AGDPLNJ = JUNTAMEDICAATENDIMENTO.N_SEQ_AGDPLNJ

WHERE       (MONTH(ITEMATENDIMENTOREALIZADO.DT_DATA_ITEMATENDREALZ) = $P{Mes}) AND 
			(ATENDIMENTOAGENDADO.N_RESULPERIC_ATENDAGD IS NOT NULL) AND 
            (YEAR(ITEMATENDIMENTOREALIZADO.DT_DATA_ITEMATENDREALZ) = $P{Ano}) AND 

			(CARGOORGANIZACAOPESSOA.DT_INIVIG_CARGOORGPESSOA =
               (SELECT        MAX(DT_INIVIG_CARGOORGPESSOA) AS Expr1
                FROM            CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_1
                WHERE        (N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA)))


ORDER BY DATA_PERICIA, NOME_MEDICO]]>
	</queryString>
