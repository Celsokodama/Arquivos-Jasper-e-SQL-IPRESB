	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matricula" class="java.lang.String"/>
	<parameter name="Organiz" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE Português

SELECT     TOP 1   CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AS NPESSOA, CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA, 
                         CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRICULA, CARGOORGANIZACAOPESSOA.S_DCRCARGO_CARGOORGPESSOA AS CARGO, 
                         CARGOORGANIZACAOPESSOA.N_ORG_ORG AS ENTE, PESSOA.S_NOM_PESSOA AS NOME, PESSOA.S_SEXO_PESSOA AS GENERO, PESSOA.S_RG_PESSOA AS RG, PESSOA.S_CPF_PESSOA AS CPF,
						 DT_INIVIG_CARGOORGPESSOA AS DATAINICIO,
						 (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'portador' ELSE 'portadora' END) AS PORTADOR,
						 (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'inscrito' ELSE 'inscrita' END) AS INSCRITA,
						 (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'servidor' ELSE 'servidora' END) AS SERVIDOR,
						 (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'aposentado' ELSE 'aposentada' END) AS APOSENTADO,
						 (CASE WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 1 THEN ' da Prefeitura Municipal de Barueri' ELSE '' END) AS PREFEITURA,
						 (CASE WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 2 THEN ' da Câmara Municipal de Barueri' ELSE '' END) AS CAMARA,
						 (CASE WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 3 THEN ' da FIEB - Fundação Instituto de Educação de Barueri' ELSE '' END) AS FIEB,
						 (CASE WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 4 THEN ' do IPRESB - Instituto de Previdência Social dos Servidores Municipais de Barueri' ELSE '' END) AS IPRESB					 
						 
FROM            CARGOORGANIZACAOPESSOA INNER JOIN

                         PESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA

WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = $P{Matricula} AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = $P{Organiz}

ORDER BY CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA]]>
	</queryString>
