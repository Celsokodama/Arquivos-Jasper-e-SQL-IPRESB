	<detail>
		<band height="691" splitType="Stretch">
			<textField>
				<reportElement x="0" y="34" width="454" height="50" uuid="d95e8383-9820-4837-8baa-109eec176f5d"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="14" isBold="true" isUnderline="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["RATIFICAÇÃO DO TERMO DE OPÇÃO PELO REGIME DE PREVIDÊNCIA SOCIAL"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="128" width="454" height="237" uuid="b998975e-d92b-499f-ac13-bab6e1080608"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double" firstLineIndent="60"/>
				</textElement>
				<textFieldExpression><![CDATA["Eu, <style isBold='true'>"+$F{NOME}+"</style>, "+$F{PORTADOR}+" do Documento de Identidade nº <style isBold='true'>"+$F{RG}+"</style>, "+$F{INSCRITA}+" no CPF/MF sob o nº <style isBold='true'>"+$F{CPF}.substring(0, 3)+"."+$F{CPF}.substring(3, 6)+"."+$F{CPF}.substring(6, 9)+"-"+$F{CPF}.substring(9, 11)+"</style>, matrícula funcional nº <style isBold='true'>"+$F{MATRICULA}+"</style>, "+$F{SERVIDOR}+$F{PREFEITURA}+$F{CAMARA}+$F{FIEB}+$F{IPRESB}+" e com o cargo efetivo de "+$F{CARGO}+", <style isBold='true'>RATIFICO</style> minha <style isBold='true'>OPÇÃO</style> por contribuir para o Regime Próprio de Previdência Social - RPPS do município de Barueri (IPRESB), conforme os termos da Lei Complementar nº 198, de 06 de março de 2008, a partir de "+DATEFORMAT($F{DATAINICIO},"MM/yyyy")+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="381" width="454" height="31" uuid="3568dc3e-6b7d-47c0-ae79-5ab4b72bc074"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, _____ de ___________________ de ________."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="122" y="448" width="210" height="29" uuid="486593fd-8793-4a33-a3fa-782beb7662d5"/>
