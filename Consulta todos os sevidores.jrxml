	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<queryString language="SQL">
		<![CDATA[-- SERVIDORES ATIVOS

SELECT DISTINCT
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA],		
		PESSOA.S_NOM_PESSOA AS [NOME COMPLETO],
		

		--CPF
		RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
		+'.'
		+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
		+'.'
		+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
		+'-'
		+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF],

		-- EMAIL
		(CASE WHEN PESSOA.S_EMAIL_PESSOA IS NULL THEN ''
		ELSE LOWER(PESSOA.S_EMAIL_PESSOA) END) AS [EMAIL],		
	

				(CASE WHEN LEN (CONCAT (TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA)) = 9 THEN CONCAT ('11',TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA)
				ELSE CONCAT (TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA) END)  AS [CELULAR],


				--ENTE
		(CASE ORGANIZACAOPESSOA.N_ORG_ORG
		WHEN 1 THEN 'PMB' 
		WHEN 2 THEN 'CÂMARA' 
		WHEN 3 THEN 'FIEB' 
		WHEN 4 THEN 'IPRESB' 
		END) AS ENTE,
					'Ativo' AS [SITUAÇÃO]
		
		


FROM
	
			
			ORGANIZACAOPESSOA 
			LEFT JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
			LEFT JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA
			LEFT JOIN TELEFONEPESSOA ON TELEFONEPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA   AND TELEFONEPESSOA.N_NUM_TELPESSOA IN (SELECT TOP 1 (TP2.N_NUM_TELPESSOA)
																																								FROM TELEFONEPESSOA TP2
																																								WHERE TP2.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA AND TP2.S_TIP_TELPESSOA = ('E'))
			


			
WHERE

		
	
		ORGANIZACAOPESSOA.DT_DSL_ORGPESSOA IS NULL 
		AND	CARGOORGANIZACAOPESSOA.DT_FIMVIG_CARGOORGPESSOA IS NULL 

		-- RETIRAR O VÍNCULO SERVIDOR CARGO COMISSIONADO EXCLUSIVO
		AND CARGOORGANIZACAOPESSOA.N_VINC_CARGOORGPESSOA NOT IN (4,7,9)
		 --AND TELEFONEPESSOA.N_NUM_TELPESSOA IN (SELECT TOP 1 (TP2.N_NUM_TELPESSOA)
			--								FROM TELEFONEPESSOA TP2
			--								WHERE TP2.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA)
		AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA IS NOT NULL
		AND ORGANIZACAOPESSOA.N_ORG_ORG IS NOT NULL
		AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA IS NOT NULL
		






UNION

-- APOSENTADOS


SELECT DISTINCT

		
		BENEFICIOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA],
		PESSOA.S_NOM_PESSOA [NOME COMPLETO],

			--CPF
		RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
		+'.'
		+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
		+'.'
		+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
		+'-'
		+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF],

			-- EMAIL
		(CASE WHEN PESSOA.S_EMAIL_PESSOA IS NULL THEN ''
		ELSE LOWER(PESSOA.S_EMAIL_PESSOA) END) AS [EMAIL],		
		
				(CASE WHEN LEN (CONCAT (TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA)) = 9 THEN CONCAT ('11',TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA)
				ELSE CONCAT (TELEFONEPESSOA.N_DDD_TELPESSOA,TELEFONEPESSOA.N_NUM_TELPESSOA) END)  AS [CELULAR],


					--ENTE
		(CASE BENEFICIOPESSOA.N_ORG_ORG
		WHEN 1 THEN 'PMB' 
		WHEN 2 THEN 'CÂMARA' 
		WHEN 3 THEN 'FIEB' 
		WHEN 4 THEN 'IPRESB' 
		END) AS ENTE,
	

		'Aposentado' AS [SITUAÇÃO]
				
				

		




FROM
	
			
			BENEFICIOPESSOA
			LEFT JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = BENEFICIOPESSOA.N_PESSOA_PESSOA
			LEFT JOIN TELEFONEPESSOA ON TELEFONEPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA   AND TELEFONEPESSOA.N_NUM_TELPESSOA IN (SELECT TOP 1 (TP2.N_NUM_TELPESSOA)
																																								FROM TELEFONEPESSOA TP2
																																								WHERE TP2.N_PESSOA_PESSOA = TELEFONEPESSOA.N_PESSOA_PESSOA AND TP2.S_TIP_TELPESSOA = ('E'))
			


		
			

WHERE

		BENEFICIOPESSOA.N_TIPBNF_TIPBNF IN (1,2,3,4,5,6,14,17,107) AND
		BENEFICIOPESSOA.S_SITPGTO_BNFPESSOA = 1 




	
ORDER BY 
	
		PESSOA.S_NOM_PESSOA]]>
	</queryString>
