				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="12" isBold="true" isUnderline="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[TERMO DE OPÇÃO DA REGRA DE APOSENTADORIA]]></text>
			</staticText>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="-9" y="50" width="348" height="24" uuid="c8a5e070-c8ea-4f61-9f15-1a47068e8dff"/>
