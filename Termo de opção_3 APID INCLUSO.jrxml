	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Protocolo" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @Protocolo INTEGER
SET @Protocolo = $P{Protocolo}

DECLARE @Ano INTEGER
SET @Ano=  $P{Ano}



Select	


PESSOA.S_NOM_PESSOA AS [NOME],
SERVICOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA],
CONVERT(VARCHAR,PESSOA.DT_NASC_PESSOA,103) AS [DATA DE NASCIMENTO],
CONVERT(INT,DATEDIFF(DD, PESSOA.DT_NASC_PESSOA, SBEP.DT_EXE_SIMULBNFEPFPESSOA)/365.25) AS [IDADE],
PESSOA.S_RG_PESSOA AS [RG],
 RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS CPF,
 (CASE	WHEN CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) <=2018 
						THEN 'BI-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) 
						ELSE 'PA-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) 
						END) AS NUMPROC,
						
(CASE PESSOA.S_SEXO_PESSOA 
WHEN 'F' THEN 'FEMININO'
WHEN 'M' THEN 'MASCULINO'
END) AS [SEXO],

CARGO.S_DCR_CARGO AS [CARGO],

 (CASE SBEP .N_ORG_ORG 	
	WHEN 1 THEN 'Prefeitura Municipal de Barueri' 
	WHEN 2 THEN 'Câmara Municipal de Barueri' 
	WHEN 3 THEN 'FIEB'
	WHEN 4 THEN 'IPRESB' END) AS [ENTE],
	
TIPOBENEFICIO.S_DCR_TIPBNF AS [tipoAposentadoriaSimulacao], 

CONVERT(VARCHAR,SBEP.DT_EXE_SIMULBNFEPFPESSOA,103) AS [dataEmissao],

'R$ '+ REPLACE(REPLACE(REPLACE(CONVERT(varchar, CAST(SPBP.N_VLRBNF_SPLNBNFPES AS money), 1),',', '_'), '.', ','), '_', '.') AS [VALOR], 
CONVERT(VARCHAR,SPBP.DT_DIREITOBNF_SPLNBNFPES,103) AS [CUMPRIMENTO],
CONVERT(VARCHAR,SBEP.DT_EXE_SIMULBNFEPFPESSOA,103) AS [DATA DA SIMULAÇÃO],
TIPOREGRA.S_DCRRESM_TIPREGRA AS [FUNDAMENTO LEGAL],

(CASE TIPOREGRA.N_TIPREGRA_TIPREGRA
 WHEN 3 THEN 'INPC'
 WHEN 4 THEN 'INPC'
 WHEN 6 THEN 'PARIDADE'
 WHEN 11 THEN 'PARIDADE'
 WHEN 13 THEN 'PARIDADE'
 WHEN 15 THEN 'INPC'
  END) AS [REAJUSTE],

  REGRAETAPABENEFICIOPLANO.N_SEQ_REGRAETPBNFPLN AS [SEQUENCIAREGRA],
  
  (CASE TIPOREGRA.N_TIPREGRA_TIPREGRA 
  	-- MÉDIA
  	WHEN 3 THEN 'Art. 84, da LC 434/2018'
  	WHEN 15 THEN 'Art. 84, da LC 434/2018'
	-- IDADE
	WHEN 4 THEN 'Art. 37-LC nº 434/2018'

  	-- PARIDADE
  	WHEN 6 THEN 'Art. 84, §11 da LC 434/2018 e Res. 48/2022'
  	WHEN 11 THEN 'Art. 84, §11 da LC 434/2018 e Res. 48/2022'
  	WHEN 13 THEN 'Art. 84, §11 da LC 434/2018 e Res. 48/2022'
  	

   	
 END ) as [FORMA DE CÁLCULO],

 TIPOREGRA.N_TIPREGRA_TIPREGRA AS TIPOREGRA,

 	-- MÉDIA
   (CASE TIPOREGRA.N_TIPREGRA_TIPREGRA 
  	WHEN 3 THEN 'média das contribuições - sujeito à alteração na concessão'
	WHEN 7 THEN 'média das contribuições - sujeito à alteração na concessão'
  	WHEN 15 THEN 'média das contribuições - sujeito à alteração na concessão'
  	-- PARIDADE
  	WHEN 6 THEN 'salário do cargo efetivo'
  	WHEN 11 THEN 'salário do cargo efetivo'
  	WHEN 13 THEN 'salário do cargo efetivo'
  	-- IDADE
	WHEN 4 THEN 'média das contribuições - sujeito à alteração na concessão'

   	
 END ) as [texto do valor],
 
(CASE TIPOREGRA.N_TIPREGRA_TIPREGRA 

   	WHEN 11 THEN ''
   	ELSE 'O valor referente à média de contribuição pode sofrer alteração ou atualização do índice INPC em razão da data de concessão'
   	END) AS [OBS1],

	 RQ.N_TIPREQ_TIPREQ AS [TIPO REQUISITO],
 RQ.S_ATEND_REQSIMULPLNBNFPESSOA AS [ATENDE REQUISITO],
	RQ.N_SEQ_REGRAETPBNFPLN [N_SEQ_REGRA]





from SIMULACAOBENEFICIOESPECIFICACAOPESSOA SBEP 

INNER JOIN PESSOA ON SBEP.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
INNER JOIN SIMULACAOPLANOBENEFICIOPESSOA SPBP on PESSOA.N_PESSOA_PESSOA = SPBP.N_PESSOA_PESSOA
INNER JOIN TIPOBENEFICIO ON SPBP.N_TIPBNF_TIPBNF = TIPOBENEFICIO.N_TIPBNF_TIPBNF
INNER JOIN REGRAETAPABENEFICIOPLANO ON SPBP.N_SEQ_REGRAETPBNFPLN = REGRAETAPABENEFICIOPLANO.N_SEQ_REGRAETPBNFPLN
INNER JOIN TIPOREGRA ON REGRAETAPABENEFICIOPLANO.N_TIPREGRA_TIPREGRA = TIPOREGRA.N_TIPREGRA_TIPREGRA
INNER JOIN SERVICOPESSOA ON SERVICOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
INNER JOIN CARGO ON CARGOORGANIZACAOPESSOA.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = CARGO.N_ORG_ORG
INNER JOIN TIPOSERVICO ON SERVICOPESSOA.N_TIPSERV_TIPSERV = TIPOSERVICO.N_TIPSERV_TIPSERV

INNER JOIN REQUISITOSIMULACAOPLANOBENEFICIOPESSOA RQ ON RQ.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA 
AND RQ.N_SEQ_SIMULBNFEPFPESSOA = SBEP.N_SEQ_SIMULBNFEPFPESSOA 
AND SPBP.N_SEQ_REGRAETPBNFPLN = RQ.N_SEQ_REGRAETPBNFPLN

WHERE 

SERVICOPESSOA.N_NUMPROT_SERVPESSOA = @Protocolo
AND SERVICOPESSOA.N_ANOREFER_SERVPESSOA  = @Ano
AND SERVICOPESSOA.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA
AND CARGOORGANIZACAOPESSOA.DT_FIMVIG_CARGOORGPESSOA IS NULL 

-- ultima simulação
AND  SBEP.N_SEQ_SIMULBNFEPFPESSOA = (SELECT	max(SBEP2.N_SEQ_SIMULBNFEPFPESSOA)
												 FROM	SIMULACAOPLANOBENEFICIOPESSOA SBEP2
												 WHERE	SBEP2.N_PESSOA_PESSOA = SBEP.N_PESSOA_PESSOA) 
												 
--AND TIPOBENEFICIO.N_TIPBNF_TIPBNF NOT IN (17)  

AND
												( 
												((TIPOSERVICO.N_TIPSERV_TIPSERV = 57) AND TIPOREGRA.N_TIPREGRA_TIPREGRA IN (13,15))
												  OR 
												 (TIPOSERVICO.N_TIPSERV_TIPSERV  = 42 AND TIPOREGRA.N_TIPREGRA_TIPREGRA IN (3,6,11))  
												 OR
												 (TIPOSERVICO.N_TIPSERV_TIPSERV = 41 AND TIPOREGRA.N_TIPREGRA_TIPREGRA IN (4))
												 )
AND 
	((RQ.N_TIPREQ_TIPREQ = 31 AND TIPOREGRA.N_TIPREGRA_TIPREGRA = 11 AND RQ.S_ATEND_REQSIMULPLNBNFPESSOA ='S')OR
	(RQ.N_TIPREQ_TIPREQ = 35 AND TIPOREGRA.N_TIPREGRA_TIPREGRA = 6 AND RQ.S_ATEND_REQSIMULPLNBNFPESSOA ='S')OR
	(RQ.N_TIPREQ_TIPREQ = 35 AND TIPOREGRA.N_TIPREGRA_TIPREGRA = 13 AND RQ.S_ATEND_REQSIMULPLNBNFPESSOA ='S') OR
	(RQ.N_TIPREQ_TIPREQ = 1 AND TIPOREGRA.N_TIPREGRA_TIPREGRA = 3 AND RQ.S_ATEND_REQSIMULPLNBNFPESSOA ='S') OR
	(RQ.N_TIPREQ_TIPREQ = 1 AND TIPOREGRA.N_TIPREGRA_TIPREGRA = 15 AND RQ.S_ATEND_REQSIMULPLNBNFPESSOA ='S') OR
	(RQ.N_TIPREQ_TIPREQ = 4 AND TIPOREGRA.N_TIPREGRA_TIPREGRA = 4 AND RQ.S_ATEND_REQSIMULPLNBNFPESSOA ='S')
	)
	

AND 
SBEP.N_SEQ_SIMULBNFEPFPESSOA = SPBP.N_SEQ_SIMULBNFEPFPESSOA 
AND
SBEP.DT_EXE_SIMULBNFEPFPESSOA - SPBP.DT_DIREITOBNF_SPLNBNFPES > 0 

and
TIPOREGRA.S_DCRDTLHE_TIPREGRA IS NOT NULL



ORDER BY REGRAETAPABENEFICIOPLANO.N_SEQ_REGRAETPBNFPLN]]>
	</queryString>
