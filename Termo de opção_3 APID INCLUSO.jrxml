			</textField>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="-9" y="82" width="480" height="24" uuid="13201dc7-2dd5-4653-ab07-e2df231f249b"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Ente: </style>"+$F{ENTE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="141" y="98" width="160" height="24" uuid="ef15d846-caeb-4c3d-9451-b2259605e0f0">
					<property name="com.jaspersoft.studio.unit.y" value="cm"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>CPF: </style>"+$F{CPF}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="-9" y="98" width="150" height="24" uuid="ea8cce60-d6ff-4006-87ec-8db4c994287a"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>RG: </style>"+$F{RG}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="-10" y="125" width="478" height="29" uuid="f81f2ca2-5802-4317-bc9a-58220b8277bd"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="11"/>
					<paragraph firstLineIndent="28"/>
				</textElement>
				<text><![CDATA[Declaro que, analisadas a(s) opção(ões) relacionadas neste termo e, recebidos os esclarecimentos pertinentes, escolho a regra do benefício abaixo:]]></text>
			</staticText>
			<textField>
				<reportElement isPrintRepeatedValues="false" x="311" y="98" width="160" height="24" uuid="8287242a-1f1d-4564-af4a-993c399caee7">
					<property name="com.jaspersoft.studio.unit.y" value="cm"/>
				</reportElement>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Data da emissão: </style>"+$F{dataEmissao}]]></textFieldExpression>
