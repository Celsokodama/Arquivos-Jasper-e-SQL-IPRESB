				<textFieldExpression><![CDATA["\u2022 Benefícios concedidos pelo IPRESB no período de "+ $F{DTINI} + " A " + $F{DTFIM} + "<BR><BR>\u2022 O valor do benefício foi atualizado até a data de " + $F{MES} + "/" + $F{ANO}]]></textFieldExpression>
