		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="MES" class="java.lang.String"/>
	<parameter name="ANO" class="java.lang.String"/>
	<parameter name="ORGAO" class="java.lang.String"/>
	<parameter name="DTINI" class="java.lang.String"/>
	<parameter name="DTFIM" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[set language portuguese
	
	DECLARE @MESHOLERITE AS INT
	DECLARE @ANOHOLERITE AS INT
	DECLARE @ORGAO AS VARCHAR (10)
	DECLARE @DTINI AS DATE
	DECLARE @DTFIM AS DATE
	DECLARE @NDEP AS INT

	SET @MESHOLERITE = $P{MES}
	SET @ANOHOLERITE = $P{ANO}
	SET @ORGAO = $P{ORGAO}
	SET @DTINI =  $P{DTINI}
	SET @DTFIM =   $P{DTFIM}


	select P.S_NOM_PESSOA AS [Beneficiário],
		BP.N_CODORI_ORGPESSOA AS [Matricula],
		(CASE BP.N_ORG_ORG WHEN 1 THEN 'PMB' 
             WHEN 2 THEN 'CÂMARA' 
             WHEN 3 THEN 'FIEB' 
             WHEN 4 THEN 'IPRESB' 
		END) AS ENTE,
		
				CARGO.S_DCR_CARGO AS CARGO,

		
				RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS [CPF],
				
				(CASE BP.N_TIPBNF_TIPBNF
				WHEN 1 THEN 'Aposentadoria'
				WHEN 2  THEN 'Aposentadoria'
				WHEN 3  THEN 'Aposentadoria'
				WHEN 4  THEN 'Aposentadoria'
				WHEN 5  THEN 'Aposentadoria'
				WHEN 6  THEN 'Aposentadoria'
				WHEN 14  THEN 'Aposentadoria'
				WHEN 17 THEN 'Aposentadoria'
				WHEN 107  THEN 'Aposentadoria'
				End) AS [Tipo Benefício],
			CONVERT(VARCHAR,P.DT_NASC_PESSOA,103)  AS [DataNascimento],
			CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) AS [DIB],
			CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) AS [DATA PORTARIA],
					(CASE 
					WHEN BP.N_VLRINIBNF_BNFPESSOA > PAG.N_TOTPROV_RESMHISTPGTO THEN 'R$ ' + REPLACE(CONVERT(VARCHAR,convert(decimal(15,2),BP.N_VLRINIBNF_BNFPESSOA)),'.',',')
					ELSE
					'R$ ' + REPLACE(CONVERT(VARCHAR,PAG.N_TOTPROV_RESMHISTPGTO),'.',',')  END) AS [VALOR],
		(CASE A.N_TIPATO_TIPATO
		WHEN 30 THEN 'COM REDUÇÃO NO IPRESB'
		WHEN 34 THEN 'SEM REDUÇÃO NO IPRESB'
		END) [REDUÇÃO],
		A.S_DCR_ASSENTANEXOCONCES AS OBSERVAÇÃO_ASSENTAMENTO,
		UPPER(@ORGAO) AS ORGAO,
		CONVERT(VARCHAR,@DTINI,103) AS DTINI,
		CONVERT(VARCHAR,@DTFIM,103) AS DTFIM,
		CONVERT(VARCHAR,@MESHOLERITE,103) AS MES,
		CONVERT(VARCHAR,@ANOHOLERITE,103) AS ANO, 
		' ' AS N_dependentes
		

from ASSENTAMENTOANEXOCONCESSAO A 
LEFT JOIN BENEFICIOPESSOA BP ON A.N_PROT_BNFPESSOA = BP.N_PROT_BNFPESSOA
LEFT JOIN PESSOA P ON P.N_PESSOA_PESSOA = BP.N_PESSOA_PESSOA
INNER JOIN RESUMOHISTORICOPAGAMENTO PAG ON BP.N_PROT_BNFPESSOA = PAG.N_PROT_BNFPESSOA AND PAG.N_ANOCOMPET_RESMHISTPGTO = @ANOHOLERITE AND PAG.N_MESCOMPET_RESMHISTPGTO = @MESHOLERITE
full outer JOIN CARGO ON BP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND BP.N_ORG_ORG = CARGO.N_ORG_ORG
LEFT JOIN TIPOBENEFICIO ON TIPOBENEFICIO.N_TIPBNF_TIPBNF = BP.N_TIPBNF_TIPBNF

OUTER APPLY
			(SELECT
				BP2.N_PROT_BNFPESSOA AS PROT,
				SUM(CASE H.N_RUB_RUB
				WHEN 59 THEN 1 
				WHEN 60 THEN 1 
				ELSE 0 
				END) AS N_DEP
			FROM
				HISTORICOPAGAMENTO H
			INNER JOIN
				BENEFICIOPESSOA BP2 ON H.N_PROT_BNFPESSOA = BP2.N_PROT_BNFPESSOA
			WHERE
				H.N_MESCOMPET_HISTPGTO = @MESHOLERITE AND
				H.N_ANOCOMPET_HISTPGTO = @ANOHOLERITE
			GROUP BY
				BP2.N_PROT_BNFPESSOA)
	
			DEP(PROT, N_DEP)

where A.N_TIPATO_TIPATO IN (30,34) 
AND A.S_DCR_ASSENTANEXOCONCES LIKE ('%' + @ORGAO + '%') 
AND BP.S_SITPGTO_BNFPESSOA = 1 

AND BP.DT_DIB_BNFPESSOA >= CONVERT(VARCHAR,@DTINI,103)
AND BP.DT_DIB_BNFPESSOA  <= CONVERT(VARCHAR,@DTFIM,103)

AND BP.N_TIPBNF_TIPBNF IN (1,2,3,4,5,6,14,17,107)
AND MONTH(PAG.DT_REFER_RESMHISTPGTO) = MONTH(PAG.DT_PGTO_RESMHISTPGTO)



UNION   


-- pensionista

select 
				
				P02.S_NOM_PESSOA AS [Beneficiário],
				BP.N_CODORI_ORGPESSOA AS [Matricula],
				(CASE BP.N_ORG_ORG WHEN 1 THEN 'PMB' 
							 WHEN 2 THEN 'CÂMARA' 
							 WHEN 3 THEN 'FIEB' 
							 WHEN 4 THEN 'IPRESB' 
						END) AS ENTE,
						
				NULL AS CARGO,
				RTRIM(SUBSTRING(P02.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P02.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P02.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P02.S_CPF_PESSOA,10,2)) AS [CPF],
				(CASE BP.N_TIPBNF_TIPBNF
				WHEN 19 THEN 'Pensão por Morte'
				WHEN 20 THEN 'Pensão por Morte'
				End) AS [Tipo Benefício],
				
				CONVERT(VARCHAR,P02.DT_NASC_PESSOA,103)  AS [DataNascimento],
				CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) AS [DIB],
		
				(CASE BP.DT_REQTO_BNFPESSOA
				WHEN NULL THEN CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103)
				ELSE
				CONVERT(VARCHAR,BP.DT_REQTO_BNFPESSOA,103) END) AS [DATA PORTARIA],
				(CASE 
					WHEN CAST((BP.N_VLRINIBNF_BNFPESSOA/ DEP.N_DEP) AS money) > CAST(	(PAG.N_TOTPROV_RESMHISTPGTO / DEP.N_DEP) AS money) THEN 'R$ ' + REPLACE(CONVERT(VARCHAR,convert(decimal(15,2),BP.N_VLRINIBNF_BNFPESSOA)),'.',',')
					ELSE 'R$ ' +  REPLACE(CONVERT(VARCHAR,CAST(	(PAG.N_TOTPROV_RESMHISTPGTO / DEP.N_DEP)
							AS money)),'.',',')  END) AS [VALOR],
					
				(CASE ASSENTAMENTO.N_TIPATO_TIPATO
				WHEN 30 THEN 'COM REDUÇÃO NO IPRESB'
				WHEN 34 THEN 'SEM REDUÇÃO NO IPRESB'
				END) [REDUÇÃO],
				ASSENTAMENTO.S_DCR_ASSENTANEXOCONCES AS OBSERVAÇÃO_ASSENTAMENTO,
					UPPER(@ORGAO) AS ORGAO,
				CONVERT(VARCHAR,@DTINI,103) AS DTINI,
				CONVERT(VARCHAR,@DTFIM,103) AS DTFIM,
				CONVERT(VARCHAR,@MESHOLERITE,103) AS MES,
				CONVERT(VARCHAR,@ANOHOLERITE,103) AS ANO,
				DEP.N_DEP
		

			
FROM
			ASSENTAMENTOANEXOCONCESSAO as ASSENTAMENTO 
			LEFT JOIN BENEFICIOPESSOA BP ON ASSENTAMENTO.N_PROT_BNFPESSOA = BP.N_PROT_BNFPESSOA
			INNER JOIN RESUMOHISTORICOPAGAMENTO PAG ON BP.N_PROT_BNFPESSOA = PAG.N_PROT_BNFPESSOA AND PAG.N_ANOCOMPET_RESMHISTPGTO = @ANOHOLERITE AND PAG.N_MESCOMPET_RESMHISTPGTO = @MESHOLERITE
			INNER JOIN PESSOA P2 ON P2.N_PESSOA_PESSOA = BP.N_PESSOA_PESSOA
			INNER JOIN RELACAOPESSOA RP ON P2.N_PESSOA_PESSOA = RP.N_PESSOA_PESSOA
			INNER JOIN TIPOBENEFICIO ON TIPOBENEFICIO.N_TIPBNF_TIPBNF = BP.N_TIPBNF_TIPBNF, PESSOA P02



			
		


			OUTER APPLY
			(SELECT
				BP2.N_PROT_BNFPESSOA AS PROT,
				SUM(CASE H.N_RUB_RUB
				WHEN 59 THEN 1 
				WHEN 60 THEN 1 
				ELSE 0 
				END) AS N_DEP
			FROM
				HISTORICOPAGAMENTO H
			INNER JOIN
				BENEFICIOPESSOA BP2 ON H.N_PROT_BNFPESSOA = BP2.N_PROT_BNFPESSOA
			WHERE
				H.N_MESCOMPET_HISTPGTO = @MESHOLERITE AND
				H.N_ANOCOMPET_HISTPGTO = @ANOHOLERITE
			GROUP BY
				BP2.N_PROT_BNFPESSOA)
	
			DEP(PROT, N_DEP)


where 

			-- 19 E 20 SÃO AS PENSÕ POR MORTE S_SITPGTO_BNFPESSOA = 1 É QUE O PAGAMENTO ESTÁ ATIVO
			BP.N_TIPBNF_TIPBNF IN (19,20) AND BP.S_SITPGTO_BNFPESSOA = 1 AND
			RP.N_GRAUPARENT_GRAUPARENT = 1 AND
			DEP.PROT = BP.N_PROT_BNFPESSOA AND
			P02.N_PESSOA_PESSOA = RP.N_PESSOARELAC_PESSOA AND
			ASSENTAMENTO.N_TIPATO_TIPATO IN (30,34) AND 
			PAG.N_ANOCOMPET_RESMHISTPGTO = @ANOHOLERITE AND
			PAG.N_MESCOMPET_RESMHISTPGTO = @MESHOLERITE AND
			DEP.N_DEP> 0 AND 
			ASSENTAMENTO.S_DCR_ASSENTANEXOCONCES LIKE ('%' + @ORGAO + '%')
		
			AND  BP.DT_REQTO_BNFPESSOA >= CONVERT(VARCHAR,@DTINI,103)
			AND  BP.DT_REQTO_BNFPESSOA  <= CONVERT(VARCHAR,@DTFIM,103)

			-- PARA NÃO APARECER O 13
			AND MONTH(PAG.DT_REFER_RESMHISTPGTO) = MONTH(PAG.DT_PGTO_RESMHISTPGTO)]]>
	</queryString>
