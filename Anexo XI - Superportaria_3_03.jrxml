	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matr" class="java.lang.String"/>
	<parameter name="Ente" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<parameter name="cert" class="java.lang.String"/>
	<parameter name="EXPCTC" class="java.lang.String"/>
	<parameter name="Temp1" class="java.lang.String"/>
	<parameter name="Temp2" class="java.lang.String"/>
	<parameter name="Temp3" class="java.lang.String"/>
	<parameter name="Temp4" class="java.lang.String"/>
	<parameter name="Temp5" class="java.lang.String"/>
	<parameter name="Temp6" class="java.lang.String"/>
	<parameter name="Temp7" class="java.lang.String"/>
	<parameter name="Temp8" class="java.lang.String"/>
	<parameter name="Temp9" class="java.lang.String"/>
	<parameter name="Temp10" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @MUsuario INT
SET @MUsuario = $P{MUsuario}

DECLARE @DInt varchar
SET @DInt = $P{DInt}



SELECT top 1
		PESSOA.S_NOM_PESSOA AS [NOME],
		RTRIM(SUBSTRING(PESSOA.S_PISPASEP_PESSOA,1,3)+'.'+SUBSTRING(PESSOA.S_PISPASEP_PESSOA,4,5)+'.'+SUBSTRING(PESSOA.S_PISPASEP_PESSOA,9,2)+'-'+SUBSTRING(PESSOA.S_PISPASEP_PESSOA,11,1)) AS [PIS/PASEP],
		CONVERT(VARCHAR(10),PESSOA.DT_NASC_PESSOA,103) AS [DATA DE NASCIMENTO],
		RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF],
		PESSOA.S_TITELEIT_PESSOA AS [TÍTULO DE ELEITOR],
		PESSOA.S_RG_PESSOA AS [RG],
		CONVERT(VARCHAR(10),PESSOA.DT_EMISSRG_PESSOA,103) AS [DATA EMISSÃO RG],
		(CASE PESSOA.N_ORGAORG_PESSOA 
			WHEN 1 THEN 'SSP' 
            WHEN 5 THEN 'PF' 
            WHEN 6 THEN 'CRA' 
            WHEN 7 THEN 'CRAS'
			WHEN 8 THEN 'CRB' 
            WHEN 9 THEN 'CRC' 
            WHEN 10 THEN 'CRECI' 
            WHEN 11 THEN 'Corecon'
			WHEN 12 THEN 'Coren' 
            WHEN 13 THEN 'CREA' 
            WHEN 14 THEN 'Conre' 
            WHEN 15 THEN 'CRF'
			WHEN 16 THEN 'Crefito' 
            WHEN 17 THEN 'CRM' 
            WHEN 18 THEN 'CRMV' 
            WHEN 19 THEN 'OMBCRE'
			WHEN 20 THEN 'CRN' 
            WHEN 21 THEN 'CRO'
			WHEN 22 THEN 'Conrerp' 
            WHEN 23 THEN 'CRP' 
            WHEN 24 THEN 'CRQ' 
            WHEN 25 THEN 'CORE'
			WHEN 26 THEN 'OAB' 
            WHEN 27 THEN 'CRBIO' 
            WHEN 28 THEN 'CRFA' 
            WHEN 29 THEN 'CORESS'
			WHEN 30 THEN 'CRTR' 
            WHEN 31 THEN 'Detran'
			WHEN 32 THEN 'PM' 
            WHEN 33 THEN 'CBM' 
            WHEN 34 THEN 'IBA' 
            WHEN 35 THEN 'Polícia Civil'
			WHEN 36 THEN 'IFB' 
            WHEN 99 THEN 'Outros'
		END) AS [ORGÃO EMISSOR],
		PESSOA.S_UFRG_PESSOA AS [UF RG],
		CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA],
		Convert(VARCHAR,ORGANIZACAOPESSOA.DT_ADM_ORGPESSOA,103) As [INGRESSO NO ENTE],
		

		UPPER(CASE HISTORICOENDERECOPESSOA.N_TIPLOGRAD_HISTENDPESSOA	
												WHEN 4 THEN 'Alameda'  
												WHEN 8 THEN 'Av.' 
												WHEN 31 THEN 'Estrada' 
												WHEN 65 THEN 'Praça' 
												WHEN 77 THEN 'Quadra' 
												WHEN 81 THEN 'Rua' 
												WHEN 90 THEN 'Rodovia' 
												WHEN 100 THEN 'Travessa' 
												WHEN 104 THEN 'Vila' 
												END ) + ' ' + +(RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRRUA_HISTENDPESSOA, ''))) + 

												CASE 
												WHEN HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
												THEN '' 
												ELSE ', ' +RTRIM(HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA) END +
												' - ' +
												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
												THEN '' 
												ELSE +' '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA)) END +

												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA IS NULL
												THEN ''
												ELSE ' -  '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA)) END + 
												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA IS NULL 
												THEN ''
												ELSE ' -  '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA)) END +
												' - ' +
												RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRUF_HISTENDPESSOA, '')) AS ENDEREÇO,
				
				 
		PESSOA.S_NOMMAE_PESSOA AS [MÃE],
		PESSOA.S_NOMPAI_PESSOA AS [PAI],
		@MUsuario AS MATRICULAIPRESB,
		$P{cert} AS CERTIDAO,
		$P{EXPCTC} AS [EXPCTC],
		$P{Temp1}AS [TEMPO1],
		$P{Temp2}AS [TEMPO2],
		$P{Temp3}AS [TEMPO3],
		$P{Temp4}AS [TEMPO4],
		$P{Temp5}AS [TEMPO5],
		$P{Temp6}AS [TEMPO6],
		$P{Temp7}AS [TEMPO7],
		$P{Temp8}AS [TEMPO8],
		$P{Temp9}AS [TEMPO9],
		$P{Temp10}AS [TEMPO10],


									
							
                     	(CASE WHEN @DInt = UPPER('S') THEN 'Gestor(a) Interino(a) de Benefícios Previdenciários' ELSE 'Gestor de Benefícios Previdenciários' END) AS CARGO_DIRETOR,
			  			(CASE WHEN @DInt = UPPER('S') THEN (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) ELSE (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2)) END) AS NOME_DIRETOR,					 		
                                                    
		
	  (SELECT        dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA_3.S_NOM_PESSOA)) AS USUARIO
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS USUARIO,
                             (SELECT        dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(CARGO_3.S_DCR_CARGO)) AS [CARGO USUARIO]
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS CARGO_USUARIO

		
		
		
FROM
		PESSOA
		INNER JOIN ORGANIZACAOPESSOA ON ORGANIZACAOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
		INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
		INNER JOIN HISTORICOENDERECOPESSOA  ON HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL

WHERE 
 
CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = $P{Matr} and ORGANIZACAOPESSOA.N_ORG_ORG = $P{Ente}]]>
	</queryString>
