	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="Portaria" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE Português


DECLARE @ANO AS INTEGER
SET @ANO = $P{Ano}

DECLARE @PORTARIA AS INTEGER
SET @PORTARIA = $P{Portaria}


SELECT			
				--ENTE POR EXTENSO
				dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(ORGANIZACAO.S_DCR_ORG))AS ENTE_EXTENSO,

				--CNPJ
				ORGANIZACAO.S_CNPJ_ORG AS CNPJ,

				--RG
				P_INSTITUIDOR.S_RG_PESSOA AS RG,

				--DATA NASCIMENTO
				CONVERT(VARCHAR, P_INSTITUIDOR.DT_NASC_PESSOA, 103) AS NASCIMENTO,

				--MATRÍCULA SEGURADO
				CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA SEGURADO],

				--CPF
				RTRIM(SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,10,2)) AS CPF,
				
				--PISPASEP
				RTRIM(SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,1,3)
				+'.'
				+SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,4,5)
				+'.'
				+SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,9,2)
				+'-'
				+SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,11,1)) AS NIT,

				--NOME
				dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(P_INSTITUIDOR.S_NOM_PESSOA)) AS NOME,

				----DATA DE INGRESSO NO ENTE
				--Convert(VARCHAR,ORGANIZACAOPESSOA.DT_ADM_ORGPESSOA,103) As [DATA INGRESSO NO ENTE],	

				----DATA DE DESLIGAMENTO DO ENTE
				--Convert(VARCHAR,ORGANIZACAOPESSOA.DT_DSL_ORGPESSOA,103) As [DATA DESLIGAMENTO DO ENTE],	
				
				---- TEMPO NO CARGO ATUAL LÍQUIDO
				--TEMPOSERVICOCALCULADO.N_ANO_TEMPOSERVCALC [ANO CARGO ATUAL],
				--TEMPOSERVICOCALCULADO.N_MES_TEMPOSERVCALC [MÊS CARGO ATUAL],
				--TEMPOSERVICOCALCULADO.N_DIA_TEMPOSERVCALC [DIA CARGO ATUAL],
				--TEMPOSERVICOCALCULADO.N_TOTDIAS_TEMPOSERVCALC [DIAS TOTAIS],

				----ENDEREÇO
				--CASE N_TIPLOGRAD_HISTENDPESSOA	WHEN 4 THEN 'Alameda'  
				--								WHEN 8 THEN 'Av.' 
				--								WHEN 31 THEN 'Estrada' 
				--								WHEN 65 THEN 'Praça' 
				--								WHEN 77 THEN 'Quadra' 
				--								WHEN 81 THEN 'Rua' 
				--								WHEN 90 THEN 'Rodovia' 
				--								WHEN 100 THEN 'Travessa' 
				--								WHEN 104 THEN 'Vila' 
				--								END 
				--+' '
				--+dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(S_DCRRUA_HISTENDPESSOA, '')
				--+CASE	WHEN S_NUMLOGRAD_HISTENDPESSOA IS NULL 
				--		THEN ''  
				--		ELSE ', ' +RTRIM(S_NUMLOGRAD_HISTENDPESSOA) END
				--+CASE	WHEN S_DCRBAIRRO_HISTENDPESSOA IS NULL 
				--		THEN '' 
				--		ELSE +', '+RTRIM(S_DCRBAIRRO_HISTENDPESSOA) END
				--+CASE	WHEN S_DCRCOMPL_HISTENDPESSOA IS NULL 
				--		THEN '' 
				--		ELSE ', '+RTRIM(S_DCRCOMPL_HISTENDPESSOA) END
				--+CASE	WHEN S_DCRMUN_HISTENDPESSOA IS NULL 
				--		THEN '' 
				--		ELSE ', '+RTRIM(S_DCRMUN_HISTENDPESSOA) END))
				--+', '+RTRIM(ISNULL(S_DCRUF_HISTENDPESSOA, '')))
				--+', CEP: '
				--+RTRIM(ISNULL(substring(S_CEP_HISTENDPESSOA, 1,2)
				--+ '.' 
				--+ substring(S_CEP_HISTENDPESSOA,3,3) 
				--+ '-' 
				--+ substring(S_CEP_HISTENDPESSOA, 6, 9), '')
				--) as ENDERECO,

				--PROTOCOLO DO PROCESSO
				(CASE	WHEN CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) <=2018 
						THEN 'BI-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) 
						ELSE 'PA-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) 
						END) AS NUMPROC,
				
				--TIPO BENEFÍCIO
				TIPOBENEFICIO.S_DCR_TIPBNF AS [TIPO DE APOSENTADORIA],

				--NÚMERO BENEFÍCIO PARA IDENTIFICAR 1 - APOSENTADORIA POR INVALIDEZ
				BENEFICIOPESSOA.N_TIPBNF_TIPBNF AS [N_BENEF],
				
				-- DATA PORTARIA
				ASSENTAMENTOANEXOCONCESSAO.DT_PUBL_ASSENTANEXOCONCES AS [DATA_PORTARIA],

				--DIB POR EXTENSO
				CONVERT(varchar(02),DATEPART(DAY,BENEFICIOPESSOA.DT_DIB_BNFPESSOA)) 
				+ ' de ' 
				+ DATENAME(MONTH,BENEFICIOPESSOA.DT_DIB_BNFPESSOA) 
				+ ' de ' 
				+ CONVERT(varchar(04),DATEPART(YEAR,BENEFICIOPESSOA.DT_DIB_BNFPESSOA)
				) as DIB,

				--PORTARIA
				ASSENTAMENTOANEXOCONCESSAO.N_ATO_ASSENTANEXOCONCES AS PORTARIA, 
				
				--ANO PORTARIA
				ASSENTAMENTOANEXOCONCESSAO.N_ANOREF_ASSENTANEXOCONCES AS [ANO PORTARIA], 
				
				--CARGO EFETIVO
				dbo.[FN_PRIMEIRALETRAMAIUSCULA](UPPER(CARGOORGANIZACAOPESSOA.S_DCRCARGO_CARGOORGPESSOA)) AS CARGO, 
				
				--TIPO DA REGRA
				TIPOREGRA.S_DCRDTLHE_TIPREGRA AS [FUNDAMENTO LEGAL],

				--TELEFONE IPRESB
				'('+CONVERT(VARCHAR(15),IPRESB_TELEFONE.DDDTel)+') '+ RTRIM(SUBSTRING(CONVERT(VARCHAR(15),IPRESB_TELEFONE.Tel),1,4)
				+'-'
				+SUBSTRING(CONVERT(VARCHAR(15),IPRESB_TELEFONE.Tel),5,8)) AS [TELEFONE IPRESB],

				--WHATSAPP IPRESB
				'('+CONVERT(VARCHAR(15),IPRESB_TELEFONE.DDDWhatsapp)+') '+ RTRIM(SUBSTRING(CONVERT(VARCHAR(15),IPRESB_TELEFONE.Whatsapp),1,5)
				+'-'
				+SUBSTRING(CONVERT(VARCHAR(15),IPRESB_TELEFONE.Whatsapp),6,9)) AS [WHATSAPP IPRESB],

				-- NOME PRESIDENTE
				PRESIDENTE_TITULAR.Nome AS [NOME PRESIDENTE],
								--GÊNERO DO EFETIVO
				(CASE		WHEN P_INSTITUIDOR.S_SEXO_PESSOA = 'M' 
							THEN 'ao segurado' 
							ELSE 'à segurada' 
							END) AS GENERO



FROM			PESSOA AS P_INSTITUIDOR 
				INNER JOIN BENEFICIOPESSOA 
					ON P_INSTITUIDOR.N_PESSOA_PESSOA = BENEFICIOPESSOA.N_PESSOA_PESSOA 
				INNER JOIN  ASSENTAMENTOANEXOCONCESSAO 
					ON BENEFICIOPESSOA.N_PROT_BNFPESSOA = ASSENTAMENTOANEXOCONCESSAO.N_PROT_BNFPESSOA 
				INNER JOIN SERVICOPESSOA 
					ON BENEFICIOPESSOA.N_PROT_SERVPESSOA = SERVICOPESSOA.N_PROT_SERVPESSOA 
				INNER JOIN CARGOORGANIZACAOPESSOA 
					ON P_INSTITUIDOR.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA 
					AND BENEFICIOPESSOA.N_PESSOACARGO_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA 
					AND BENEFICIOPESSOA.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA 
				INNER JOIN TIPOBENEFICIO 
					ON BENEFICIOPESSOA.N_TIPBNF_TIPBNF = TIPOBENEFICIO.N_TIPBNF_TIPBNF 
				INNER JOIN ORGANIZACAO 
					ON BENEFICIOPESSOA.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG
				INNER JOIN ORGANIZACAOPESSOA
					ON ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = BENEFICIOPESSOA.N_CODORI_ORGPESSOA 
					AND ORGANIZACAOPESSOA.N_ORG_ORG = BENEFICIOPESSOA.N_ORG_ORG
				INNER JOIN  TIPOREGRA 
					ON BENEFICIOPESSOA.N_TIPREGRA_TIPREGRA = TIPOREGRA.N_TIPREGRA_TIPREGRA
				--INNER JOIN HISTORICOENDERECOPESSOA 
				--	ON P_INSTITUIDOR.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

				--INNER JOIN SIMULACAOBENEFICIOESPECIFICACAOPESSOA
				--	ON SIMULACAOBENEFICIOESPECIFICACAOPESSOA.N_PROT_BNFPESSOA = BENEFICIOPESSOA.N_PROT_BNFPESSOA
				--INNER JOIN TEMPOSERVICOCALCULADO
				--	ON TEMPOSERVICOCALCULADO.N_PESSOA_PESSOA = BENEFICIOPESSOA.N_PESSOA_PESSOA
				--	AND TEMPOSERVICOCALCULADO.N_TIPREQ_TIPREQ = 3 --REGISTRO DO TEMPO DE CARGO ATUAL
				--INNER JOIN TIPOREQUISITO
				--	ON TIPOREQUISITO.N_TIPREQ_TIPREQ = TEMPOSERVICOCALCULADO.N_TIPREQ_TIPREQ
				
				
OUTER APPLY

			--DADOS DO PRESIDENTE TITULAR
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
					

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 3 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			PRESIDENTE_TITULAR(Nome)

OUTER APPLY

			--DADOS DO PRESIDENTE INTERINO
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
						
			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			PRESIDENTE_INTERINO(Nome)


				OUTER APPLY 

				--NÚMERO DE TELEFONE DO IPRESB
				(SELECT		ORGANIZACAO.N_DDDTEL1_ORG AS [DDD IPRESB]
							,ORGANIZACAO.N_TEL1_ORG AS [TELEFONE IPRESB]
							,ORGANIZACAO.N_DDDTEL2_ORG AS [DDD WHATSAPP]
							,ORGANIZACAO.N_TEL2_ORG AS [WHATSAPP IPRESB]	

				FROM		ORGANIZACAO
				WHERE		ORGANIZACAO.N_ORG_ORG = 4) IPRESB_TELEFONE(DDDTel,Tel,DDDWhatsapp,Whatsapp)

WHERE        (ASSENTAMENTOANEXOCONCESSAO.N_ANOREF_ASSENTANEXOCONCES = @ANO) 
			AND (ASSENTAMENTOANEXOCONCESSAO.N_ATO_ASSENTANEXOCONCES = @PORTARIA) 
			--AND (DT_FIMVIG_HISTENDPESSOA IS NULL)]]>
	</queryString>
	<field name="ENTE_EXTENSO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="ENTE_EXTENSO"/>
	</field>
	<field name="CNPJ" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CNPJ"/>
	</field>
	<field name="RG" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RG"/>
	</field>
	<field name="NASCIMENTO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="NASCIMENTO"/>
	</field>
	<field name="MATRÍCULA SEGURADO" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="MATRÍCULA SEGURADO"/>
	</field>
	<field name="CPF" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CPF"/>
	</field>
	<field name="NIT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="NIT"/>
	</field>
	<field name="NOME" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="NOME"/>
	</field>
	<field name="NUMPROC" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="NUMPROC"/>
	</field>
	<field name="TIPO DE APOSENTADORIA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="TIPO DE APOSENTADORIA"/>
	</field>
	<field name="N_BENEF" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="N_BENEF"/>
	</field>
	<field name="DATA_PORTARIA" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.label" value="DATA_PORTARIA"/>
	</field>
	<field name="DIB" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="DIB"/>
	</field>
	<field name="PORTARIA" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="PORTARIA"/>
	</field>
	<field name="ANO PORTARIA" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="ANO PORTARIA"/>
	</field>
	<field name="CARGO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CARGO"/>
	</field>
	<field name="FUNDAMENTO LEGAL" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="FUNDAMENTO LEGAL"/>
	</field>
	<field name="TELEFONE IPRESB" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="TELEFONE IPRESB"/>
	</field>
	<field name="WHATSAPP IPRESB" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="WHATSAPP IPRESB"/>
	</field>
	<field name="NOME PRESIDENTE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="NOME PRESIDENTE"/>
	</field>
	<field name="GENERO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="GENERO"/>
	</field>
	<pageHeader>
		<band height="70" splitType="Stretch">
			<componentElement>
				<reportElement x="6" y="-2" width="530" height="70" uuid="cc52b66d-a63d-4318-b3ea-71f74a236b9e"/>
				<jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical">
					<datasetRun subDataset="Logo" uuid="c67ef43c-b5ee-46d6-81e7-14fc2ce97490">
						<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					</datasetRun>
					<jr:listContents height="70" width="530">
