<!-- Created with Jaspersoft Studio version 6.21.2.final using JasperReports Library version 6.21.2-8434a0bd7c3bbc37cbf916f2968d35e4b165821a  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="470" leftMargin="85" rightMargin="40" topMargin="14" bottomMargin="0" uuid="d946ebe6-2e92-44c5-aed7-8f7380925278">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ASPPREV"/>
	<property name="com.jaspersoft.studio.unit." value="cm"/>
	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Protocolo" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<parameter name="ExtraT" class="java.lang.String"/>
	<parameter name="VencB" class="java.lang.String"/>
	<parameter name="Trienio" class="java.lang.String"/>
	<parameter name="VPI" class="java.lang.String"/>
	<parameter name="RiscoV" class="java.lang.String"/>
	<parameter name="APMP" class="java.lang.String"/>
	<parameter name="VGD" class="java.lang.String"/>
	<parameter name="N_DEP" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE PORTUGUESE	

DECLARE @Protocolo AS INT
DECLARE @Ano AS INT
DECLARE @MUsuario AS INT

--VARIÁVEIS
DECLARE @VencB AS VARCHAR(10)
DECLARE @Trienio AS VARCHAR(10)
DECLARE @VPI AS VARCHAR(10)
DECLARE @VGD AS VARCHAR(10)
DECLARE @RiscoV AS VARCHAR(10)
DECLARE @APMP AS VARCHAR(10)

DECLARE @N_DEP AS INT

DECLARE @VencBM AS MONEY
DECLARE @TrienioM AS MONEY
DECLARE @VPIM AS MONEY
DECLARE @VGDM AS MONEY
DECLARE @RiscoVM AS MONEY
DECLARE @APMPM AS MONEY



DECLARE @Ente AS INT
DECLARE @Cargo AS INT
DECLARE @ExtraT AS varchar(1)
DECLARE @Matricula AS INT

SET @Protocolo =  $P{Protocolo}
SET @Ano = $P{Ano}
SET @MUsuario = $P{MUsuario}


--SET @Protocolo =  86
--SET @Ano = 2026
--SET @MUsuario = 96

--VARIÁVEIS
--SET @VencB =  1000
--SET @Trienio = ''
--SET @VPI = ''
--SET @RiscoV = ''
--SET @APMP = ''
--SET @ExtraT = ''



SET @VencB =  $P{VencB}
SET @Trienio = $P{Trienio}
SET @VPI = $P{VPI}
SET @VGD = $P{VGD}
SET @RiscoV = $P{RiscoV}
SET @APMP = $P{APMP}
SET @ExtraT = $P{ExtraT}

SET @N_DEP = $P{N_DEP}

--VARIÁVEIS TRANSFORMANDO STRING EM MONEY
SET @VencBM =  CAST(replace(replace(@VencB,'.',''),',','.') AS MONEY)
SET @TrienioM = CAST(replace(replace(@Trienio,'.',''),',','.') AS MONEY)
SET @VGDM = CAST(replace(replace(@VGD,'.',''),',','.') AS MONEY)
SET @VPIM = CAST(replace(replace(@VPI,'.',''),',','.') AS MONEY)
SET @RiscoVM =  CAST(replace(replace(@RiscoV,'.',''),',','.') AS MONEY)
SET @APMPM = CAST(replace(replace(@APMP,'.',''),',','.') AS MONEY)


--FORMAT(valor, 'C', 'pt-BR') R$


--SET @Protocolo =  780
--SET @Ano = 2025
--SET @MUsuario = 96



SET @Ente = (Select SP2.N_ORG_ORG
			FROM SERVICOPESSOA SP2
			WHERE SP2.N_NUMPROT_SERVPESSOA = @Protocolo AND
			SP2.N_ANOREFER_SERVPESSOA = @Ano)

			SET @Matricula = (Select SP3.N_CODORI_ORGPESSOA
			FROM SERVICOPESSOA SP3
			WHERE SP3.N_NUMPROT_SERVPESSOA = @Protocolo AND
			SP3.N_ANOREFER_SERVPESSOA = @Ano)

SET @Cargo = (Select TOP 1 COP3.N_CARGO_CARGO
				FROM CARGOORGANIZACAOPESSOA COP3 INNER JOIN SERVICOPESSOA SP3 ON SP3.N_CODORI_ORGPESSOA = COP3.N_CODORI_ORGPESSOA AND SP3.N_ORG_ORG = COP3.N_ORG_ORG
				WHERE SP3.N_NUMPROT_SERVPESSOA = @Protocolo AND SP3.N_ANOREFER_SERVPESSOA = @Ano  )

SELECT DISTINCT

P.S_NOM_PESSOA AS NOME,
--CPF
RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)	+'.'+SUBSTRING(P.S_CPF_PESSOA,4,3)	+'.'+SUBSTRING(P.S_CPF_PESSOA,7,3)	+'-'+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS [CPF],
COP.N_CODORI_ORGPESSOA AS MATRICULA,
O.S_DCR_ORG AS ORGANIZAÇÃO,
CARGO.S_DCR_CARGO AS CARGO,
TIPO.S_DCRSERV_TIPSERV AS SERVIÇO,
(CASE WHEN RG.S_DCRRESM_REFERGRP IS NULL THEN 'GRUPO: ' ELSE '<b>GRUPO: </b>' + CONVERT(VARCHAR,RG.S_DCRRESM_REFERGRP) END)  AS GRUPO,
													-- (CASE WHEN RSG.S_DCRRESM_REFERSUBGRP IS NULL THEN (CASE WHEN UPPER(@ExtraT) = 'S'THEN '' ELSE CONVERT(VARCHAR,RSG.S_DCRRESM_REFERSUBGRP) END) END) AS SUBGRUPO,
													(CASE WHEN UPPER(@ExtraT) = 'S'THEN '<b> EXTRA-TABELA </b>' ELSE (CASE WHEN RC.S_DCRRESM_REFERCLASS IS NULL THEN '' ELSE '<b> CLASSE: </b>' + CONVERT(VARCHAR, RC.S_DCRRESM_REFERCLASS) END) END) AS CLASSE,
													(CASE WHEN UPPER(@ExtraT) = 'S'THEN '' ELSE (CASE WHEN RN.S_DCRRESM_REFERNIV IS NULL THEN '' ELSE '<b> NÍVEL: </b>' + CONVERT(VARCHAR, RN.S_DCRRESM_REFERNIV) END) END) AS NIVEL,


@MUsuario as MUsuario,
USUARIO as [Nome IPRESB],
[CARGO USUARIO] AS [Cargo IPRESB],


@VencBM AS [VENCIMENTO],
@TrienioM AS TRIENIO,
@VPIM AS VPI,
@VGDM AS VGD,
@RiscoVM AS [RISCO DE VIDA],
@APMPM AS [APMP],

@VencBM + @TrienioM + @VPIM + @RiscoVM + @APMPM AS TOTAL,
SALARIOMINIMO.SALARIOMINIMO AS SALARIOMINIMO,
TETO.VALORTETO,
TETOINSS.VALORTETO AS TETOINSS,
(CASE WHEN 
	(ISNULL(@VencBM,0) + ISNULL(@TrienioM,0) + ISNULL(@VPIM,0) + ISNULL(@RiscoVM,0) + ISNULL(@APMPM,0)) > ISNULL(TETO.VALORTETO,0)
	THEN 
		(ISNULL(@VencBM,0) + ISNULL(@TrienioM,0) + ISNULL(@VPIM,0) + ISNULL(@RiscoVM,0) + ISNULL(@APMPM,0)) - ISNULL(TETO.VALORTETO,0)
	ELSE 0 
END) AS REDUCAO,

(CASE WHEN UPPER(@ExtraT) = 'S' THEN 'S'
ELSE 'N' END) AS EXTRATABELA,
P2.S_NOM_PESSOA AS NOMEDEP,
PARENT.S_DCR_GRAUPARENT AS parentesco,

		(case when parent.N_GRAUPARENT_GRAUPARENT IN (4,7,9,11) then 1
				else (case @N_DEP
						WHEN 1 THEN 0.60
						WHEN 2 THEN 0.70
						WHEN 3 THEN 0.80
						WHEN 4 THEN 0.90
						WHEN 5 THEN 1
						WHEN 6 THEN 1
						WHEN 7 THEN 1
						WHEN 8 THEN 1
						ELSE  0 END) 
		end) AS [PORCENTAGEM_DEP],
		@N_DEP as DEP,

IMPRIMIR.PAG AS IMPRIME,
DIB.DTDIB AS DIB,
SP.N_TIPSERV_TIPSERV AS TIPOSERV,
				(select count (*) 

				FROM SERVICOPESSOA SP
				INNER JOIN ORGANIZACAO O ON SP.N_ORG_ORG = O.N_ORG_ORG
				INNER JOIN TIPOSERVICO TIPO ON TIPO.N_TIPSERV_TIPSERV = SP.N_TIPSERV_TIPSERV				
				LEFT JOIN PESSOA P ON SP.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA
				LEFT JOIN GRUPOFAMILIAR GFAM ON GFAM.N_PESSOA_PESSOA = SP.N_PESSOA_PESSOA AND GFAM.S_DIREITOCOTA_GRPFAM = 'S'
				
				WHERE 
				SP.N_TIPSERV_TIPSERV IN (21,32,41,42,43,57,66,91) AND
				SP.N_NUMPROT_SERVPESSOA = @Protocolo AND
				SP.N_ANOREFER_SERVPESSOA = @Ano
				) as linhas

FROM SERVICOPESSOA SP
INNER JOIN ORGANIZACAO O ON SP.N_ORG_ORG = O.N_ORG_ORG
INNER JOIN TIPOSERVICO TIPO ON TIPO.N_TIPSERV_TIPSERV = SP.N_TIPSERV_TIPSERV
LEFT JOIN CARGOORGANIZACAOPESSOA COP ON SP.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND COP.N_ORG_ORG = SP.N_ORG_ORG AND COP.DT_INIVIG_CARGOORGPESSOA = (SELECT MAX(COP4.DT_INIVIG_CARGOORGPESSOA)
																																									FROM CARGOORGANIZACAOPESSOA COP4
																																									WHERE COP4.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND COP.N_ORG_ORG = COP4.N_ORG_ORG)
LEFT JOIN CARGO ON COP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND COP.N_ORG_ORG = CARGO.N_ORG_ORG 
LEFT JOIN REFERENCIAGRUPO RG ON RG.N_COD_REFERGRP = COP.N_COD_REFERGRP
LEFT JOIN REFERENCIACLASSE RC ON RC.N_COD_REFERCLASS = COP.N_COD_REFERCLASS
LEFT JOIN REFERENCIANIVEL RN ON RN.N_COD_REFERNIV = COP.N_COD_REFERNIV
LEFT JOIN PESSOA P ON SP.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA
LEFT JOIN GRUPOFAMILIAR GFAM ON GFAM.N_PESSOA_PESSOA = SP.N_PESSOA_PESSOA AND GFAM.S_DIREITOCOTA_GRPFAM = 'S'
LEFT JOIN RELACAOPESSOA R ON GFAM.N_PESSOA_PESSOA = R.N_PESSOA_PESSOA AND GFAM.N_PESSOARELAC_PESSOA = R.N_PESSOARELAC_PESSOA
LEFT JOIN GRAUDEPARENTESCO PARENT ON R.N_GRAUPARENT_GRAUPARENT = PARENT.N_GRAUPARENT_GRAUPARENT
LEFT JOIN PESSOA P2 ON GFAM.N_PESSOARELAC_PESSOA = P2.N_PESSOA_PESSOA

	OUTER APPLY 
		(SELECT 
				CASE WHEN DATEDIFF(day, P4.DT_FALEC_PESSOA, SP4.DT_SLCT_SERVPESSOA) <= 30
				THEN P4.DT_FALEC_PESSOA 
				ELSE SP4.DT_SLCT_SERVPESSOA
				END	AS DT_DIB
		FROM SERVICOPESSOA SP4 inner JOIN PESSOA P4 ON P4.N_PESSOA_PESSOA = SP4.N_PESSOA_PESSOA
		WHERE 
		SP4.N_NUMPROT_SERVPESSOA = @Protocolo AND
		SP4.N_ANOREFER_SERVPESSOA = @Ano 
		) DIB(DTDIB)

	OUTER APPLY

		  (SELECT        PESSOA_3.S_NOM_PESSOA AS USUARIO
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS USUARIO,
                             (SELECT       CARGO_3.S_DCR_CARGO AS [CARGO USUARIO]
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS CARGO_USUARIO


	OUTER APPLY

		(SELECT TOP 1
			(CASE 			
					WHEN (COP.N_ORG_ORG = 3 AND COP.N_CARGO_CARGO NOT IN (641,642,643,1402,1403,705)) THEN 'N'
					ELSE NULL END)
		FROM CARGOORGANIZACAOPESSOA COP INNER JOIN CARGO ON COP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND COP.N_ORG_ORG = CARGO.N_ORG_ORG
		WHERE COP.N_ORG_ORG = @Ente AND COP.N_CODORI_ORGPESSOA = @Matricula)
		IMPRIMIR(PAG)

		-- TETO DO INSS

		CROSS APPLY

		(SELECT CAST (CO.N_VLR_COT AS MONEY)
		FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
		WHERE CO.N_UM_UM = 10 AND CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
													FROM COTACAO CO2
													WHERE CO.N_UM_UM = CO2.N_UM_UM AND CO2.N_UM_UM = 10
													AND  CO2.DT_DIA_COT <= (SELECT 
																			CASE WHEN DATEDIFF(day, P4.DT_FALEC_PESSOA, SP4.DT_SLCT_SERVPESSOA) <= 30
																			THEN P4.DT_FALEC_PESSOA 
																			ELSE SP4.DT_SLCT_SERVPESSOA
																			END	AS DT_DIB
																			FROM SERVICOPESSOA SP4 inner JOIN PESSOA P4 ON P4.N_PESSOA_PESSOA = SP4.N_PESSOA_PESSOA
																			WHERE 
																			SP4.N_NUMPROT_SERVPESSOA = @Protocolo AND
																			SP4.N_ANOREFER_SERVPESSOA = @Ano 
																			)
													)
													
													
													)
													
													
													TETOINSS(VALORTETO)
						
		-- SALÁRIO MÍNIMO

		CROSS APPLY

		(SELECT CAST (CO.N_VLR_COT AS MONEY)
		FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
		WHERE CO.N_UM_UM = 37 AND CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
													FROM COTACAO CO2
													WHERE CO.N_UM_UM = CO2.N_UM_UM AND CO2.N_UM_UM = 37
													AND  CO2.DT_DIA_COT <= (SELECT 
																			CASE WHEN DATEDIFF(day, P4.DT_FALEC_PESSOA, SP4.DT_SLCT_SERVPESSOA) <= 30
																			THEN P4.DT_FALEC_PESSOA 
																			ELSE SP4.DT_SLCT_SERVPESSOA
																			END	AS DT_DIB
																			FROM SERVICOPESSOA SP4 inner JOIN PESSOA P4 ON P4.N_PESSOA_PESSOA = SP4.N_PESSOA_PESSOA
																			WHERE 
																			SP4.N_NUMPROT_SERVPESSOA = @Protocolo AND
																			SP4.N_ANOREFER_SERVPESSOA = @Ano 
																			)
													)
													
													
													)
													
													
													SALARIOMINIMO(SALARIOMINIMO)


		-- TETO DA PREFEITURA, PROCURADOR E DA CAMARA
		CROSS APPLY
			(SELECT (CASE 
						WHEN @Ente = 2 then (select CAST (CO.N_VLR_COT AS MONEY)
											FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
											WHERE 
												CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
																FROM COTACAO CO2
																WHERE CO2.N_UM_UM = CO.N_UM_UM)
																-- CO.N_UM_UM = 2 ENTÃO É TETO MUNICIPAL
																-- CO.N_UM_UM = 4 ENTÃO É TETO DO PROCURADOR
																-- CO.N_UM_UM = 5 ENTÃO É TETO DA CÂMARA
												AND CO.N_UM_UM = 5)
						WHEN @Ente = 1 then 
											(CASE WHEN @Cargo IN (279,1000006) THEN 
																				(select CAST (CO.N_VLR_COT AS MONEY)
																				FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
																				WHERE 
																					CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
																									FROM COTACAO CO2
																									WHERE CO2.N_UM_UM = CO.N_UM_UM)
																									-- CO.N_UM_UM = 2 ENTÃO É TETO MUNICIPAL
																									-- CO.N_UM_UM = 4 ENTÃO É TETO DO PROCURADOR
																									-- CO.N_UM_UM = 5 ENTÃO É TETO DA CÂMARA
																					AND CO.N_UM_UM = 4)

											ELSE 								(select CAST (CO.N_VLR_COT AS MONEY)
																				FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
																				WHERE 
																					CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
																									FROM COTACAO CO2
																									WHERE CO2.N_UM_UM = CO.N_UM_UM)
																									-- CO.N_UM_UM = 2 ENTÃO É TETO MUNICIPAL
																									-- CO.N_UM_UM = 4 ENTÃO É TETO DO PROCURADOR
																									-- CO.N_UM_UM = 5 ENTÃO É TETO DA CÂMARA
																					AND CO.N_UM_UM = 2)END)
						WHEN @Ente = 4 then 
											(CASE WHEN @Cargo = 25 THEN 
																				(select CAST (CO.N_VLR_COT AS MONEY)
																				FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
																				WHERE 
																					CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
																									FROM COTACAO CO2
																									WHERE CO2.N_UM_UM = CO.N_UM_UM)
																									-- CO.N_UM_UM = 2 ENTÃO É TETO MUNICIPAL
																									-- CO.N_UM_UM = 4 ENTÃO É TETO DO PROCURADOR
																									-- CO.N_UM_UM = 5 ENTÃO É TETO DA CÂMARA
																					AND CO.N_UM_UM = 4)

											ELSE 								(select CAST (CO.N_VLR_COT AS MONEY)
																				FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
																				WHERE 
																					CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
																									FROM COTACAO CO2
																									WHERE CO2.N_UM_UM = CO.N_UM_UM)
																									-- CO.N_UM_UM = 2 ENTÃO É TETO MUNICIPAL
																									-- CO.N_UM_UM = 4 ENTÃO É TETO DO PROCURADOR
																									-- CO.N_UM_UM = 5 ENTÃO É TETO DA CÂMARA
																					AND CO.N_UM_UM = 2)END)

						ELSE (select CAST (CO.N_VLR_COT AS MONEY)
																				FROM COTACAO CO INNER JOIN UNIDADEMONETARIA UM ON CO.N_UM_UM = UM.N_UM_UM
																				WHERE 
																					CO.DT_DIA_COT = (SELECT MAX(CO2.DT_DIA_COT)
																									FROM COTACAO CO2
																									WHERE CO2.N_UM_UM = CO.N_UM_UM)
																									-- CO.N_UM_UM = 2 ENTÃO É TETO MUNICIPAL
																									-- CO.N_UM_UM = 4 ENTÃO É TETO DO PROCURADOR
																									-- CO.N_UM_UM = 5 ENTÃO É TETO DA CÂMARA
																					AND CO.N_UM_UM = 2)
						end) AS VALORTETO
						) TETO(VALORTETO)



WHERE 
SP.N_TIPSERV_TIPSERV IN (21,32,41,42,43,57,66,91) AND
SP.N_NUMPROT_SERVPESSOA = @Protocolo AND
SP.N_ANOREFER_SERVPESSOA = @Ano and 
COP.DT_INIVIG_CARGOORGPESSOA = (SELECT MAX(COP5.DT_INIVIG_CARGOORGPESSOA)
								FROM CARGOORGANIZACAOPESSOA COP5
								WHERE COP5.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND COP.N_ORG_ORG = COP5.N_ORG_ORG)]]>
	</queryString>
	<field name="NOME" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME"/>
	</field>
	<field name="CPF" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CPF"/>
		<property name="com.jaspersoft.studio.field.label" value="CPF"/>
	</field>
	<field name="MATRICULA" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="MATRICULA"/>
		<property name="com.jaspersoft.studio.field.label" value="MATRICULA"/>
	</field>
