    .add($F{VPI} == null ? java.math.BigDecimal.ZERO : $F{VPI})
    .add($F{RISCO DE VIDA} == null ? java.math.BigDecimal.ZERO : $F{RISCO DE VIDA})
    .add($F{APMP} == null ? java.math.BigDecimal.ZERO : $F{APMP}).compareTo(java.math.BigDecimal.ZERO) == 0))]]></printWhenExpression>
