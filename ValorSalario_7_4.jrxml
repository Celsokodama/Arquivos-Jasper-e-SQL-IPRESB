				</textElement>
				<textFieldExpression><![CDATA[$F{SALARIOMINIMO}.max(
    (
        ($F{VENCIMENTO} == null ? java.math.BigDecimal.ZERO : $F{VENCIMENTO})
            .multiply($F{PORCENTAGEM_DEP})

        .add(
            ($F{TRIENIO} == null ? java.math.BigDecimal.ZERO : $F{TRIENIO})
                .multiply($F{PORCENTAGEM_DEP})
        )

        .add(
            ($F{VPI} == null ? java.math.BigDecimal.ZERO : $F{VPI})
                .multiply($F{PORCENTAGEM_DEP})
        )

        .add(
            ($F{RISCO DE VIDA} == null ? java.math.BigDecimal.ZERO : $F{RISCO DE VIDA})
                .multiply($F{PORCENTAGEM_DEP})
        )

        .add(
            ($F{APMP} == null ? java.math.BigDecimal.ZERO : $F{APMP})
                .multiply($F{PORCENTAGEM_DEP})
        )

        .add(
            ($F{VGD} == null ? java.math.BigDecimal.ZERO : $F{VGD})
                .multiply($F{PORCENTAGEM_DEP})
        )

        .subtract(
            $F{REDUCAO} == null ? java.math.BigDecimal.ZERO : $F{REDUCAO}
        )
    )
)]]></textFieldExpression>
