    (
        ($F{VENCIMENTO} == null ? java.math.BigDecimal.ZERO : $F{VENCIMENTO})
            .multiply($F{PORCENTAGEM_DEP})

        .add(
            ($F{TRIENIO} == null ? java.math.BigDecimal.ZERO : $F{TRIENIO})
                .multiply($F{PORCENTAGEM_DEP})
        )

        .add(
            ($F{VPI} == null ? java.math.BigDecimal.ZERO : $F{VPI})
