		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="Protocolo" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<parameter name="ContrS" class="java.lang.String"/>
	<parameter name="ContrP" class="java.lang.String"/>
	<parameter name="Total" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @PROTOCOLO AS INTEGER
SET @PROTOCOLO = $P{Protocolo}

DECLARE @ANO AS INTEGER
SET @ANO = $P{Ano}

DECLARE @ContrS AS VARCHAR(10)
SET @ContrS  = $P{ContrS}

DECLARE @ContrP AS VARCHAR(10)
SET @ContrP = $P{ContrP}

DECLARE @Total AS VARCHAR(10)
SET @Total = $P{Total}

----Matrícula Usuário IPRESB
DECLARE @MUsuario as VARCHAR(30)
SET @MUsuario = $P{MUsuario}









select top 1 PESSOA.S_NOM_PESSOA  AS [NOME],
'PA-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA)+ '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA)  AS [PROTOCOLO],
SERVICOPESSOA.N_CODORI_ORGPESSOA AS [MATRICULASERVIDOR],
PESSOA.S_SEXO_PESSOA AS [SEXO],
PESSOA.S_RG_PESSOA AS [RG],
	--NOME DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				USUARIO_IPRESB.NOME AS USUARIO,

				--CARGO DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				USUARIO_IPRESB.Matricula AS MATRICULA,
					(CASE CARGO.S_DCR_CARGO
		WHEN 'PEB I' THEN upper(CARGO.S_DCR_CARGO)
		WHEN 'PEB II' THEN upper(CARGO.S_DCR_CARGO)
		WHEN 'PEB III' THEN upper(CARGO.S_DCR_CARGO)
		ELSE CARGO.S_DCR_CARGO END) AS CARGO,
(CASE WHEN PESSOA.S_SEXO_PESSOA ='M'
	THEN 'SERVIDOR'
	ELSE 'SERVIDORA'
END) AS SERVIDOR,

(CASE SERVICOPESSOA.N_ORG_ORG 
			WHEN '1' THEN 'Prefeitura Municipal de Barueri'
			WHEN '2' THEN 'Câmara Municipal de Barueri'
			WHEN '3' THEN 'FIEB'
			WHEN '4' THEN 'IPRESB'
			END)
		AS [ENTE],
			@ContrS AS [ContrS],
				@ContrP AS [ContrP],
				@Total AS [Total]



FROM PESSOA
INNER JOIN SERVICOPESSOA ON PESSOA.N_PESSOA_PESSOA = SERVICOPESSOA.N_PESSOA_PESSOA
INNER JOIN CARGOORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = SERVICOPESSOA.N_CODORI_ORGPESSOA
INNER JOIN CARGO ON CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = CARGO.N_ORG_ORG


OUTER APPLY
	
				(SELECT        

							PESSOA_3.S_NOM_PESSOA,
								 ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA

				FROM           
								PESSOA AS PESSOA_3
								INNER JOIN ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA 
								INNER JOIN CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA
								AND ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG
								INNER JOIN CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO

				WHERE        

								(ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario))
								USUARIO_IPRESB (Nome,Matricula)

WHERE  
SERVICOPESSOA.N_NUMPROT_SERVPESSOA = @Protocolo AND
SERVICOPESSOA.N_ANOREFER_SERVPESSOA = @Ano AND
SERVICOPESSOA.N_TIPSERV_TIPSERV = 64]]>
	</queryString>
