				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="-12" y="80" width="482" height="41" uuid="45c3b5a3-72f4-423f-b748-25c2bc1f12a1"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="14" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[DECLARAÇÃO]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="-12" y="173" width="482" height="410" uuid="434db025-9c65-4f33-9df7-1df8d43b4078"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double" firstLineIndent="0" leftIndent="14" rightIndent="14"/>
				</textElement>
				<textFieldExpression><![CDATA["                   Declaramos, para os devidos fins, que "+$F{Sr}+" <style isBold='true'>"+$F{NOME}+"</style>"+", matrícula funcional " +"<style isBold='true'>"+$F{MATRICULA}+", </style>"+$F{portador}+" do CPF nº "+$F{CPF}+", está  "+$F{aposentado}+" pelo IPRESB - Instituto de Previdência Social dos Servidores Municipais de Barueri, CNPJ: 08.434.600/0001-70, sob a regra de  "+$F{TIPOAPOSENTADORIA} + ", no cargo efetivo de "+$F{CARGO}+" desde "+$F{DIB}+".<br/><br/><br/>	Atenciosamente."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-2" y="461" width="454" height="19" uuid="b2b68586-b4a1-4f5a-8566-a250ed3a151c"/>
