<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="470" leftMargin="85" rightMargin="40" topMargin="14" bottomMargin="0" uuid="d946ebe6-2e92-44c5-aed7-8f7380925278">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="cm"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ASPPREV"/>
	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="matr" class="java.lang.String"/>
	<parameter name="Ente" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @matr as int
Declare @Ente as int
DECLARE @MUsuario as int


set @matr =  $P{matr}
set @Ente = $P{Ente}
set @MUsuario = $P{MUsuario}

SELECT 
		P.S_NOM_PESSOA AS NOME,
		P.S_RG_PESSOA AS RG,
		RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)+'.'+SUBSTRING(P.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(P.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF,
		convert(varchar,BP.DT_DIB_BNFPESSOA,103) as [DIB],
		CARGO.S_DCR_CARGO AS [CARGO],
		TIPOBENEFICIO.S_DCR_TIPBNF AS [TIPOAPOSENTADORIA],

		(CASE P.S_SEXO_PESSOA
		WHEN 'M' THEN 'o Sr.'
		WHEN 'F' THEN 'a Sra.'
		END) AS Sr,

		(CASE P.S_SEXO_PESSOA
		WHEN 'M' THEN 'portador'
		WHEN 'F' THEN 'portadora'
		END) AS portador,

		(CASE P.S_SEXO_PESSOA
		WHEN 'M' THEN 'aposentado'
		WHEN 'F' THEN 'aposentada'
		END) AS aposentado,
		
		$P{matr} as MATRICULA,
		
		
			--NOME DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				USUARIO_IPRESB.Nome AS MUsuario,

				--CARGO DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				USUARIO_IPRESB.Matricula AS IPRESBMatr
		
		
			
FROM 

		PESSOA P INNER JOIN
		BENEFICIOPESSOA BP ON P.N_PESSOA_PESSOA = BP.N_PESSOA_PESSOA INNER JOIN
		CARGO ON CARGO.N_ORG_ORG = BP.N_ORG_ORG AND CARGO.N_CARGO_CARGO = BP.N_CARGO_CARGO INNER JOIN
		TIPOBENEFICIO ON TIPOBENEFICIO.N_TIPBNF_TIPBNF = BP.N_TIPBNF_TIPBNF
		
		
		OUTER APPLY
	
				(SELECT        

								PESSOA_3.S_NOM_PESSOA,
								 ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA

				FROM           
								PESSOA AS PESSOA_3
								INNER JOIN ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA 
								INNER JOIN CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA
								AND ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG
								INNER JOIN CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO

				WHERE        

								(ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario))
				
								USUARIO_IPRESB(Nome,Matricula)


WHERE 

		BP.N_CODORI_ORGPESSOA = @matr and
		BP.N_ORG_ORG = @Ente AND
		BP.S_SITPGTO_BNFPESSOA = '1' AND
		BP.N_TIPBNF_TIPBNF IN (1,2,3,4,5,6,14,17,107)]]>
	</queryString>
	<field name="NOME" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME"/>
	</field>
	<field name="RG" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="RG"/>
		<property name="com.jaspersoft.studio.field.label" value="RG"/>
	</field>
	<field name="CPF" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CPF"/>
		<property name="com.jaspersoft.studio.field.label" value="CPF"/>
	</field>
	<field name="DIB" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="DIB"/>
		<property name="com.jaspersoft.studio.field.label" value="DIB"/>
	</field>
	<field name="CARGO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CARGO"/>
		<property name="com.jaspersoft.studio.field.label" value="CARGO"/>
	</field>
	<field name="TIPOAPOSENTADORIA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="TIPOAPOSENTADORIA"/>
		<property name="com.jaspersoft.studio.field.label" value="TIPOAPOSENTADORIA"/>
	</field>
	<field name="Sr" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="Sr"/>
		<property name="com.jaspersoft.studio.field.label" value="Sr"/>
	</field>
	<field name="portador" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="portador"/>
		<property name="com.jaspersoft.studio.field.label" value="portador"/>
	</field>
	<field name="aposentado" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="aposentado"/>
		<property name="com.jaspersoft.studio.field.label" value="aposentado"/>
	</field>
	<field name="MATRICULA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="MATRICULA"/>
		<property name="com.jaspersoft.studio.field.label" value="MATRICULA"/>
	</field>
	<field name="MUsuario" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="MUsuario"/>
		<property name="com.jaspersoft.studio.field.label" value="MUsuario"/>
	</field>
	<field name="IPRESBMatr" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="IPRESBMatr"/>
		<property name="com.jaspersoft.studio.field.label" value="IPRESBMatr"/>
	</field>
