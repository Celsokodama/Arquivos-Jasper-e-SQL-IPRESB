	<detail>
		<band height="649" splitType="Stretch">
			<textField>
				<reportElement x="-12" y="10" width="482" height="30" uuid="b8bcd072-e914-4d61-aece-41f7fcd0ccf8"/>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="-12" y="140" width="482" height="41" uuid="45c3b5a3-72f4-423f-b748-25c2bc1f12a1"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="14" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[Assunto: Acúmulo de benefícios Previdenciários - EC nº 103/2019]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="-12" y="210" width="482" height="320" uuid="434db025-9c65-4f33-9df7-1df8d43b4078"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double" firstLineIndent="56" leftIndent="14" rightIndent="14"/>
				</textElement>
				<textFieldExpression><![CDATA["Considerando o disposto no Art. 24 da Emenda Constitucional nº 103/2019, comunicamos que foi concedido o benefício da " + $F{Tipo Benefício}+ " com data de início em " + $F{DIB} + ", ao beneficiário: "+"<b>"+ $F{NOME}+"</b>" + " - CPF: " + $F{CPF}+ $F{TEXTO1}+", com valor inicial de " + $F{PROVENTO} + "." + "<br><br><br> Colocamo-nos à disposição em caso de dúvidas.<br><br>Atenciosamente,"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="100" width="470" height="30" uuid="127a9a5e-881f-45dd-ac19-6eebcac47901"/>
				<textElement>
					<font fontName="Arial" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Ao " + $F{ORGAO}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="540" width="470" height="30" uuid="bdecc77e-fa0b-46c6-bdba-c953c1033dee"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[ASSINADO DIGITALMENTE POR]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="563" width="470" height="51" uuid="761e842b-fe3c-4f84-b95f-d0574dc47367"/>
				<textElement textAlignment="Center" markup="html"/>
				<textFieldExpression><![CDATA[$F{NOMEGESTOR} + "<BR>" + $F{CARGOGESTOR}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
