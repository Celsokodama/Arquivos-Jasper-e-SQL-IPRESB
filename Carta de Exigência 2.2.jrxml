				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="110" width="470" height="24" uuid="ac3806ce-b522-42f6-93c6-cc6b24188ba7"/>
