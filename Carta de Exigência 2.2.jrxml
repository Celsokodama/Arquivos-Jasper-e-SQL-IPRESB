				</textElement>
				<textFieldExpression><![CDATA["Ref.: Cumprimento de exigências"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="209" width="450" height="39" uuid="56f12c80-4e9d-4a33-8377-728873908f07"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Para dar andamento ao processo em referência, conforme Art. 28 da Res. 40 /2019, solicitamos a apresentação dos documentos abaixo:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="280" width="458" height="360" uuid="fa347672-612f-4ff1-99c6-0d9f96a8b23a">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="cm"/>
					<property name="com.jaspersoft.studio.unit.spacingBefore" value="cm"/>
				</reportElement>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.6" firstLineIndent="0" leftIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{PISPASEP} !=null ? ("\u2022   " +$F{PISPASEP} + "<br/>"): "")+($F{CERTIDAO} !=null ? ("\u2022   " +$F{CERTIDAO} + "<br/>"): "")+($F{ENDERECO} !=null ? ("\u2022   " +$F{ENDERECO} + "<br/>"): "")+($F{CTPS} !=null ? ("\u2022   " +$F{CTPS} + "<br/>"): "")+($F{InfAdic1} !=null ? ("\u2022   " +$F{InfAdic1} + "<br/>"):"")  +($F{InfAdic2} !=null ? ("\u2022   " +$F{InfAdic2} + "<br/>"):"") + ($F{InfAdic3} !=null ? ("\u2022   " +$F{InfAdic3} + "<br/>"):"") +"<br/><br/>Caso os documentos não sejam apresentados no prazo de <style isBold='true' isUnderline='true'>"+" 60 (sessenta) dias a contar da presente data" +"</style>"+" , prorrogável uma única vez por igual período, o processo será indeferido e arquivado definitivamente conforme o disposto no art. 96 da Resolução nº 40, de 02 de agosto de 2019 (Regulamento do RPPS).<br/><br/>Atenciosamente.<br/><br/><br/><style isBold='true'>"+$F{USUARIO}+"<br/>Matrícula n.º "+$F{MATRICULA_USUARIO_IPRESB}+"</style>"]]></textFieldExpression>
			</textField>
