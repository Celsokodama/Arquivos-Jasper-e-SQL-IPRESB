	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matr" class="java.lang.String"/>
	<parameter name="Ente" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[declare @data_excel int

declare @Matr int
Declare @Ente int

Set @Matr = $P{Matr}
Set @Ente = $P{Ente}

select 
		
		 
		PESSOA.S_NOM_PESSOA AS [NOME],
		PESSOA.N_PESSOA_PESSOA AS [PESSOA],
		PESSOA.S_RG_PESSOA AS [RG],
		 RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS CPF,
		SERVICOPESSOA.N_CODORI_ORGPESSOA AS [MATRICULA],
		CARGO.S_DCR_CARGO AS [CARGO],
				(CASE 
	WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 1 THEN 'Prefeitura do Município de Barueri'
	WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 2 THEN 'Câmara Municipal de Barueri'
	WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 3 THEN 'FIEB'
	WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 4 THEN 'IPRESB'
	 END) AS ENTE,


	 --CONVERT (DATETIME,(CONCAT (1,'/',RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF,'/',  RELACAOSALARIOSIMULACAOBENEFICIO.N_ANOREFER_RELACSALSIMULBNF)),103)AS [MÊS],
	 --RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF AS MÊS,
	 --RELACAOSALARIOSIMULACAOBENEFICIO.N_ANOREFER_RELACSALSIMULBNF AS ANO,

		--CONCAT ((CASE WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 1
		--	THEN '01/01'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 2
		--	THEN '01/02'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 3
		--	THEN '01/03'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 4
		--	THEN '01/04'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 5
		--	THEN '01/05'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 6
		--	THEN '01/06'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 7
		--	THEN '01/07'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 8
		--	THEN '01/08'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 9
		--	THEN '01/09'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 10
		--	THEN '01/10'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 11
		--	THEN '01/11'
		--WHEN RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF = 12
		--	THEN '01/12'
		--END),'/',RELACAOSALARIOSIMULACAOBENEFICIO.N_ANOREFER_RELACSALSIMULBNF )AS [MÊS],
		'R$ ' + REPLACE(CONVERT(VARCHAR,RELACAOSALARIOSIMULACAOBENEFICIO.N_VLRSALORI_RELACSALSIMULBNF),'.',',') AS [VALOR LANÇADO],
		RELACAOSALARIOSIMULACAOBENEFICIO.N_ANOREFER_RELACSALSIMULBNF AS [ANO],
			(CASE DAY(RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF)-1 
			WHEN 1 THEN 'JANEIRO'
			WHEN 2 THEN 'FEVEREIRO'
			WHEN 3 THEN 'MARÇO'
			WHEN 4 THEN 'ABRIL'
			WHEN 5 THEN 'MAIO'
			WHEN 6 THEN 'JUNHO'
			WHEN 7 THEN 'JULHO'
			WHEN 8 THEN 'AGOSTO'
			WHEN 9 THEN 'SETEMBRO'
			WHEN 10 THEN 'OUTUBRO'
			WHEN 11 THEN 'NOVEMBRO'
			WHEN 12 THEN 'DEZEMBRO'
			END) AS [MÊS]
		
		


FROM RELACAOSALARIOSIMULACAOBENEFICIO 
INNER JOIN PESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOSALARIOSIMULACAOBENEFICIO.N_PESSOA_PESSOA
INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
INNER JOIN CARGO ON CARGOORGANIZACAOPESSOA.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG
INNER JOIN SERVICOPESSOA ON SERVICOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA 

WHERE 

		RELACAOSALARIOSIMULACAOBENEFICIO.N_SEQ_SIMULBNFEPFPESSOA = (SELECT
													MAX(TP2.N_SEQ_SIMULBNFEPFPESSOA) 
													FROM	
															RELACAOSALARIOSIMULACAOBENEFICIO TP2
													WHERE
															TP2.N_PESSOA_PESSOA = RELACAOSALARIOSIMULACAOBENEFICIO.N_PESSOA_PESSOA 
															)
		
		--AND
		--Últimos 2 meses
		--SERVICOPESSOA.DT_SLCT_SERVPESSOA >= DATEADD (Month, Datediff(Month, 0, DATEADD(m, -3, current_timestamp)), 0) 

		--Ano anterior e ano atual
		--SERVICOPESSOA.N_ANOREFER_SERVPESSOA >= YEAR(GETDATE())-3 AND
		--SERVICOPESSOA.N_ANOREFER_SERVPESSOA <= YEAR(GETDATE()) AND

			AND	SERVICOPESSOA.N_PROT_SERVPESSOA =		(SELECT MAX(SP.N_PROT_SERVPESSOA)
													FROM SERVICOPESSOA SP
													WHERE SERVICOPESSOA.N_PESSOA_PESSOA = SP.N_PESSOA_PESSOA 
														AND SP.N_TIPSERV_TIPSERV = 60  AND SP.N_CODORI_ORGPESSOA = $P{Matr})
														
		and SERVICOPESSOA.N_CODORI_ORGPESSOA = $P{Matr}
		AND SERVICOPESSOA.N_ORG_ORG = $P{Ente}
		--AND SERVICOPESSOA.N_SIT_SERVPESSOA = 1
		
		--TEMPO SÓ DE REGIME PRÓPRIO
		AND CONVERT (DATETIME,(CONCAT (28,'/',RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF,'/',  RELACAOSALARIOSIMULACAOBENEFICIO.N_ANOREFER_RELACSALSIMULBNF)),103) >= CARGOORGANIZACAOPESSOA.DT_INIVIG_CARGOORGPESSOA
		AND CARGO.N_ORG_ORG = $P{Ente} 
		
		-- ORGÃO PUBLICO ENTE 1 OU 2 OU 3 OU 4 E REGIME PRÓPRIO
		AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P'
		--AND CARGOORGANIZACAOPESSOA.S_CNPJ_CARGOORGPESSOA IN ('46523015000135','06289000000130','65700239000110','08434600000170')


		-- SÓ ATIVOS
		AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA =  $P{Matr}

		-- verificar o que é isso :
		--AND SERVICOPESSOA.N_SIT_SERVPESSOA = 1


		

ORDER BY RELACAOSALARIOSIMULACAOBENEFICIO.N_ANOREFER_RELACSALSIMULBNF, RELACAOSALARIOSIMULACAOBENEFICIO.N_MESREFER_RELACSALSIMULBNF]]>
	</queryString>
