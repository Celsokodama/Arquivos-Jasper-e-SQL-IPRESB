	<parameter name="AposPens" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE PORTUGUÊS
			  
SELECT 	(CASE WHEN $P{AposPens} = UPPER('A') THEN 'aposentado(a)' ELSE 'pensionista' END) AS AposPens]]>
	</queryString>
	<field name="AposPens" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="AposPens"/>
	</field>
	<detail>
		<band height="827" splitType="Stretch">
			<textField>
				<reportElement x="0" y="111" width="454" height="30" uuid="d95e8383-9820-4837-8baa-109eec176f5d"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial" size="14" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy")+".")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="213" width="454" height="182" uuid="b998975e-d92b-499f-ac13-bab6e1080608"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font fontName="Arial" size="14" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="2.5" firstLineIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["Eu, ________________________________________________, portador(a) do RG nº_______________ e CPF nº__________________, "+$F{AposPens}+" do IPRESB, solicito o cadastramento de um usuário e de uma senha de acesso ao sistema de consignados (E-CONSIG), para que eu possa acompanhar as operações realizadas em meu nome."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="0" y="395" width="454" height="111" uuid="88435560-d8b7-42a6-8216-a608d4043de2"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font fontName="Arial" size="14" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="2.5" firstLineIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["Estou ciente que a senha de acesso ao E-CONSIG é pessoal e intransferível e somente eu terei conhecimento da mesma, e que, para minha própria segurança, não devo informá-la a terceiros."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="0" y="506" width="454" height="80" uuid="5e077fa2-765e-44e7-89b7-74dc31d97e2b"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="html">
					<font fontName="Arial" size="14" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="2.5" firstLineIndent="50"/>
				</textElement>
				<textFieldExpression><![CDATA["Assim sendo, assumo total responsabilidade quanto as movimentações realizadas através de meu usuário e senha."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="200" y="670" width="254" height="40" uuid="a5eb0d13-79fe-49c2-8b4b-08e8ee416645"/>
				<box>
					<topPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="html">
					<font fontName="Arial" size="14" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="2.5" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["Assinatura"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
