	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Pessoa" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @Pessoa INTEGER
SET @Pessoa = $P{Pessoa}


SELECT DISTINCT

		
		dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA.S_NOM_PESSOA)) AS [NomeServidor],
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [Matricula],
		(CASE OP.N_CODORI_ORGPESSOA
		WHEN ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA
		THEN ''
		ELSE CONVERT(VARCHAR,OP.N_CODORI_ORGPESSOA)
		END) 
		AS [Matricula 2],

		PESSOA.S_RG_PESSOA AS [RG],
		 RTRIM(SUBSTRING(PESSOA.S_PISPASEP_PESSOA,1,3)+'.'+SUBSTRING(PESSOA.S_PISPASEP_PESSOA,4,5)+'.'+SUBSTRING(PESSOA.S_PISPASEP_PESSOA,9,2)+'-'+SUBSTRING(PESSOA.S_PISPASEP_PESSOA,11,1)) AS PIS,
		 RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS CPF,
		(case PESSOA.S_SEXO_PESSOA 
		WHEN 'M' THEN 'MASCULINO'
		WHEN 'F' THEN 'FEMININO'
		END) AS [Sexo],
		CONVERT(VARCHAR(10),PESSOA.DT_NASC_PESSOA,103) AS [DataNascimento],
		(CASE PESSOA.S_ESTCIVIL_PESSOA 
		WHEN 'U' THEN 'UNIÃO ESTÁVEL'
		WHEN 'C' THEN 'CASADO(A)'
		WHEN 'S' THEN 'SOLTEIRO(A)'
		WHEN 'D' THEN 'DIVORCIADO(A)'
		WHEN 'V' THEN 'VIÚVO(A)'
		WHEN 'P' THEN 'SEPARADO(A)'
				END)
		AS [EstadoCivil],
			dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER( PESSOA.S_NOMMAE_PESSOA))  AS MAE,
		(CASE WHEN PESSOA.S_EMAIL_PESSOA IS NULL THEN 'NÃO CADASTRADO'
		ELSE LOWER(PESSOA.S_EMAIL_PESSOA) END) AS [Email],
		
		-- ENDEREÇO
		UPPER((CASE HISTORICOENDERECOPESSOA.N_TIPLOGRAD_HISTENDPESSOA	
												WHEN 4 THEN 'Alameda'  
												WHEN 8 THEN 'Av.' 
												WHEN 31 THEN 'Estrada' 
												WHEN 65 THEN 'Praça' 
												WHEN 77 THEN 'Quadra' 
												WHEN 81 THEN 'Rua' 
												WHEN 90 THEN 'Rodovia' 
												WHEN 100 THEN 'Travessa' 
												WHEN 104 THEN 'Vila' 
												ELSE 'R.'
												END ) + ' ' + +(RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRRUA_HISTENDPESSOA, ''))) + 

												CASE 
												WHEN HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
												THEN '' 
												ELSE ', ' +RTRIM(HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA) END +
												' - ' +
												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
												THEN '' 
												ELSE +' '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA)) END +

												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA IS NULL
												THEN ''
												ELSE ', '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA)) END + 
												CASE	
												WHEN HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA IS NULL 
												THEN ''
												ELSE ', '+UPPER(RTRIM(HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA)) END +
												' - ' +
												RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRUF_HISTENDPESSOA, ''))) AS ENDEREÇO
		
				

	

FROM
	
			
			PESSOA 
			FULL OUTER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
			FULL OUTER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA
			FULL OUTER JOIN ORGANIZACAOPESSOA AS OP ON PESSOA.N_PESSOA_PESSOA = OP.N_PESSOA_PESSOA
			FULL OUTER JOIN TELEFONEPESSOA ON TELEFONEPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
			FULL OUTER JOIN HISTORICOENDERECOPESSOA ON HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
			FULL OUTER JOIN RELACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = RELACAOPESSOA.N_PESSOA_PESSOA
			FULL OUTER JOIN GRAUDEPARENTESCO ON GRAUDEPARENTESCO.N_GRAUPARENT_GRAUPARENT = RELACAOPESSOA.N_GRAUPARENT_GRAUPARENT


WHERE

		PESSOA.N_PESSOA_PESSOA = $P{Pessoa} AND
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA <= OP.N_CODORI_ORGPESSOA AND
		

		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = (SELECT
													MIN(OP2.N_CODORI_ORGPESSOA) 
													FROM	
															ORGANIZACAOPESSOA OP2
													WHERE
															OP2.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA AND OP2.DT_DSL_ORGPESSOA IS NULL
															) AND

		OP.N_CODORI_ORGPESSOA = (SELECT
													MAX(OP4.N_CODORI_ORGPESSOA) 
													FROM	
															ORGANIZACAOPESSOA OP4
													WHERE
															OP4.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA AND OP4.DT_DSL_ORGPESSOA IS NULL
															)

		AND HISTORICOENDERECOPESSOA.DT_INIVIG_HISTENDPESSOA = (SELECT MAX(HEND2.DT_INIVIG_HISTENDPESSOA)
											FROM HISTORICOENDERECOPESSOA HEND2
											WHERE HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA = HEND2.N_PESSOA_PESSOA) 
	
		]]>
	</queryString>
