				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="-12" y="50" width="482" height="30" uuid="45c3b5a3-72f4-423f-b748-25c2bc1f12a1"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="16" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[DECLARAÇÃO]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="-12" y="137" width="482" height="251" uuid="5eeb230a-84c6-432f-9f78-6816cb94af0b"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Arial" size="14" isBold="false"/>
					<paragraph lineSpacing="Double" firstLineIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA["	Eu, <style isBold='true'>"+$F{NOME}+"</style>"+", matrícula <style isBold='true'>"+$F{MATRICULA}+"</style>"+", servidor(a) efetivo(a) do(a) "+$F{ENTE}+ ", declaro, para fins de atendimento ao § 6.º do art. 118 da Lei Complementar n.º 434 , de 14 de agosto de 2018, que não possuo qualquer período de tempo de serviço ou contribuição a ser comprovado, anterior ao ingresso no serviço público municipal, sendo este o meu primeiro vínculo profissional."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-12" y="467" width="482" height="30" uuid="8aec904a-920b-491f-bed1-36d458341858"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="14" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Ass.: _____________________________"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
