				</textElement>
				<textFieldExpression><![CDATA[$F{NOME} +"<BR>" + $F{PISPASEP} +"<BR>" +$F{DIB} +"<BR>" + $F{TIPO REGRA} +"<BR>" +$F{PROTOCOLO}+ "<BR>" + $F{Observação}]]></textFieldExpression>
