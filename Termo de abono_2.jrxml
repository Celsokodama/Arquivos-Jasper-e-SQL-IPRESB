				</textElement>
				<text><![CDATA[INSTITUTO DE PREVIDÊNCIA SOCIAL DOS SERVIDORES MUNICIPAIS DE BARUERI]]></text>
			</staticText>
			<staticText>
				<reportElement x="-43" y="100" width="509" height="20" uuid="87d2f78a-1e25-41f8-9666-9c872d324656">
