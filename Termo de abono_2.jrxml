			<componentElement>
				<reportElement x="-37" y="770" width="490" height="55" uuid="e3baf365-c2e8-4a3c-8987-6669fa0ffeff"/>
				<jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Vertical">
					<datasetRun subDataset="Rodape" uuid="223309e8-939a-4f33-b7c9-3fcd58a22257">
						<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					</datasetRun>
					<jr:listContents height="55" width="490">
						<image>
							<reportElement x="0" y="5" width="490" height="50" uuid="3fbb8e84-89b9-4b20-9e0d-3b8e8c4440bd"/>
							<imageExpression><![CDATA[$F{IMG_IMGFUNDO_IMGORG}]]></imageExpression>
						</image>
					</jr:listContents>
				</jr:list>
			</componentElement>
			<textField>
				<reportElement x="-1" y="150" width="453" height="240" uuid="aae1045c-e950-459d-80e7-f0112c4c8124"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="Arial" size="12"/>
					<paragraph lineSpacingSize="1.5" firstLineIndent="56"/>
				</textElement>
				<textFieldExpression><![CDATA["                 "+ "Pelo presente termo, "  + "<b>" +$F{NOME}+"</b>"  +", " + "<b>matrícula " + $F{MATRÍCULA}+",</b> "+ "servidor(a) efetivo(a) da " + $F{ENTE} +", " + " no cargo de " +$F{CARGO}+", "+ " declara ter ciência de que cumpre os requisitos para aposentadoria por tempo de contribuição e idade pela regra permanente prevista no artigo 35, da Lei Complementar nº 434. de 14 de agosto de 2018,<b>  fazendo jus,</b> por conseguinte, à percepção do <b>Abono Permanência</b> de que trata o artigo 231 da supracitada Lei, <b>desde que opte por permanecer em atividade.</b>"+ "<br><br>" +
"                 "+"Outrossim, <b>tendo optado pela aposentadoria em face do desinteresse em continuar em atividade</b>, tem, ainda, ciência de que não será possível a concessão do Abono de Permanência pelo ente ao qual está vinculado, circunstância que obsta a emissão de Certidão para esse fim por parte do Instituto de Previdência Social dos Servidores Municipais de Barueri – IPRESB."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
