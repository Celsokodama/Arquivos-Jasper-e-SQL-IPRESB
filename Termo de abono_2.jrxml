	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 4]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matr" class="java.lang.String"/>
	<parameter name="Ente" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT TOP 1 
	dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA.S_NOM_PESSOA)) AS NOME,
	LEFT(PESSOA.S_CPF_PESSOA,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2) AS CPF,
	PESSOA.S_SEXO_PESSOA AS SEXO,
	PESSOA.S_RG_PESSOA AS RG,
	PESSOA.N_PESSOA_PESSOA AS PESSOA,
	ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRÍCULA,
	(CASE 
	WHEN ORGANIZACAOPESSOA.N_ORG_ORG = 1 THEN 'Prefeitura Municipal de Barueri'
	WHEN ORGANIZACAOPESSOA.N_ORG_ORG = 2 THEN 'Câmara Municipal de Barueri'
	WHEN ORGANIZACAOPESSOA.N_ORG_ORG = 3 THEN 'FIEB'
	WHEN ORGANIZACAOPESSOA.N_ORG_ORG = 4 THEN 'IPRESB'
	 END) AS ENTE,
	CARGO.S_DCR_CARGO  AS CARGO




FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN  CARGOORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN
CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO



WHERE        (ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = $P{Matr} AND ORGANIZACAOPESSOA.N_ORG_ORG =  $P{Ente} and  CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = $P{Matr})]]>
	</queryString>
	<field name="NOME" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOME"/>
		<property name="com.jaspersoft.studio.field.label" value="NOME"/>
