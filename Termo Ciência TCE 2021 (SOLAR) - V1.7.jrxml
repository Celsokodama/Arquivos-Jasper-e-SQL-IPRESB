<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="454" leftMargin="85" rightMargin="56" topMargin="14" bottomMargin="0" isFloatColumnFooter="true" uuid="d946ebe6-2e92-44c5-aed7-8f7380925278">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ipresb"/>
	<property name="com.jaspersoft.studio.unit." value="cm"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="725"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="265"/>
	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="Protocolo" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<parameter name="PInt" class="java.lang.String"/>
	<parameter name="Proc1" class="java.lang.String"/>
	<parameter name="Dep1" class="java.lang.String"/>
	<parameter name="Proc2" class="java.lang.String"/>
	<parameter name="Dep2" class="java.lang.String"/>
	<parameter name="Proc3" class="java.lang.String"/>
	<parameter name="Dep3" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE Português

DECLARE @ANO AS INTEGER
SET @ANO = $P{Ano}

DECLARE @PROTOCOLO AS INTEGER
SET @PROTOCOLO = $P{Protocolo}

DECLARE @DInt as VARCHAR(30)
SET @DInt = $P{DInt}

DECLARE @PInt as VARCHAR(30)
SET @PInt = $P{PInt}

DECLARE @Proc1 AS VARCHAR(30)
SET @Proc1 = $P{Proc1}

DECLARE @Dep1 as VARCHAR(100)
SET @Dep1 = $P{Dep1}

DECLARE @Proc2 AS VARCHAR(30)
SET @Proc2 = $P{Proc2}

DECLARE @Dep2 as VARCHAR(100)
SET @Dep2 = $P{Dep2}

DECLARE @Proc3 AS VARCHAR(30)
SET @Proc3 = $P{Proc3}

DECLARE @Dep3 as VARCHAR(100)
SET @Dep3 = $P{Dep3}

SELECT			TOP 1
				--ENTE POR EXTENSO
				dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(ORGANIZACAO.S_DCR_ORG))AS ENTE_EXTENSO,

				--CNPJ
				ORGANIZACAO.S_CNPJ_ORG AS CNPJ,

				--RG
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN P_REQUERENTE.S_RG_PESSOA
						ELSE P_INSTITUIDOR.S_RG_PESSOA
				END) AS RG,

				--DATA NASCIMENTO
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN CONVERT(VARCHAR, P_REQUERENTE.DT_NASC_PESSOA, 103)
						ELSE CONVERT(VARCHAR, P_INSTITUIDOR.DT_NASC_PESSOA, 103)
				END) AS NASCIMENTO,

				--CPF
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN RTRIM(SUBSTRING(P_REQUERENTE.S_CPF_PESSOA,1,3)
								+'.'
								+SUBSTRING(P_REQUERENTE.S_CPF_PESSOA,4,3)
								+'.'
								+SUBSTRING(P_REQUERENTE.S_CPF_PESSOA,7,3)
								+'-'
								+SUBSTRING(P_REQUERENTE.S_CPF_PESSOA,10,2))

						ELSE RTRIM(SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,1,3)
								+'.'
								+SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,4,3)
								+'.'
								+SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,7,3)
								+'-'
								+SUBSTRING(P_INSTITUIDOR.S_CPF_PESSOA,10,2))
				END) AS CPF,
				
				--PISPASEP
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN RTRIM(SUBSTRING(P_REQUERENTE.S_PISPASEP_PESSOA,1,3)
								+'.'
								+SUBSTRING(P_REQUERENTE.S_PISPASEP_PESSOA,4,5)
								+'.'
								+SUBSTRING(P_REQUERENTE.S_PISPASEP_PESSOA,9,2)
								+'-'
								+SUBSTRING(P_REQUERENTE.S_PISPASEP_PESSOA,11,1))

						ELSE RTRIM(SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,1,3)
								+'.'
								+SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,4,5)
								+'.'
								+SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,9,2)
								+'-'
								+SUBSTRING(P_INSTITUIDOR.S_PISPASEP_PESSOA,11,1))
				END) AS NIT,

				--NOME
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(P_REQUERENTE.S_NOM_PESSOA))
						ELSE dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(P_INSTITUIDOR.S_NOM_PESSOA))
				END) AS NOME,

				--EMAIL
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN LOWER(P_REQUERENTE.S_EMAIL_PESSOA)
						ELSE LOWER(P_INSTITUIDOR.S_EMAIL_PESSOA)
				END) AS EMAIL,

				--TELEFONE
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN (CASE	WHEN TEL_PM_CELULAR.N_NUM_TELPESSOA IS NOT NULL
									THEN '(' + RTRIM(TEL_PM_CELULAR.N_DDD_TELPESSOA) + ') ' + RTRIM(TEL_PM_CELULAR.N_NUM_TELPESSOA)
									ELSE '(' + RTRIM(TEL_PM_RESIDENCIAL.N_DDD_TELPESSOA) + ') ' + RTRIM(TEL_PM_RESIDENCIAL.N_NUM_TELPESSOA)
									END)
						ELSE (CASE	WHEN TEL_AP_CELULAR.N_NUM_TELPESSOA IS NOT NULL
									THEN '(' + RTRIM(TEL_AP_CELULAR.N_DDD_TELPESSOA) + ') '+ RTRIM(TEL_AP_CELULAR.N_NUM_TELPESSOA)
									ELSE '(' + RTRIM(TEL_AP_RESIDENCIAL.N_DDD_TELPESSOA) + ') '+ RTRIM(TEL_AP_RESIDENCIAL.N_NUM_TELPESSOA)
									END)
				END) AS TELEFONE,

				--ENDEREÇO
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN (CASE ENDEREÇO_PM.N_TIPLOGRAD_HISTENDPESSOA	
												WHEN 4 THEN 'Alameda'  
												WHEN 8 THEN 'Av.' 
												WHEN 31 THEN 'Estrada' 
												WHEN 65 THEN 'Praça' 
												WHEN 77 THEN 'Quadra' 
												WHEN 81 THEN 'Rua' 
												WHEN 90 THEN 'Rodovia' 
												WHEN 100 THEN 'Travessa' 
												WHEN 104 THEN 'Vila' 
												END )
				+' '
				+dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(ENDEREÇO_PM.S_DCRRUA_HISTENDPESSOA, '')
				+CASE	WHEN ENDEREÇO_PM.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
						THEN ''  
						ELSE ', ' +RTRIM(ENDEREÇO_PM.S_NUMLOGRAD_HISTENDPESSOA) END
				+CASE	WHEN ENDEREÇO_PM.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE +', '+RTRIM(ENDEREÇO_PM.S_DCRBAIRRO_HISTENDPESSOA) END
				+CASE	WHEN ENDEREÇO_PM.S_DCRCOMPL_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE ', '+RTRIM(ENDEREÇO_PM.S_DCRCOMPL_HISTENDPESSOA) END
				+CASE	WHEN ENDEREÇO_PM.S_DCRMUN_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE ', '+RTRIM(ENDEREÇO_PM.S_DCRMUN_HISTENDPESSOA) END))
				+', '+RTRIM(ISNULL(ENDEREÇO_PM.S_DCRUF_HISTENDPESSOA, '')))
				+', CEP: '
				+RTRIM(ISNULL(substring(ENDEREÇO_PM.S_CEP_HISTENDPESSOA, 1,2)
				+ '.' 
				+ substring(ENDEREÇO_PM.S_CEP_HISTENDPESSOA,3,3) 
				+ '-' 
				+ substring(ENDEREÇO_PM.S_CEP_HISTENDPESSOA, 6, 9), '')
				)
						ELSE (CASE ENDEREÇO_AP.N_TIPLOGRAD_HISTENDPESSOA	
												WHEN 4 THEN 'Alameda'  
												WHEN 8 THEN 'Av.' 
												WHEN 31 THEN 'Estrada' 
												WHEN 65 THEN 'Praça' 
												WHEN 77 THEN 'Quadra' 
												WHEN 81 THEN 'Rua' 
												WHEN 90 THEN 'Rodovia' 
												WHEN 100 THEN 'Travessa' 
												WHEN 104 THEN 'Vila' 
												END )
				+' '
				+dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(ENDEREÇO_AP.S_DCRRUA_HISTENDPESSOA, '')
				+CASE	WHEN ENDEREÇO_AP.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
						THEN ''  
						ELSE ', ' +RTRIM(ENDEREÇO_AP.S_NUMLOGRAD_HISTENDPESSOA) END
				+CASE	WHEN ENDEREÇO_AP.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE +', '+RTRIM(ENDEREÇO_AP.S_DCRBAIRRO_HISTENDPESSOA) END
				+CASE	WHEN ENDEREÇO_AP.S_DCRCOMPL_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE ', '+RTRIM(ENDEREÇO_AP.S_DCRCOMPL_HISTENDPESSOA) END
				+CASE	WHEN ENDEREÇO_AP.S_DCRMUN_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE ', '+RTRIM(ENDEREÇO_AP.S_DCRMUN_HISTENDPESSOA) END))
				+', '+RTRIM(ISNULL(ENDEREÇO_AP.S_DCRUF_HISTENDPESSOA, '')))
				+', CEP: '
				+RTRIM(ISNULL(substring(ENDEREÇO_AP.S_CEP_HISTENDPESSOA, 1,2)
				+ '.' 
				+ substring(ENDEREÇO_AP.S_CEP_HISTENDPESSOA,3,3) 
				+ '-' 
				+ substring(ENDEREÇO_AP.S_CEP_HISTENDPESSOA, 6, 9), '')
				)
				END) AS ENDEREÇO,

				--PROTOCOLO DO PROCESSO
				(CASE	WHEN CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) <=2018 
						THEN 'BI-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) 
						ELSE 'PA-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) 
						END) AS NUMPROC,
				
				--TIPO BENEFÍCIO
				--TIPOSERVICO.S_DCRSERV_TIPSERV AS [TIPO DO BENEFÍCIO],
				
				--CARGO EFETIVO
				--dbo.[FN_PRIMEIRALETRAMAIUSCULA](UPPER(CARGOORGANIZACAOPESSOA.S_DCRCARGO_CARGOORGPESSOA)) AS CARGO, 
				(CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21 --PENSÃO POR MORTE = 21
						THEN null
						ELSE dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO))
				END) AS [CARGO],

				--DATA HOJE
				CONVERT(VARCHAR,GETDATE(),103) AS [DATA HOJE],

				--DATA HOJE EXTENSO
				CONVERT(varchar(02),DATEPART(DAY,GETDATE())) + ' de ' + DATENAME(MONTH,GETDATE()) + ' de ' + CONVERT(varchar(04),DATEPART(YEAR,GETDATE())) as [DATA HOJE EXTENSO],
				--TELEFONE IPRESB
				'('+CONVERT(VARCHAR(15),IPRESB_TELEFONE.DDD)+') '+ CONVERT(VARCHAR(15),IPRESB_TELEFONE.Tel) AS [TELEFONE IPRESB],
				
				--CARGO EFETIVO DO GESTOR INTERINO
				GESTOR_INTERINO.Cargo_Efetivo AS [CARGO DO DIRETOR INTERINO], 

				--CARGO EFETIVO DO PRESIDENTE INTERINO
				PRESIDENTE_INTERINO.Cargo_Efetivo AS [CARGO DO PRESIDENTE INTERINO],

				--MATRÍCULA DO CARGO EFETIVO DO GESTOR INTERINO
				GESTOR_INTERINO.Matrícula AS [MATRICULA DO DIRETOR INTERINO], 

				--MATRÍCULA DO CARGO EFETIVO DO PRESIDENTE INTERINO
				PRESIDENTE_INTERINO.Matrícula AS [MATRICULA DO PRESIDENTE INTERINO],	

				--NOMENCLATURA DO CARGO DE GESTOR
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nomenclatura_Cargo 
							ELSE GESTOR_TITULAR.Nomenclatura_Cargo
							END) AS CARGO_DIRETOR,

				--NOMENCLATURA DO CARGO DE PRESIDENTE
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.Nomenclatura_Cargo 
							ELSE PRESIDENTE_TITULAR.Nomenclatura_Cargo
							END) AS CARGO_PRESIDENTE,

				--NOME DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nome
							ELSE GESTOR_TITULAR.Nome
							END) AS NOME_DIRETOR,

				--NOME DO PRESIDENTE EM EXERCÍCIO
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.Nome
							ELSE PRESIDENTE_TITULAR.Nome
							END) AS NOME_PRESIDENTE,

				--CPF DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.CPF
							ELSE GESTOR_TITULAR.CPF
							END) AS CPF_GESTOR,

				--CPF DO PRESIDENTE EM EXERCÍCIO
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.CPF
							ELSE PRESIDENTE_TITULAR.CPF
							END) AS CPF_PRESIDENTE,

				--RG DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.RG
							ELSE GESTOR_TITULAR.RG
							END) AS RG_GESTOR,

				--RG DO PRESIDENTE EM EXERCÍCIO
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.RG
							ELSE PRESIDENTE_TITULAR.RG
							END) AS RG_PRESIDENTE,

				--NASCIMENTO DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nascimento
							ELSE GESTOR_TITULAR.Nascimento
							END) AS NASC_GESTOR,

				--NASCIMENTO DO PRESIDENTE EM EXERCÍCIO
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.Nascimento
							ELSE PRESIDENTE_TITULAR.Nascimento
							END) AS NASC_PRESIDENTE,

				--EMAIL DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Email
							ELSE GESTOR_TITULAR.Email
							END) AS EMAIL_GESTOR,

				--EMAIL DO PRESIDENTE EM EXERCÍCIO
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.Email
							ELSE PRESIDENTE_TITULAR.Email
							END) AS EMAIL_PRESIDENTE,

				--ENDEREÇO DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Endereço
							ELSE GESTOR_TITULAR.Endereço
							END) AS END_GESTOR,

				--ENDEREÇO DO PRESIDENTE EM EXERCÍCIO
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.Endereço
							ELSE PRESIDENTE_TITULAR.Endereço
							END) AS END_PRESIDENTE
				
				----NOME DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				--USUARIO_IPRESB.Nome AS USUARIO,

				----CARGO DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				--USUARIO_IPRESB.Cargo AS CARGO_USUARIO

				,(CASE	WHEN @Proc1 = ''
						THEN null
						ELSE (CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21
									THEN @Proc1
									ELSE null
							 END)
				END) AS [PROCESSO ADICIONAL 1]

				,(CASE	WHEN @Dep1 = ''
						THEN null
						ELSE (CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21
									THEN dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(@Dep1))
									ELSE null
							 END)
				END) AS [DEPENDENTE 1]

				,(CASE	WHEN @Proc2 = ''
						THEN null
						ELSE (CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21
									THEN @Proc2
									ELSE null
							 END)
				END) AS [PROCESSO ADICIONAL 2]

				,(CASE	WHEN @Dep2 = ''
						THEN null
						ELSE (CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21
									THEN dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(@Dep2))
									ELSE null
							 END)
				END) AS [DEPENDENTE 2]

				,(CASE	WHEN @Proc3 = ''
						THEN null
						ELSE (CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21
									THEN @Proc3
									ELSE null
							 END)
				END) AS [PROCESSO ADICIONAL 3]

				,(CASE	WHEN @Dep3 = ''
						THEN null
						ELSE (CASE	WHEN SERVICOPESSOA.N_TIPSERV_TIPSERV = 21
									THEN dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(@Dep3))
									ELSE null
							 END)
				END) AS [DEPENDENTE 3]

FROM          
				SERVICOPESSOA
				INNER JOIN PESSOA AS P_INSTITUIDOR 
					ON	SERVICOPESSOA.N_PESSOA_PESSOA = P_INSTITUIDOR.N_PESSOA_PESSOA
				INNER JOIN	CARGOORGANIZACAOPESSOA 
					ON	(CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = SERVICOPESSOA.N_PESSOA_PESSOA) 
					AND	(CARGOORGANIZACAOPESSOA.N_ORG_ORG = SERVICOPESSOA.N_ORG_ORG) 
					AND (CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = SERVICOPESSOA.N_CODORI_ORGPESSOA) 
					AND (CARGOORGANIZACAOPESSOA.DT_INIVIG_CARGOORGPESSOA <= GETDATE())
					AND (CARGOORGANIZACAOPESSOA.S_MRCTEMPOCTB_CARGOORGPESSOA = 'S')	
					AND (CARGOORGANIZACAOPESSOA.S_RESPTEMPO_CARGOORGPESSOA = 'I')
				INNER JOIN	CARGO
					ON	(CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG) 
					AND (CARGO.N_CARGO_CARGO =	CARGOORGANIZACAOPESSOA.N_CARGO_CARGO)
				INNER JOIN ORGANIZACAO 
					ON SERVICOPESSOA.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG 
				INNER JOIN HISTORICOENDERECOPESSOA AS ENDEREÇO_AP
					ON P_INSTITUIDOR.N_PESSOA_PESSOA = ENDEREÇO_AP.N_PESSOA_PESSOA
					AND (ENDEREÇO_AP.DT_FIMVIG_HISTENDPESSOA IS NULL)
				FULL OUTER JOIN PESSOA P_REQUERENTE 
					ON SERVICOPESSOA.N_PESSOA_RESP = P_REQUERENTE.N_PESSOA_PESSOA
				FULL OUTER JOIN HISTORICOENDERECOPESSOA AS ENDEREÇO_PM
					ON P_REQUERENTE.N_PESSOA_PESSOA = ENDEREÇO_PM.N_PESSOA_PESSOA
					AND (ENDEREÇO_PM.DT_FIMVIG_HISTENDPESSOA IS NULL)

				--PEGANDO OS TELEFONES
				FULL OUTER JOIN TELEFONEPESSOA AS TEL_AP_CELULAR
					ON  P_INSTITUIDOR.N_PESSOA_PESSOA = TEL_AP_CELULAR.N_PESSOA_PESSOA
					AND (TEL_AP_CELULAR.S_TIP_TELPESSOA = 'E')

				FULL OUTER JOIN TELEFONEPESSOA AS TEL_AP_RESIDENCIAL
					ON  P_INSTITUIDOR.N_PESSOA_PESSOA = TEL_AP_RESIDENCIAL.N_PESSOA_PESSOA
					AND (TEL_AP_RESIDENCIAL.S_TIP_TELPESSOA = 'R')

				FULL OUTER JOIN TELEFONEPESSOA AS TEL_PM_CELULAR
					ON  P_REQUERENTE.N_PESSOA_PESSOA = TEL_PM_CELULAR.N_PESSOA_PESSOA
					AND (TEL_PM_CELULAR.S_TIP_TELPESSOA = 'E')

				FULL OUTER JOIN TELEFONEPESSOA AS TEL_PM_RESIDENCIAL
					ON  P_REQUERENTE.N_PESSOA_PESSOA = TEL_PM_RESIDENCIAL.N_PESSOA_PESSOA
					AND (TEL_PM_RESIDENCIAL.S_TIP_TELPESSOA = 'R')

OUTER APPLY

			--DADOS DO GESTOR TITULAR
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
						
						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]

						,PESSOA.S_EMAIL_PESSOA AS [EMAIL]

						,(CASE	HISTORICOENDERECOPESSOA.N_TIPLOGRAD_HISTENDPESSOA	WHEN 4 THEN 'Alameda'  
																					WHEN 8 THEN 'Av.' 
																					WHEN 31 THEN 'Estrada' 
																					WHEN 65 THEN 'Praça' 
																					WHEN 77 THEN 'Quadra' 
																					WHEN 81 THEN 'Rua' 
																					WHEN 90 THEN 'Rodovia' 
																					WHEN 100 THEN 'Travessa' 
																					WHEN 104 THEN 'Vila' 
																					ELSE '' 
																					END) 
						+' '
						+ dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRRUA_HISTENDPESSOA, '')
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
								THEN ''  
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE +', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(S_DCRMUN_HISTENDPESSOA) 
								END))
						+', '+RTRIM(ISNULL(S_DCRUF_HISTENDPESSOA, '')))
						+', CEP: '+RTRIM(ISNULL(substring(S_CEP_HISTENDPESSOA, 1,2) + '.' + substring(S_CEP_HISTENDPESSOA,3,3) + '-' + substring(S_CEP_HISTENDPESSOA, 6, 9), '')) AS [ENDEREÇO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_TITULAR(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento,Email,Endereço)

OUTER APPLY

			--DADOS DO GESTOR INTERINO
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
						
						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]

						,PESSOA.S_EMAIL_PESSOA AS [EMAIL]

						,(CASE	HISTORICOENDERECOPESSOA.N_TIPLOGRAD_HISTENDPESSOA	WHEN 4 THEN 'Alameda'  
																					WHEN 8 THEN 'Av.' 
																					WHEN 31 THEN 'Estrada' 
																					WHEN 65 THEN 'Praça' 
																					WHEN 77 THEN 'Quadra' 
																					WHEN 81 THEN 'Rua' 
																					WHEN 90 THEN 'Rodovia' 
																					WHEN 100 THEN 'Travessa' 
																					WHEN 104 THEN 'Vila' 
																					ELSE '' 
																					END) 
						+' '
						+ dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRRUA_HISTENDPESSOA, '')
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
								THEN ''  
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE +', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(S_DCRMUN_HISTENDPESSOA) 
								END))
						+', '+RTRIM(ISNULL(S_DCRUF_HISTENDPESSOA, '')))
						+', CEP: '+RTRIM(ISNULL(substring(S_CEP_HISTENDPESSOA, 1,2) + '.' + substring(S_CEP_HISTENDPESSOA,3,3) + '-' + substring(S_CEP_HISTENDPESSOA, 6, 9), '')) AS [ENDEREÇO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_INTERINO(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento,Email,Endereço)

OUTER APPLY

			--DADOS DO PRESIDENTE TITULAR
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
						
						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]

						,PESSOA.S_EMAIL_PESSOA AS [EMAIL]

						,(CASE	HISTORICOENDERECOPESSOA.N_TIPLOGRAD_HISTENDPESSOA	WHEN 4 THEN 'Alameda'  
																					WHEN 8 THEN 'Av.' 
																					WHEN 31 THEN 'Estrada' 
																					WHEN 65 THEN 'Praça' 
																					WHEN 77 THEN 'Quadra' 
																					WHEN 81 THEN 'Rua' 
																					WHEN 90 THEN 'Rodovia' 
																					WHEN 100 THEN 'Travessa' 
																					WHEN 104 THEN 'Vila' 
																					ELSE '' 
																					END) 
						+' '
						+ dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRRUA_HISTENDPESSOA, '')
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
								THEN ''  
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE +', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(S_DCRMUN_HISTENDPESSOA) 
								END))
						+', '+RTRIM(ISNULL(S_DCRUF_HISTENDPESSOA, '')))
						+', CEP: '+RTRIM(ISNULL(substring(S_CEP_HISTENDPESSOA, 1,2) + '.' + substring(S_CEP_HISTENDPESSOA,3,3) + '-' + substring(S_CEP_HISTENDPESSOA, 6, 9), '')) AS [ENDEREÇO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 3 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			PRESIDENTE_TITULAR(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento,Email,Endereço)

OUTER APPLY

			--DADOS DO PRESIDENTE INTERINO
			(SELECT
						dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) AS [NOME]
						
						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]

						,PESSOA.S_EMAIL_PESSOA AS [EMAIL]

						,(CASE	HISTORICOENDERECOPESSOA.N_TIPLOGRAD_HISTENDPESSOA	WHEN 4 THEN 'Alameda'  
																					WHEN 8 THEN 'Av.' 
																					WHEN 31 THEN 'Estrada' 
																					WHEN 65 THEN 'Praça' 
																					WHEN 77 THEN 'Quadra' 
																					WHEN 81 THEN 'Rua' 
																					WHEN 90 THEN 'Rodovia' 
																					WHEN 100 THEN 'Travessa' 
																					WHEN 104 THEN 'Vila' 
																					ELSE '' 
																					END) 
						+' '
						+ dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(RTRIM(ISNULL(HISTORICOENDERECOPESSOA.S_DCRRUA_HISTENDPESSOA, '')
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
								THEN ''  
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_NUMLOGRAD_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE +', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRBAIRRO_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(HISTORICOENDERECOPESSOA.S_DCRCOMPL_HISTENDPESSOA) 
								END
						+ CASE	WHEN HISTORICOENDERECOPESSOA.S_DCRMUN_HISTENDPESSOA IS NULL 
								THEN '' 
								ELSE ', '+RTRIM(S_DCRMUN_HISTENDPESSOA) 
								END))
						+', '+RTRIM(ISNULL(S_DCRUF_HISTENDPESSOA, '')))
						+', CEP: '+RTRIM(ISNULL(substring(S_CEP_HISTENDPESSOA, 1,2) + '.' + substring(S_CEP_HISTENDPESSOA,3,3) + '-' + substring(S_CEP_HISTENDPESSOA, 6, 9), '')) AS [ENDEREÇO]
			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			PRESIDENTE_INTERINO(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento,Email,Endereço)

--OUTER APPLY
				
--				--DADOS DO USÁRIO IPRESB RESPONSÁVEL PELO RELATÓRIO
--				(SELECT        

--								dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA_3.S_NOM_PESSOA))
--								,dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(CARGO_3.S_DCR_CARGO))

--				FROM           
--								PESSOA AS PESSOA_3
--								INNER JOIN ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA 
--								INNER JOIN CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA
--								AND ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG
--								INNER JOIN CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO

--				WHERE        

--								(ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario))
				
--								USUARIO_IPRESB(Nome,Cargo)

				OUTER APPLY 

				--NÚMERO DE TELEFONE DO IPRESB
				(SELECT		ORGANIZACAO.N_DDDTEL1_ORG AS [DDD IPRESB]
							,ORGANIZACAO.N_TEL1_ORG AS [TELEFONE IPRESB]	

				FROM		ORGANIZACAO
				WHERE		ORGANIZACAO.N_ORG_ORG = 4) IPRESB_TELEFONE(DDD,Tel)


WHERE			(SERVICOPESSOA.N_ANOREFER_SERVPESSOA = @ANO) 
				AND (SERVICOPESSOA.N_NUMPROT_SERVPESSOA = @PROTOCOLO) 
				--AND (ENDEREÇO_AP.DT_FIMVIG_HISTENDPESSOA IS NULL OR ENDEREÇO_PM.DT_FIMVIG_HISTENDPESSOA IS NULL)
				

ORDER BY		CARGOORGANIZACAOPESSOA.DT_INIVIG_CARGOORGPESSOA DESC]]>
	</queryString>
