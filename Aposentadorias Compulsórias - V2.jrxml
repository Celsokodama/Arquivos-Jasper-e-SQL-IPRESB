		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<queryString language="SQL">
		<![CDATA[USE aspprev2_baruerisp_prd


DECLARE @ANOATUAL INT
SET @ANOATUAL = YEAR(GETDATE())

DECLARE @MESATUAL INT
SET @MESATUAL = MONTH(GETDATE())

DECLARE @DIAATUAL INT
SET @DIAATUAL = DAY(GETDATE())

DECLARE @REFATUAL INT
SET @REFATUAL = CONCAT(@ANOATUAL,@MESATUAL)

DECLARE @DATAATUAL VARCHAR(10)
SET @DATAATUAL = DATEFROMPARTS(@ANOATUAL,@MESATUAL,@DIAATUAL)
--SET @DATAATUAL = DATEFROMPARTS(@ANOATUAL,@MESATUAL,31)


Select DISTINCT ---TOP 50

  --CONCAT(o.N_ORG_ORG,op.N_CODORI_ORGPESSOA) AS [NUMERO UNICO],
  --o.S_CNPJ_ORG As [CNPJ_ColE],
  (CASE o.N_ORG_ORG 
	
	WHEN 1 THEN 'PMB' 
	WHEN 2 THEN 'CMB' 
	WHEN 3 THEN 'FIEB'
	WHEN 4 THEN 'IPRESB' END) AS [ENTE],
  --o.S_DCR_ORG AS [ENTE],
  
  op.N_CODORI_ORGPESSOA As [MATRÍCULA],
  --p.S_CPF_PESSOA As [CPF],
  p.S_NOM_PESSOA as [NOME],
  c.S_DCR_CARGO As [CARGO ATUAL],
  Convert(VARCHAR,p.DT_NASC_PESSOA,103) As [NASCIMENTO],
  p.DT_NASC_PESSOA AS [NASC ORG],

	 (CASE 
        WHEN 
        MONTH(@DATAATUAL) > MONTH(DT_NASC_PESSOA) -- *1
        OR
        -- *2
        (
            MONTH(@DATAATUAL) = MONTH(DT_NASC_PESSOA) 
            AND DAY(@DATAATUAL) >= DAY(DT_NASC_PESSOA) 
        )
    THEN DATEDIFF(YEAR, DT_NASC_PESSOA, @DATAATUAL) 
    ELSE DATEDIFF(YEAR, DT_NASC_PESSOA, @DATAATUAL) -1 END) AS IDADE,

	CONVERT(VARCHAR,DATEADD(year, 75 ,DATEFROMPARTS(YEAR(p.DT_NASC_PESSOA),MONTH(p.DT_NASC_PESSOA),DAY(p.DT_NASC_PESSOA))),103) As [CUMPRIMENTO 75 ANOS]


	--  TIPO DE VÍNCULO
	--1 - Servidor Efetivo
	--2 - Servido Efetivo Ocupante de Cargo em Comissão
	--3 - Estável
	--4 - Outros
  --Case When cop.N_VINC_CARGOORGPESSOA = 2 Then 1 When cop.N_VINC_CARGOORGPESSOA = 4 Then 2 Else 4 End As [TIPO VÍNCULO],
	
	--Convert(VARCHAR,op.DT_ADM_ORGPESSOA,103) As [INGRESSO NO ENTE],

	--Convert(VARCHAR,op.DT_ADM_ORGPESSOA,103) As [INGRESSO NA CARREIRA],

	--Convert(VARCHAR,cop.DT_INIVIG_CARGOORGPESSOA,103) As [DATA INÍCIO CARGO ATUAL],


From PESSOA p
Inner Join ORGANIZACAOPESSOA op On p.N_PESSOA_PESSOA = op.N_PESSOA_PESSOA
Inner Join ORGANIZACAO o On o.N_ORG_ORG = op.N_ORG_ORG
Inner Join CARGOORGANIZACAOPESSOA cop On (cop.N_PESSOA_PESSOA = p.N_PESSOA_PESSOA) 
	And (cop.N_ORG_ORG = op.N_ORG_ORG) And (cop.N_CODORI_ORGPESSOA =  op.N_CODORI_ORGPESSOA) 
	And (cop.DT_INIVIG_CARGOORGPESSOA <= @DATAATUAL) 
	And (IsNull(cop.DT_FIMVIG_CARGOORGPESSOA, Convert(DATETIME,@DATAATUAL,102)) >=  Convert(DATETIME,@DATAATUAL,102))
Inner Join CARGO c On (c.N_ORG_ORG = cop.N_ORG_ORG) And (c.N_CARGO_CARGO = cop.N_CARGO_CARGO)
Left Join CARREIRA car On car.N_COD_CARREIRA = c.N_COD_CARREIRA
Inner Join PLANOORGANIZACAOPESSOA pop On (pop.N_ORG_ORG = op.N_ORG_ORG) And (pop.N_CODORI_ORGPESSOA = op.N_CODORI_ORGPESSOA)
Inner Join PLANO On PLANO.N_PLN_PLN = pop.N_PLN_PLN



Where  (PLANO.S_TIP_PLN In ('P', 'F')) And  (pop.DT_INIVIG_PLNORGPESSOA <= @DATAATUAL) 
  And (pop.DT_FIMVIG_PLNORGPESSOA >= @DATAATUAL Or pop.DT_FIMVIG_PLNORGPESSOA Is Null) 
  And (op.DT_DSL_ORGPESSOA Is Null Or op.DT_DSL_ORGPESSOA >= @DATAATUAL) 
  And (p.DT_FALEC_PESSOA Is Null Or p.DT_FALEC_PESSOA >= @DATAATUAL)
  --Definindo as aposentadorias compulsórias dos próximos 12 meses
  And DATEADD(year, 75 ,DATEFROMPARTS(YEAR(p.DT_NASC_PESSOA),MONTH(p.DT_NASC_PESSOA),DAY(p.DT_NASC_PESSOA))) <= DATEADD (Month, Datediff(Month, 0, DATEADD(m, 12, current_timestamp)), 0) 
  AND (cop.N_VINC_CARGOORGPESSOA = 2 OR cop.N_VINC_CARGOORGPESSOA = 4)

Order By p.DT_NASC_PESSOA ASC

]]>
	</queryString>
