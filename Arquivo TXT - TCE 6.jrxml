<!-- Created with Jaspersoft Studio version 6.12.2.final using JasperReports Library version 6.12.2-75c5e90a222ab406e416cbf590a5397028a52de3  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="teste3" pageWidth="350" pageHeight="420" columnWidth="350" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="10e901fa-5e86-47b7-b42c-c525b163fcad">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
	<property name="net.sf.jasperreports.print.create.bookmarks" value="false"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="net.sf.jasperreports.export.text.character.width" value="7.268"/>
	<property name="net.sf.jasperreports.export.text.character.height" value="15"/>
	<parameter name="TipoBenef" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="Registro" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[USE aspprev2_baruerisp_prd

DECLARE @TIPO_BENEF AS INT
--1 = APOSENTADORIA E 3 = PM
SET @TIPO_BENEF = $P{TipoBenef}

DECLARE @ANO_BENEF AS INT
SET @ANO_BENEF = $P{Ano}

DECLARE @REGISTRO_TCE AS VARCHAR(100)
SET @REGISTRO_TCE = $P{Registro}

SELECT DISTINCT CONCAT('1',';',@TIPO_BENEF,';',@REGISTRO_TCE) AS TXT

UNION
--TESTE UNIÃO DE TABELAS
--Portarias com benefícios
SELECT      DISTINCT '2' + ';' + (PESSOA.S_NOM_PESSOA COLLATE SQL_LATIN1_GENERAL_CP1251_CS_AS) AS TXT
			--+  CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) +';'
			--+';'+PESSOA.S_PISPASEP_PESSOA AS TXT

FROM            SERVICOPESSOA INNER JOIN
                         BENEFICIOPESSOA ON SERVICOPESSOA.N_PROT_SERVPESSOA = BENEFICIOPESSOA.N_PROT_SERVPESSOA INNER JOIN
                         TIPOREGRA ON BENEFICIOPESSOA.N_TIPREGRA_TIPREGRA = TIPOREGRA.N_TIPREGRA_TIPREGRA INNER JOIN
                         ASSENTAMENTOANEXOCONCESSAO ON BENEFICIOPESSOA.N_PROT_BNFPESSOA = ASSENTAMENTOANEXOCONCESSAO.N_PROT_BNFPESSOA INNER JOIN
                         TIPOATO ON ASSENTAMENTOANEXOCONCESSAO.N_TIPATO_TIPATO = TIPOATO.N_TIPATO_TIPATO INNER JOIN
                         PESSOA ON SERVICOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
WHERE        (ASSENTAMENTOANEXOCONCESSAO.N_ANOREF_ASSENTANEXOCONCES = @ANO_BENEF) AND
			 --AND (ASSENTAMENTOANEXOCONCESSAO.N_ATO_ASSENTANEXOCONCES >= 815) 
			 (CASE TIPOATO.S_DCR_TIPATO WHEN 'Ato concessório de pensão por morte' THEN '3' WHEN 'Ato concessório de aposentadoria' THEN '1' 
										WHEN 'Ato de Revisão de Aposentadoria' THEN '1' WHEN 'Ato de Revisão de Ap. Invalidez' THEN '1' ELSE '0' END) = @TIPO_BENEF 

UNION


--Portarias de Averabação e Revisão
SELECT     DISTINCT '2' + ';' + (PESSOA.S_NOM_PESSOA COLLATE SQL_LATIN1_GENERAL_CP1251_CS_AS) AS TXT
			--+  CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) +';'
			--+';'+PESSOA.S_PISPASEP_PESSOA AS TXT

FROM            PESSOA INNER JOIN
                         SERVICOPESSOA ON PESSOA.N_PESSOA_PESSOA = SERVICOPESSOA.N_PESSOA_PESSOA INNER JOIN
                         TIPOATO INNER JOIN
                         ASSENTAMENTOANEXOCONCESSAO ON TIPOATO.N_TIPATO_TIPATO = ASSENTAMENTOANEXOCONCESSAO.N_TIPATO_TIPATO ON 
                         SERVICOPESSOA.N_ORG_ORG = ASSENTAMENTOANEXOCONCESSAO.N_ORG_ORG AND SERVICOPESSOA.N_CODORI_ORGPESSOA = ASSENTAMENTOANEXOCONCESSAO.N_CODORI_ORGPESSOA
WHERE       (ASSENTAMENTOANEXOCONCESSAO.N_ANOREF_ASSENTANEXOCONCES = @ANO_BENEF) AND 
			--(ASSENTAMENTOANEXOCONCESSAO.N_ATO_ASSENTANEXOCONCES >= 815) AND 
                         (ASSENTAMENTOANEXOCONCESSAO.N_PROT_BNFPESSOA IS NULL) AND (ASSENTAMENTOANEXOCONCESSAO.DT_PUBL_ASSENTANEXOCONCES IS NOT NULL) AND 
                         SERVICOPESSOA.N_TIPSERV_TIPSERV  IN (10,8) AND
						 			 (CASE TIPOATO.S_DCR_TIPATO WHEN 'Ato concessório de pensão por morte' THEN '3' WHEN 'Ato concessório de aposentadoria' THEN '1' 
										WHEN 'Ato de Revisão de Aposentadoria' THEN '1' WHEN 'Ato de Revisão de Ap. Invalidez' THEN '1' ELSE '0' END) = @TIPO_BENEF]]>
	</queryString>
	<field name="TXT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="TXT"/>
	</field>
	<background>
		<band/>
	</background>
	<detail>
		<band height="15">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<textField>
				<reportElement x="0" y="0" width="350" height="15" uuid="1986d44c-9ebe-49a7-8256-07037c4b44b3"/>
				<box>
					<pen lineWidth="0.5" lineStyle="Solid"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{TXT}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band/>
	</columnFooter>
	<summary>
		<band/>
	</summary>
</jasperReport>
