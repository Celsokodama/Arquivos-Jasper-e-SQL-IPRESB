		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="Num" class="java.lang.String"/>
	<parameter name="Opcao" class="java.lang.String"/>
	<parameter name="Data" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @ano VARCHAR(100)
SET @ano = $P{Ano}

DECLARE @num VARCHAR(100)
SET @num = $P{Num}

DECLARE @opcao VARCHAR(100)
SET @opcao = $P{Opcao}

DECLARE @data VARCHAR(100)
SET @data = $P{Data}


Select 	@ano as [ANO],
		@num AS [NUMERO],
		@opcao as [OPCAO],
		@data as [DATA],
		(CASE @opcao WHEN 'C' THEN '- Certidão de Abono de Permanência nº ' + @num
					 WHEN 'P' THEN '- Portaria nº ' + @num + '/' + @ano
					 WHEN 'CTC' THEN '- CTC nº '+ @num + ' (Período de ' + @data+ ')'
					 WHEN 'AP' THEN '- Portaria nº ' + @num + '/' + @ano 
					 WHEN 'Outros' THEN '- '+ @data END) AS TEXTO]]>
	</queryString>
