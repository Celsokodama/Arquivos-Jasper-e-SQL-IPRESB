			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Protocolo" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<parameter name="InfAdic1" class="java.lang.String"/>
	<parameter name="InfAdic2" class="java.lang.String"/>
	<parameter name="InfAdic3" class="java.lang.String"/>
	<parameter name="Certid" class="java.lang.String"/>
	<parameter name="Ender" class="java.lang.String"/>
	<parameter name="CTPS" class="java.lang.String"/>
	<parameter name="PISPASEP" class="java.lang.String"/>
	<parameter name="ACCargo" class="java.lang.String"/>
	<parameter name="ACCargoO" class="java.lang.String"/>
	<parameter name="ACCargoC" class="java.lang.String"/>
	<parameter name="ACBenef" class="java.lang.String"/>
	<parameter name="ACBenefO" class="java.lang.String"/>
	<parameter name="ACBenefV" class="java.lang.String"/>
	<parameter name="Exigencia" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<parameter name="PInt" class="java.lang.String"/>
	<parameter name="ACBenefD" class="java.lang.String"/>
	<parameter name="tipodep" class="java.lang.String"/>
	<parameter name="tipoben" class="java.lang.String"/>
	<parameter name="ACBenef2" class="java.lang.String"/>
	<parameter name="ACBenefO2" class="java.lang.String"/>
	<parameter name="ACBenefV2" class="java.lang.String"/>
	<parameter name="ACBenefD2" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @PROT AS INTEGER
DECLARE @ANO AS INTEGER
DECLARE @ACUMULOCARGO AS VARCHAR(2)
DECLARE @ACUMULOCARGOORGAO AS VARCHAR(100)
DECLARE @ACUMULOCARGOCARGO AS VARCHAR(100)
DECLARE @ACUMULOBENEFICIOS AS VARCHAR(1)
DECLARE @ACUMULOBENEFICIOSORGAO AS VARCHAR(100)
DECLARE @ACUMULOBENEFICIOSVALOR AS VARCHAR(15)
DECLARE @ACUMULOBENEFICIOSDATA AS VARCHAR(15)
DECLARE @ACUMULOBENEFICIOS2 AS VARCHAR(1)

DECLARE @tipodep AS VARCHAR(30)
DECLARE @tipoben AS VARCHAR(2)
DECLARE @InfAdic2 AS VARCHAR(1000)
DECLARE @InfAdic3 AS VARCHAR(1000)
DECLARE @Certid AS VARCHAR(1)
DECLARE @Ender AS VARCHAR(1)
DECLARE @CTPS AS VARCHAR(1)
DECLARE @pis AS VARCHAR(1)
DECLARE @Exigencia AS VARCHAR(1)
DECLARE @MUsuario AS INT
DECLARE @InfAdic1 AS VARCHAR(1000)
DECLARE @DInt as VARCHAR(30)
DECLARE @PInt as VARCHAR(30)


DECLARE @TermoAbono AS VARCHAR(1)

SET @PROT = $P{Protocolo}
SET @ANO =  $P{Ano}
SET @ACUMULOCARGO =  $P{ACCargo}
SET @ACUMULOCARGOORGAO =  $P{ACCargoO}
SET @ACUMULOCARGOCARGO =  $P{ACCargoC}
SET @ACUMULOBENEFICIOS =  $P{ACBenef}
SET @ACUMULOBENEFICIOSORGAO =  $P{ACBenefO}
SET @ACUMULOBENEFICIOSVALOR =  $P{ACBenefV}
SET @ACUMULOBENEFICIOSDATA =  $P{ACBenefD}
SET @ACUMULOBENEFICIOS2 =  $P{ACBenef2}

SET @tipodep = $P{tipodep}
SET @tipoben = $P{tipoben}
SET @InfAdic2 = $P{InfAdic2}
SET @InfAdic3 = $P{InfAdic3}
SET @Certid = $P{Certid}
SET @Ender = $P{Ender}
SET @CTPS = $P{CTPS}
SET @pis = $P{PISPASEP}
SET @Exigencia = $P{Exigencia}
SET @MUsuario = $P{MUsuario}
SET @InfAdic1 = $P{InfAdic1}
SET @DInt = $P{DInt}
SET @PInt = $P{PInt}

--SET @PROT = 679
--SET @ANO =  2026
--SET @ACUMULOCARGO =  ''
--SET @ACUMULOCARGOORGAO =  ''
--SET @ACUMULOCARGOCARGO =  ''
--SET @ACUMULOBENEFICIOS =  'S'
--SET @ACUMULOBENEFICIOSORGAO =  'INSS'
--SET @ACUMULOBENEFICIOSVALOR =  '2.300,00'
--SET @ACUMULOBENEFICIOSDATA =  '01/05/2020'
--SET @ACUMULOBENEFICIOS2 = 'S'
--SET @TermoAbono = ''
--SET @tipodep = 'CONJUGE'
--SET @tipoben = 'P'
--SET @InfAdic2 = ''
--SET @InfAdic3 = ''
--SET @Certid = ''
--SET @Ender = ''
--SET @CTPS = ''
--SET @pis = ''
--SET @Exigencia = ''
--SET @MUsuario = 96
--SET @InfAdic1 = ''
--SET @DInt = ''
--SET @PInt = ''




SELECT TOP 1

--PROTOCOLO DO PROCESSO
				(CASE	WHEN CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) <=2018 
						THEN 'BI-'+ CONVERT(VarChar(5), SP.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) 
						ELSE 'PA-'+ CONVERT(VarChar(5), SP.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) 
						END) AS NOMEPROT,

						FORMAT(SP.DT_SLCT_SERVPESSOA,'dd/MM/yyyy') AS DATA_SOLICITAÇAO,

						(CASE SP.S_TIPRESP_SERVPESSOA
						WHEN 'S' THEN 'Solicitante'
						WHEN 'O' THEN 'Outro(a)'
						WHEN 'P' THEN 'Procurador(a)'
						END ) AS TIPOSOLICITANTE,

						(CASE SP.S_TIPRESP_SERVPESSOA
						WHEN 'S' THEN  (P.S_NOM_PESSOA)
						WHEN 'O' THEN (P2.S_NOM_PESSOA)
						WHEN 'P' THEN SP.S_NOMRESP_SERVPESSOA
						END ) AS [NOME SOLICITANTE],

						(CASE WHEN P2.S_NOM_PESSOA = 'MARCELO RODRIGUES LARANGEIRA'  THEN 'O'
						WHEN P2.S_NOM_PESSOA = 'ELIANA VERISSIMO DOS SANTOS FARIAS' THEN 'O'
						WHEN P2.S_NOM_PESSOA = 'SERGIO DE OLIVEIRA' THEN 'O'
						ELSE 'P' END) AS [OFICIO OU PEDIDO],



						--(CASE SP.S_NOMRESP_SERVPESSOA
						--WHEN NULL THEN  P2.S_NOM_PESSOA 
						--ELSE SP.S_NOMRESP_SERVPESSOA
						--END) AS [NOME SOLICITANTE],

SP.S_DCR_SERVPESSOA AS [SÚMULA],
P.S_NOM_PESSOA AS [NOMESERVIDOR],
P.S_RG_PESSOA AS [RG],
LOWER(P.S_EMAIL_PESSOA) AS [EMAIL],
			(CASE P.S_SEXO_PESSOA WHEN 'M' THEN  (CASE  P.S_ESTCIVIL_PESSOA 
			WHEN 'S' THEN 'Solteiro'
			WHEN 'C' THEN 'Casado'
			WHEN 'V' THEN 'Viúvo'
			WHEN 'U' THEN 'União Estável'
			WHEN 'D' THEN 'Divorciado'
			WHEN 'P' THEN 'Separado'
			END )
			WHEN 'F' THEN  (CASE  P.S_ESTCIVIL_PESSOA 
			WHEN 'S' THEN 'Solteira'
			WHEN 'C' THEN 'Casada'
			WHEN 'V' THEN 'Viúva'
			WHEN 'U' THEN 'União Estável'
			WHEN 'D' THEN 'Divorciada'
			WHEN 'P' THEN 'Separada'
			END )
			END) AS [ESTADO CIVIL],

			--ENDEREÇO
				CASE H.N_TIPLOGRAD_HISTENDPESSOA	WHEN 4 THEN 'Alameda'  
												WHEN 8 THEN 'Av.' 
												WHEN 31 THEN 'Estrada' 
												WHEN 65 THEN 'Praça' 
												WHEN 77 THEN 'Quadra' 
												WHEN 81 THEN 'Rua' 
												WHEN 90 THEN 'Rodovia' 
												WHEN 100 THEN 'Travessa' 
												WHEN 101 THEN 'Via'
												WHEN 104 THEN 'Vila' 
												END 
				+' '
				+(RTRIM(ISNULL(H.S_DCRRUA_HISTENDPESSOA, '')
				+CASE	WHEN H.S_NUMLOGRAD_HISTENDPESSOA IS NULL 
						THEN ''  
						ELSE ', ' +RTRIM(H.S_NUMLOGRAD_HISTENDPESSOA) END
				+CASE	WHEN H.S_DCRBAIRRO_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE +', '+RTRIM(H.S_DCRBAIRRO_HISTENDPESSOA) END
				+CASE	WHEN H.S_DCRCOMPL_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE ', '+RTRIM(H.S_DCRCOMPL_HISTENDPESSOA) END
				+CASE	WHEN H.S_DCRMUN_HISTENDPESSOA IS NULL 
						THEN '' 
						ELSE ', '+RTRIM(H.S_DCRMUN_HISTENDPESSOA) END))
				+', '+RTRIM(ISNULL(H.S_DCRUF_HISTENDPESSOA, ''))
				+', CEP: '
				+RTRIM(ISNULL(substring(H.S_CEP_HISTENDPESSOA, 1,2)
				+ '.' 
				+ substring(H.S_CEP_HISTENDPESSOA,3,3) 
				+ '-' 
				+ substring(H.S_CEP_HISTENDPESSOA, 6, 9), '')
				) as ENDERECO,

CONVERT(VARCHAR, P.DT_NASC_PESSOA, 103) AS NASCIMENTO,
--CPF
				RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF,
				
				--PISPASEP
				RTRIM(SUBSTRING(P.S_PISPASEP_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_PISPASEP_PESSOA,4,5)
				+'.'
				+SUBSTRING(P.S_PISPASEP_PESSOA,9,2)
				+'-'
				+SUBSTRING(P.S_PISPASEP_PESSOA,11,1)) AS NIT,

SP.N_CODORI_ORGPESSOA AS [MATRÍCULA],

		CARGO.S_DCR_CARGO AS CARGO,
		CONVERT(VARCHAR, OP.DT_ADM_ORGPESSOA, 103)  AS [DATA DE INGRESSO],

			(CASE SP.N_ORG_ORG 
			WHEN 1 THEN 'Prefeitura Municipal de Barueri'
			WHEN 2 THEN 'Câmara Municipal de Barueri'
			WHEN 3 THEN 'FIEB'
			WHEN 4 THEN 'IPRESB'
			END)AS [ENTE],

			(TIPOSERVICO.S_DCRSERV_TIPSERV) AS [TIPO SOLICITAÇÃO],
			TIPOSERVICO.N_TIPSERV_TIPSERV AS [N_TIPO_SERVICO],

				( P2.S_NOM_PESSOA) AS NOME_DEP,
				RTRIM(SUBSTRING(P2.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P2.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P2.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P2.S_CPF_PESSOA,10,2)) AS CPF_DEP,
				P2.S_RG_PESSOA AS RG_DEP,


			
			


			(SELECT TOP 1  (CASE TP1.N_NUM_TELPESSOA WHEN NULL THEN '---' 
							ELSE('('+ CONVERT(VARCHAR(2),TP1.N_DDD_TELPESSOA)+') '  + CONVERT(VARCHAR(10),TP1.N_NUM_TELPESSOA) 
						)END)
			FROM TELEFONEPESSOA TP1
			WHERE TP1.S_TIP_TELPESSOA = 'E' AND TP1.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA) AS CELULAR,

			(SELECT TOP 1 (CASE TP2.N_NUM_TELPESSOA WHEN NULL THEN '---' 
							ELSE('('+ CONVERT(VARCHAR(2),TP2.N_DDD_TELPESSOA)+') '  + CONVERT(VARCHAR(10),TP2.N_NUM_TELPESSOA) 
						)END)
			FROM TELEFONEPESSOA TP2
			WHERE TP2.S_TIP_TELPESSOA = 'R' AND TP2.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA) AS RESIDENCIAL,

			(SELECT TOP 1  (CASE TP3.N_NUM_TELPESSOA WHEN NULL THEN '---' 
							ELSE('('+ CONVERT(VARCHAR(2),TP3.N_DDD_TELPESSOA)+') '  + CONVERT(VARCHAR(10),TP3.N_NUM_TELPESSOA) 
						)END)
			FROM TELEFONEPESSOA TP3
			WHERE TP3.S_TIP_TELPESSOA = 'D' AND TP3.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA) AS RECADO,
			
			-- texto aposentadoria e abono
			(CASE WHEN SP.N_TIPSERV_TIPSERV = 6 THEN 'Abono de Permanência'
				ELSE 'Aposentadoria' end) APOSEABONO,


			-- TEXTOS
			 @ACUMULOCARGO AS ACUMULOCARGO, 
				(CASE @ACUMULOCARGO  
			WHEN UPPER('S') THEN 'Acumulo o cargo público, função ou emprego ou recebo proventos(aposentadoria) do serviço público: '
			ELSE  'Não exerço qualquer outro cargo público e nem estou aposentado(a) pelo serviço público, seja na esfera Federal, Estadual ou Municipal. <br>'
			END) AS ACUMULOCARGO2, 
			(CASE @ACUMULOCARGO
				WHEN UPPER('S') THEN 'Órgão: ' + @ACUMULOCARGOORGAO + ' - '   
				ELSE ''
			END) AS ACCargoO,
				(CASE @ACUMULOCARGO
				WHEN UPPER('S') THEN 	'Cargo: ' + @ACUMULOCARGOCARGO
				ELSE ''
			END) AS ACCargoC,
			
			
			
			(CASE @ACUMULOBENEFICIOS 
				when 'S' THEN (CASE WHEN SP.N_TIPSERV_TIPSERV IN(9,32,41,42,43,57,66,91,99,100) 

								--APOSENTADORIA
								 THEN 'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:'
							
								--PENSÃO POR MORTE
								WHEN SP.N_TIPSERV_TIPSERV = 21 THEN 'Recebo aposentadoria ou pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;'	
								END)
					--Órgão:_____________________	Valor:________________________<br>Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
					ELSE (CASE WHEN SP.N_TIPSERV_TIPSERV IN (9,32,41,42,43,57,66,91,99,100) THEN
							 '<b>Não recebo pensão por morte</b> do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;'
						

							--PENSÃO POR MORTE
							WHEN SP.N_TIPSERV_TIPSERV = 21 THEN '<b>Não recebo aposentadoria nem pensão por morte</b> do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;'
							END)
			
			
				END) AS ACBenef,
				@ACUMULOBENEFICIOS AS ACUMULOBENEF2, 
				(case WHEN SP.N_TIPSERV_TIPSERV  IN (9,32,41,42,43,57,66) THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN SP.N_TIPSERV_TIPSERV = 21 THEN 'Declaro ainda, caso venha a receber pensão por morte ou aposentadoria de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				END) AS TEXTO2,
				
					
			--(CASE @ACUMULOBENEFICIOS 
			--	when 'S' THEN '<b>Órgão:</b> ' + @ACUMULOBENEFICIOSORGAO 
			--	ELSE ''
			--END) AS ACBenefO,
			--	(CASE @ACUMULOBENEFICIOS 
			--	when 'S' THEN '<b>Valor </b>: R$ ' + @ACUMULOBENEFICIOSVALOR 
			--	ELSE ''
			--END) AS ACBenefV,
			--	(CASE @ACUMULOBENEFICIOS 
			--	when 'S' THEN '<b>Data de início do benefício:</b> ' + @ACUMULOBENEFICIOSDATA
			--	ELSE ''
			--END) AS ACBenefD,

				
			--	(CASE @ACUMULOBENEFICIOS2  
			--		WHEN 'S'
			--		THEN '<b>Tipo do benefício:</b> '  + (CASE @tipoben WHEN 'A' THEN 'Aposentadoria' 
			--															  WHEN 'P' THEN 'Pensão por morte' END) 
			--		ELSE ''		
			--	END)

			--	 AS ACBenefT,

				 (CASE @ACUMULOBENEFICIOS 
				when 'S' THEN '<b>Órgão:</b> ' + @ACUMULOBENEFICIOSORGAO + '<BR><b>Valor </b>: R$ ' + @ACUMULOBENEFICIOSVALOR + '<BR><b>Data de início do benefício:</b> ' + @ACUMULOBENEFICIOSDATA + '<BR><b>Tipo do benefício:</b> '  + (CASE upper(@tipoben) WHEN 'A' THEN 'Aposentadoria' WHEN 'P' THEN 'Pensão por morte' ELSE '' END) +'<BR>'+ (CASE upper(@tipoben) WHEN 'P' THEN '<b>Parentesco com o instituidor da pensão por morte</b>: ' + @tipodep ELSE '' END) + '<BR>'
				ELSE ''
				END) AS ACBenefO,
							
			


			-- ACUMULO DE BENEFICIOS 2
				(CASE @ACUMULOBENEFICIOS2
				when 'S' THEN (CASE WHEN SP.N_TIPSERV_TIPSERV IN (9,32,41,42,43,57,66,91,99,100) THEN

								--APOSENTADORIA
								'Recebo pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares:'			

								--PENSÃO POR MORTE
								WHEN SP.N_TIPSERV_TIPSERV = 21 THEN 'Recebo aposentadoria ou pensão por morte do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;'	
								END)


					--Órgão:_____________________	Valor:________________________<br>Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
					ELSE (CASE WHEN SP.N_TIPSERV_TIPSERV IN (9,32,41,42,43,57,66,91,99,100) THEN  '<b>Não recebo pensão por morte</b> do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;'
						
							--PENSÃO POR MORTE
							WHEN SP.N_TIPSERV_TIPSERV = 21 THEN '<b>Não recebo aposentadoria nem pensão por morte</b> do Regime Geral de Previdência Social (RGPS-INSS), de Regime Próprio de Previdência Social (RPPS) ou decorrentes de atividades militares;'
							END)
			
			
				END) AS ACBenef2,
				@ACUMULOBENEFICIOS AS ACUMULOBENEF4, 
				(case WHEN SP.N_TIPSERV_TIPSERV IN (9,32,41,42,43,57,66) THEN 'Declaro ainda, caso venha a receber pensão por morte de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				WHEN  SP.N_TIPSERV_TIPSERV = 21 THEN 'Declaro ainda, caso venha a receber pensão por morte ou aposentadoria de outro Regime de Previdência devo comunicar a este Instituto e que tomei conhecimento do trecho da Emenda Constitucional n.º 103/2019 abaixo transcrito e que estou ciente de que estarei sujeito às penalidades previstas em Lei, caso venha a incorrer em acumulação ilegal de benefícios.'
				END) AS TEXTO4,
				
	


			-- DECLARAÇÃO DE ACÚMULO TEXTO PARA PENSÃO TIPSERV=21 OU APOSENTADORIA
			(CASE WHEN SP.N_TIPSERV_TIPSERV = 21 THEN (DEP.S_NOM_PESSOA)
			ELSE (P.S_NOM_PESSOA) END) AS NOME_DECL,
			(CASE WHEN SP.N_TIPSERV_TIPSERV = 21 THEN 	
				RTRIM(SUBSTRING(P2.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P2.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P2.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P2.S_CPF_PESSOA,10,2)) 
			ELSE 	
			RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) END) AS CPF_DECL,
			(CASE WHEN SP.N_TIPSERV_TIPSERV = 21 THEN DEP.S_RG_PESSOA
			ELSE P.S_RG_PESSOA END) AS RG_DECL,
			
			--UPPER(@TermoAbono) AS TermoAbono,
			
			-- EXIGÊNCIA
			UPPER(@Exigencia) AS Exigencia,
			@MUsuario AS MATRICULA_USUARIO_IPRESB,
			 
			(CASE WHEN  BP.S_SITPGTO_BNFPESSOA IN (1,2,4) AND BP.N_TIPBNF_TIPBNF IN (1,2,3,4,5,6,14,17,1009)
			THEN 'S'
			ELSE 'N'
			END) AS [APOSENTADO?],


                             (SELECT        (PESSOA_3.S_NOM_PESSOA)

                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS USUARIO,

                             (SELECT        (CARGO_3.S_DCR_CARGO)
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS CARGO_USUARIO,
                               
                             

				(CASE UPPER(@Certid) WHEN 'S' THEN 'Certidão de nascimento ou casamento atualizada' ELSE null END) AS CERTIDAO,
				(CASE UPPER(@Ender) WHEN 'S' THEN 'Comprovante de endereço atual' ELSE null END) AS ENDERECO2,
				(CASE UPPER(@CTPS) WHEN 'S' THEN 'Carteira de Trabalho com registro de professor' ELSE null END) AS CTPS,
				(CASE UPPER(@pis) WHEN 'S' THEN 'Inscrição do segurado no PIS/PASEP - cartão ou extrato (original ou cópia autenticada)' ELSE null END) AS PISPASEP,
				(CASE @InfAdic1 WHEN '' THEN null ELSE @InfAdic1 END) AS InfAdic1,
				(CASE @InfAdic2 WHEN '' THEN null ELSE @InfAdic2 END) AS InfAdic2,
				(CASE @InfAdic3 WHEN '' THEN null ELSE @InfAdic3 END) AS InfAdic3,

				

				-- A.N_TIPATO_TIPATO = 22 = RECEBE ABONO CADASTRADO NO ASSSENTAMENTOS
				(CASE WHEN A.N_TIPATO_TIPATO = 22
				THEN 'N'
				ELSE    (CASE WHEN SP.N_TIPSERV_TIPSERV = 57 THEN 'S'
							  WHEN SP.N_TIPSERV_TIPSERV = 42 THEN (CASE WHEN SPBP1.N_SEQ_REGRAETPBNFPLN = 1	THEN 'S' 
																	ELSE 'N' END) 
						ELSE 'N' END)  
						
				END)		AS  TermoAbono
			
			
			



FROM 

SERVICOPESSOA SP INNER JOIN PESSOA P ON SP.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA 
INNER JOIN TIPOSERVICO ON SP.N_TIPSERV_TIPSERV = TIPOSERVICO.N_TIPSERV_TIPSERV
LEFT JOIN HISTORICOENDERECOPESSOA H ON P.N_PESSOA_PESSOA = H.N_PESSOA_PESSOA 
LEFT JOIN PESSOA P2 ON SP.N_PESSOA_RESP = P2.N_PESSOA_PESSOA
LEFT JOIN RELACAOPESSOA RP1 ON P.N_PESSOA_PESSOA = RP1.N_PESSOA_PESSOA AND RP1.N_GRAUPARENT_GRAUPARENT IN (1,2) AND RP1.DT_FIMVIG_RELACPESSOA IS NULL
LEFT JOIN PESSOA DEP ON DEP.N_PESSOA_PESSOA = RP1.N_PESSOARELAC_PESSOA
LEFT JOIN CARGOORGANIZACAOPESSOA COP ON SP.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND SP.N_ORG_ORG = COP.N_ORG_ORG
LEFT JOIN ORGANIZACAOPESSOA OP ON SP.N_CODORI_ORGPESSOA = OP.N_CODORI_ORGPESSOA AND SP.N_ORG_ORG = OP.N_ORG_ORG
LEFT JOIN CARGO ON COP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND COP.N_ORG_ORG = CARGO.N_ORG_ORG
LEFT JOIN ASSENTAMENTOANEXOCONCESSAO A ON A.N_ORG_ORG = SP.N_ORG_ORG AND A.N_CODORI_ORGPESSOA = SP.N_CODORI_ORGPESSOA AND A.N_TIPATO_TIPATO = 22 
LEFT JOIN BENEFICIOPESSOA BP ON SP.N_CODORI_ORGPESSOA = BP.N_CODORI_ORGPESSOA AND SP.N_ORG_ORG = BP.N_ORG_ORG

-- SPBP.N_SEQ_REGRAETPBNFPLN = 1 = ART 40 a
LEFT JOIN SIMULACAOPLANOBENEFICIOPESSOA SPBP1 ON SPBP1.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA 		AND  SPBP1.N_SEQ_SIMULBNFEPFPESSOA = (SELECT	max(SPBP01.N_SEQ_SIMULBNFEPFPESSOA)
																																	 FROM	SIMULACAOPLANOBENEFICIOPESSOA SPBP01
																																	 WHERE	SPBP01.N_PESSOA_PESSOA = SPBP1.N_PESSOA_PESSOA)  AND SPBP1.N_SEQ_REGRAETPBNFPLN = 1 AND SPBP1.DT_DIREITOBNF_SPLNBNFPES <= DATEADD (day, Datediff(day, 0, DATEADD(d, 1, current_timestamp)), 0)

---- SPBP.N_SEQ_REGRAETPBNFPLN = 1 = ART 6

--LEFT JOIN SIMULACAOPLANOBENEFICIOPESSOA SPBP2 ON SPBP2.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA 		AND  SPBP2.N_SEQ_SIMULBNFEPFPESSOA = (SELECT	max(SPBP02.N_SEQ_SIMULBNFEPFPESSOA)
--																																	 --FROM	SIMULACAOPLANOBENEFICIOPESSOA SPBP02
--																																	 --WHERE	SPBP2.N_PESSOA_PESSOA = SPBP02.N_PESSOA_PESSOA)  AND SPBP2.N_SEQ_REGRAETPBNFPLN = 3


-----****      SPBP N_SEQ_REGRAETPBNFPLN = 4 ENTÃO É ART 3º    ****-----

LEFT JOIN SIMULACAOPLANOBENEFICIOPESSOA SPBP3 ON SPBP3.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA 		AND  SPBP3.N_SEQ_SIMULBNFEPFPESSOA = (SELECT	max(SPBP03.N_SEQ_SIMULBNFEPFPESSOA)
																																	 FROM	SIMULACAOPLANOBENEFICIOPESSOA SPBP03
																																	 WHERE	SPBP3.N_PESSOA_PESSOA = SPBP03.N_PESSOA_PESSOA)  AND SPBP3.N_SEQ_REGRAETPBNFPLN = 4 AND SPBP3.DT_DIREITOBNF_SPLNBNFPES <= DATEADD (day, Datediff(day, 0, DATEADD(d, -2, current_timestamp)), 0)






WHERE SP.N_NUMPROT_SERVPESSOA = @PROT AND SP.N_ANOREFER_SERVPESSOA = @ANO AND H.DT_FIMVIG_HISTENDPESSOA IS NULL AND
SP.N_TIPSERV_TIPSERV IN (6,7,8,9,10,21,32,41,42,43,57,58,59,60,64,66,91,99,100)]]>
	</queryString>
	<field name="NOMEPROT" class="java.lang.String">
