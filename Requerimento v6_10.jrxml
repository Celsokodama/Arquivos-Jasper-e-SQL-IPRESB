		</band>
		<band height="621">
			<printWhenExpression><![CDATA[$F{TermoAbono}.equals("S") && !( $F{N_TIPO_SERVICO}.equals("6") || $F{N_TIPO_SERVICO}.equals("7")  ||  $F{N_TIPO_SERVICO}.equals("8")  ||  $F{N_TIPO_SERVICO}.equals("10")  ||  $F{N_TIPO_SERVICO}.equals("58")  ||  $F{N_TIPO_SERVICO}.equals("59")   ||  $F{N_TIPO_SERVICO}.equals("60")  ||  $F{N_TIPO_SERVICO}.equals("63")  ||  $F{N_TIPO_SERVICO}.equals("64")   || $F{OFICIO OU PEDIDO}.equals("O"))]]></printWhenExpression>
			<staticText>
				<reportElement x="-43" y="59" width="509" height="20" uuid="596d29d5-e15b-4b34-8a1b-0e6e2efc2478">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
				</reportElement>
				<textElement textAlignment="Center" markup="styled">
					<font fontName="Arial" size="12" isUnderline="true"/>
				</textElement>
				<text><![CDATA[<style isBold='true'>TERMO DE DECLARAÇÃO </style>]]></text>
			</staticText>
			<textField>
				<reportElement x="-1" y="114" width="453" height="206" uuid="0b5ccd72-b6da-4451-b715-5795e77da5f1"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="Arial" size="12"/>
					<paragraph lineSpacingSize="1.5" firstLineIndent="56"/>
				</textElement>
				<textFieldExpression><![CDATA["                 "+ "Pelo presente termo, "  + "<b>" +$F{NOMESERVIDOR}+"</b>"  +", " + "Matrícula " + $F{MATRÍCULA}+", "+ "servidor(a) efetivo(a) da " + $F{ENTE} +", " + " no cargo de " +$F{CARGO}+", "+ " declara ter ciência de que cumpre os requisitos para aposentadoria por tempo de contribuição e idade pela regra permanente prevista na Constituição Federal, em seu art. 40, §1º, inciso III, alínea “a”*,  fazendo jus, por conseguinte, à percepção do Abono Permanência de que trata o §19* do citado artigo."+ "<br><br>" +
"                 "+"Outrossim, tendo optado pela aposentadoria em face do desinteresse em continuar em atividade, tem, ainda, ciência de que não será possível a concessão do Abono de Permanência pelo ente ao qual está vinculado, circunstância que obsta a emissão de Certidão para esse fim por parte do Instituto de Previdência Social dos Servidores Municipais de Barueri – IPRESB."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-1" y="560" width="453" height="61" uuid="1a1f04da-6728-45b5-ae9d-7b15a72bde8f"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" isItalic="true"/>
					<paragraph firstLineIndent="28" leftIndent="2" rightIndent="2"/>
				</textElement>
				<textFieldExpression><![CDATA["*Norma mantida por força do disposto no §7º do Art. 10 da Emenda Constitucional nº 103, de 12 de novembro de 2019 e conforme previsto nos Artigos 35, 36 e 231 da Lei Complementar nº 434 de 14 de agosto de 2018."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="171" y="424" width="248" height="38" uuid="482a09af-bf63-4f20-ada7-f1fe888c8727"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{NOME SOLICITANTE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="121" y="363" width="350" height="30" uuid="5c7d31ac-2d18-46e9-929d-002d6e6495e5"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="11" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
		</band>
		<band height="686">
			<printWhenExpression><![CDATA[$F{Exigencia}.equals("S")]]></printWhenExpression>
			<textField>
				<reportElement x="0" y="134" width="470" height="24" uuid="7312bd1c-ce1d-4fad-95df-09856329a122"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Processo: </style>" + $F{NOMEPROT}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="86" width="470" height="24" uuid="e35183f1-7153-4c79-b180-5c3608cc643c"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Nome: " +"</style>"+$F{NOME SOLICITANTE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="158" width="470" height="24" uuid="8ab87f49-0f37-48f7-be54-75054937683f"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Assunto: "+"</style>"+$F{TIPO SOLICITAÇÃO}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="188" width="470" height="24" uuid="4eddda9e-69d5-4a17-ad14-9cd414e9cf84"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Ref.: Cumprimento de exigências"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="233" width="450" height="39" uuid="ed4517a7-15cd-4315-a84e-6f38147aa211"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Para dar andamento ao processo em referência, conforme Art. 28 da Res. 40 /2019, solicitamos a apresentação dos documentos abaixo:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="304" width="458" height="325" uuid="3ebe5de9-ed11-49f8-bf40-4ce5cf723c5f">
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="cm"/>
					<property name="com.jaspersoft.studio.unit.spacingBefore" value="cm"/>
				</reportElement>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.6" firstLineIndent="0" leftIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{PISPASEP} !=null ? ("\u2022   " +$F{PISPASEP} + "<br/>"): "")+($F{CERTIDAO} !=null ? ("\u2022   " +$F{CERTIDAO} + "<br/>"): "")+($F{ENDERECO2} !=null ? ("\u2022   " +$F{ENDERECO2} + "<br/>"): "")+($F{CTPS} !=null ? ("\u2022   " +$F{CTPS} + "<br/>"): "")+($F{InfAdic1} !=null ? ("\u2022   " +$F{InfAdic1} + "<br/>"):"")  +($F{InfAdic2} !=null ? ("\u2022   " +$F{InfAdic2} + "<br/>"):"") + ($F{InfAdic3} !=null ? ("\u2022   " +$F{InfAdic3} + "<br/>"):"") +"<br/><br/>Caso os documentos não sejam apresentados no prazo de <style isBold='true' isUnderline='true'>"+" 60 (sessenta) dias a contar da presente data" +"</style>"+" , prorrogável uma única vez por igual período, o processo será indeferido e arquivado definitivamente conforme o disposto no art. 96 da Resolução nº 40, de 02 de agosto de 2019 (Regulamento do RPPS).<br/><br/>Atenciosamente.<br/><br/><style isBold='true'>"+$F{USUARIO}+"<br/>Matrícula n.º "+$F{MATRICULA_USUARIO_IPRESB}+"</style>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="55" width="470" height="24" uuid="be8bbfc9-4e08-4139-8e24-c84bf9db629e"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Sr.(a) Requerente:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="110" width="470" height="24" uuid="6be7e0f7-85d7-4401-8262-64578df3fd15"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Matrícula: "+"</style>"+$F{MATRÍCULA}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="173" y="656" width="248" height="28" uuid="138bfb28-5622-4a55-b8e3-b9e8c9559ffd"/>
