	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="DTINI" class="java.lang.String"/>
	<parameter name="DTFIM" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[set language portuguese


DECLARE @DTINI  DATE
SET @DTINI =  $P{DTINI}


DECLARE @DTFIM  DATE
SET @DTFIM =   $P{DTFIM}






SELECT 

		P.S_NOM_PESSOA AS [Servidor],
		BP.N_CODORI_ORGPESSOA AS [Matricula],
		(CASE BP.N_ORG_ORG WHEN 1 THEN 'PMB' 
             WHEN 2 THEN 'CÂMARA' 
             WHEN 3 THEN 'FIEB' 
             WHEN 4 THEN 'IPRESB' 
		END) AS ENTE,
		
				CARGO.S_DCR_CARGO AS CARGO,

		
				RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF,
				
				(CASE BP.N_TIPBNF_TIPBNF
				WHEN 1 THEN 'Aposentadoria'
				WHEN 2  THEN 'Aposentadoria'
				WHEN 3  THEN 'Aposentadoria'
				WHEN 4  THEN 'Aposentadoria'
				WHEN 5  THEN 'Aposentadoria'
				WHEN 6  THEN 'Aposentadoria'
				WHEN 14  THEN 'Aposentadoria'
				WHEN 17 THEN 'Aposentadoria'
				WHEN 107  THEN 'Aposentadoria'
				when 1009 THEN 'Aposentadoria'
				End) AS [Tipo Benefício],
		P.DT_NASC_PESSOA AS [DataNascimento],
		CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) AS [DIB],
		
		CONVERT(VARCHAR,BP.DT_REQTO_BNFPESSOA,103) AS [DATA PORTARIA],
		BP.DT_REQTO_BNFPESSOA AS DATAORDEM,
		
		CONVERT(VARCHAR,@DTINI,103) AS DTINI,
		CONVERT(VARCHAR,@DTFIM,103) AS DTFIM

		

			
				

		




FROM
	
			
			PESSOA P
			INNER JOIN BENEFICIOPESSOA  BP ON P.N_PESSOA_PESSOA = BP.N_PESSOA_PESSOA
			FULL OUTER JOIN CARGO ON BP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND BP.N_ORG_ORG = CARGO.N_ORG_ORG
			INNER JOIN TIPOBENEFICIO ON TIPOBENEFICIO.N_TIPBNF_TIPBNF = BP.N_TIPBNF_TIPBNF
			
						

WHERE

		BP.N_TIPBNF_TIPBNF IN (1,2,3,4,5,6,14,17,107,1009) AND
		BP.S_SITPGTO_BNFPESSOA = 1 
		AND BP.N_ORG_ORG = 1
		AND  BP.DT_DIB_BNFPESSOA >= CONVERT(VARCHAR,@DTINI,103)
		AND  BP.DT_DIB_BNFPESSOA  <= CONVERT(VARCHAR,@DTFIM,103)



UNION   





select 

				P.S_NOM_PESSOA AS [Servidor],
				BP.N_CODORI_ORGPESSOA AS [Matricula],
				(CASE BP.N_ORG_ORG WHEN 1 THEN 'PMB' 
							 WHEN 2 THEN 'CÂMARA' 
							 WHEN 3 THEN 'FIEB' 
							 WHEN 4 THEN 'IPRESB' 
						END) AS ENTE,
						
				CARGO.S_DCR_CARGO AS CARGO,

				RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF,
				
				(CASE BP.N_TIPBNF_TIPBNF
				WHEN 19 THEN 'Pensão por Morte - Ativo'
				WHEN 20 THEN 'Pensão por Morte - Aposentado'
				End) AS [Tipo Benefício],
				
				P.DT_NASC_PESSOA AS [DataNascimento],
				CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) AS [DIB],
		
				CONVERT(VARCHAR,BP.DT_REQTO_BNFPESSOA,103) AS [DATA PORTARIA],
				BP.DT_REQTO_BNFPESSOA AS DATAORDEM,
				
		CONVERT(VARCHAR,@DTINI,103) AS DTINI,
		CONVERT(VARCHAR,@DTFIM,103) AS DTFIM
		



from beneficiopessoa BP INNER JOIN PESSOA P ON P.N_PESSOA_PESSOA = BP.N_PESSOA_PESSOA

FULL OUTER JOIN CARGO ON CARGO.N_CARGO_CARGO = BP.N_CARGO_CARGO AND CARGO.N_ORG_ORG = BP.N_ORG_ORG

where BP.N_TIPBNF_TIPBNF IN (19,20) 
		AND  BP.DT_REG_BNFPESSOA >= CONVERT(VARCHAR,@DTINI,103)
		AND  BP.DT_REG_BNFPESSOA  <= CONVERT(VARCHAR,@DTFIM,103)
		AND BP.N_ORG_ORG = 1


ORDER BY  [Tipo Benefício],	BP.DT_REQTO_BNFPESSOA, P.S_NOM_PESSOA]]>
	</queryString>
