		<property name="com.jaspersoft.studio.field.label" value="MATRÍCULA"/>
	</field>
	<field name="ENTE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ENTE"/>
		<property name="com.jaspersoft.studio.field.label" value="ENTE"/>
	</field>
	<field name="CARGO" class="java.lang.String">
