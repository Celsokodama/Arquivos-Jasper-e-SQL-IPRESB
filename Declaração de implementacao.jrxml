<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="454" leftMargin="85" rightMargin="56" topMargin="14" bottomMargin="0" isFloatColumnFooter="true" uuid="d946ebe6-2e92-44c5-aed7-8f7380925278">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ASPPREV"/>
	<property name="com.jaspersoft.studio.unit." value="cm"/>
	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="PROT" class="java.lang.String"/>
	<parameter name="ANO" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<parameter name="PInt" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[
DECLARE @PROT AS INTEGER
DECLARE @ANO AS INTEGER


DECLARE @PInt as VARCHAR(30)
DECLARE @DInt as VARCHAR(30)

SET @DInt = $P{DInt}
SET @PInt = $P{PInt}


SET @PROT = $P{PROT}
SET @ANO =  $P{ANO}

--SET @DInt = ''
--SET @PInt = ''



--SET @PROT = 141
--SET @ANO =  2026

SELECT DISTINCT

		

		PESSOA.S_NOM_PESSOA AS [Nome],
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [Matricula],		
		(CASE ORGANIZACAOPESSOA.N_ORG_ORG WHEN 1 THEN 'Prefeitura Municipal de Barueri' 
             WHEN 2 THEN 'Câmara Municipal de Barueri' 
             WHEN 3 THEN 'FIEB - Fundação Instituto de Educação de Barueri' 
             WHEN 4 THEN 'IPRESB - Instituto de Previdência Social dos Servidores Municipais de Barueri' 
		END) AS [Ente],
		CONVERT(VARCHAR,ORGANIZACAOPESSOA.DT_ADM_ORGPESSOA,103) AS ADMISSÃO,
		CARGO.S_DCR_CARGO AS CARGO,
				RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS CPF,
		PESSOA.S_SEXO_PESSOA AS [Sexo],	
		MAX(TIPOBENEFICIO.S_DCR_TIPBNF) AS [tipoAposentadoria],
		CONVERT(VARCHAR,SPBP.DT_DIREITOBNF_SPLNBNFPES,103) AS [dataSimulacao],
		TIPOREGRA.N_TIPREGRA_TIPREGRA,

		(CASE WHEN TIPOREGRA.N_TIPREGRA_TIPREGRA = 11 THEN 'Artigo 3º, da Emenda Constitucional nº 47, de 05 de julho de 2005 e art. 225, da Lei Complementar n° 434, de 14 de agosto de 2018'
		WHEN TIPOREGRA.N_TIPREGRA_TIPREGRA IN (4,8,29)  THEN 'Art. 40, § 1°, Inc. III, "b" da CF/88, Red. EC Nº 41/03 - Art. 37-LC nº 434/2018'
		END) AS TEXTOARTIGO,

		('PA-' + CONVERT(VARCHAR,@PROT) + '/' + CONVERT(VARCHAR,@ANO)) AS PROTOCOLO,

		--CARGO EFETIVO DO GESTOR INTERINO
				GESTOR_INTERINO.Cargo_Efetivo AS [CARGO DO DIRETOR INTERINO], 

				--CARGO EFETIVO DO PRESIDENTE INTERINO
				PRESIDENTE_INTERINO.Cargo_Efetivo AS [CARGO DO PRESIDENTE INTERINO],

				--MATRÍCULA DO CARGO EFETIVO DO GESTOR INTERINO
				GESTOR_INTERINO.Matrícula AS [MATRICULA DO DIRETOR INTERINO], 

				--MATRÍCULA DO CARGO EFETIVO DO PRESIDENTE INTERINO
				PRESIDENTE_INTERINO.Matrícula AS [MATRICULA DO PRESIDENTE INTERINO],
				
				--GÊNERO DO GESTOR INTERINO
				GESTOR_INTERINO.Gênero AS [GENERO DO DIRETOR INTERINO],
				
				----GÊNERO DO PRESIDENTE INTERINO
				PRESIDENTE_INTERINO.Gênero AS [GENERO DO PRESIDENTE INTERINO],

				
			
				--NOMENCLATURA DO CARGO DE GESTOR
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nomenclatura_Cargo 
							ELSE GESTOR_TITULAR.Nomenclatura_Cargo
							END) AS CARGO_DIRETOR,

				--NOMENCLATURA DO CARGO DE PRESIDENTE
				(CASE		WHEN @PInt = UPPER('S') 
							THEN 'PRESIDENTE INTERINO DO IPRESB'
							ELSE 'PRESIDENTE DO IPRESB'
							END) AS CARGO_PRESIDENTE,

				--NOME DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nome
							ELSE GESTOR_TITULAR.Nome
							END) AS NOME_DIRETOR,

					--NOME DO PRESIDENTE EM EXERCÍCIO
				(CASE		WHEN @PInt = UPPER('S') 
							THEN PRESIDENTE_INTERINO.Nome
							ELSE PRESIDENTE_TITULAR.Nome
							END) AS NOME_PRESIDENTE

	



FROM
	
			
			SERVICOPESSOA SP 
			INNER JOIN PESSOA ON SP.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
			INNER JOIN SIMULACAOPLANOBENEFICIOPESSOA SPBP ON SPBP.N_PESSOA_PESSOA = SP.N_PESSOA_PESSOA
			INNER JOIN ORGANIZACAOPESSOA ON SP.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = SP.N_CODORI_ORGPESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = SP.N_ORG_ORG
			INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA
			INNER JOIN CARGO ON CARGOORGANIZACAOPESSOA.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = CARGO.N_ORG_ORG
			
			INNER JOIN TIPOBENEFICIO ON SPBP.N_TIPBNF_TIPBNF = TIPOBENEFICIO.N_TIPBNF_TIPBNF
			INNER JOIN SIMULACAOBENEFICIOESPECIFICACAOPESSOA ON SP.N_PESSOA_PESSOA = SIMULACAOBENEFICIOESPECIFICACAOPESSOA.N_PESSOA_PESSOA
			INNER JOIN REGRAETAPABENEFICIOPLANO ON SPBP.N_SEQ_REGRAETPBNFPLN = REGRAETAPABENEFICIOPLANO.N_SEQ_REGRAETPBNFPLN
			INNER JOIN TIPOREGRA ON REGRAETAPABENEFICIOPLANO.N_TIPREGRA_TIPREGRA = TIPOREGRA.N_TIPREGRA_TIPREGRA
			INNER JOIN REQUISITOSIMULACAOPLANOBENEFICIOPESSOA RQ ON RQ.N_PESSOA_PESSOA = SP.N_PESSOA_PESSOA AND RQ.N_SEQ_SIMULBNFEPFPESSOA = SPBP.N_SEQ_SIMULBNFEPFPESSOA

			
OUTER APPLY

			--DADOS DO GESTOR TITULAR
			(SELECT
						PESSOA.S_NOM_PESSOA AS [NOME]
						
						,CARGO.S_DCR_CARGO AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]
			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_TITULAR(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo)

OUTER APPLY

			--DADOS DO GESTOR INTERINO
			(SELECT
						PESSOA.S_NOM_PESSOA AS [NOME]
						
						,CARGO.S_DCR_CARGO AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_INTERINO(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo)

OUTER APPLY

			--DADOS DO PRESIDENTE TITULAR
			(SELECT
						PESSOA.S_NOM_PESSOA AS [NOME]
						
						,CARGO.S_DCR_CARGO AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]


			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 3 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			PRESIDENTE_TITULAR(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo)

OUTER APPLY

			--DADOS DO PRESIDENTE INTERINO
			(SELECT
						PESSOA.S_NOM_PESSOA AS [NOME]
						
						,CARGO.S_DCR_CARGO AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]

					
			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			PRESIDENTE_INTERINO(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo)


WHERE

		SP.N_NUMPROT_SERVPESSOA = @PROT AND
		SP.N_ANOREFER_SERVPESSOA = @ANO AND
		ORGANIZACAOPESSOA.DT_DSL_ORGPESSOA IS NULL 
		AND CARGOORGANIZACAOPESSOA.DT_FIMVIG_CARGOORGPESSOA IS NULL	
		AND		
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA  
		

			AND  SPBP.N_SEQ_SIMULBNFEPFPESSOA = (SELECT	max(SPBP2.N_SEQ_SIMULBNFEPFPESSOA)
												 FROM	SIMULACAOPLANOBENEFICIOPESSOA SPBP2
												 WHERE	SPBP2.N_PESSOA_PESSOA = SPBP.N_PESSOA_PESSOA)

			AND SPBP.DT_DIREITOBNF_SPLNBNFPES = (SELECT min(SPBP4.DT_DIREITOBNF_SPLNBNFPES)
												FROM SIMULACAOPLANOBENEFICIOPESSOA SPBP4 
												INNER JOIN REGRAETAPABENEFICIOPLANO ON SPBP4.N_SEQ_REGRAETPBNFPLN = REGRAETAPABENEFICIOPLANO.N_SEQ_REGRAETPBNFPLN
												INNER JOIN TIPOREGRA ON REGRAETAPABENEFICIOPLANO.N_TIPREGRA_TIPREGRA = TIPOREGRA.N_TIPREGRA_TIPREGRA
												INNER JOIN REQUISITOSIMULACAOPLANOBENEFICIOPESSOA RQ ON RQ.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
												INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
												INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA
												WHERE 	ORGANIZACAOPESSOA.DT_DSL_ORGPESSOA IS NULL 
												AND CARGOORGANIZACAOPESSOA.DT_FIMVIG_CARGOORGPESSOA IS NULL and CARGOORGANIZACAOPESSOA.N_VINC_CARGOORGPESSOA = 2 AND
												SPBP.N_PESSOA_PESSOA = SPBP4.N_PESSOA_PESSOA AND SPBP4.N_SEQ_SIMULBNFEPFPESSOA = SPBP.N_SEQ_SIMULBNFEPFPESSOA AND ( 

											
												TIPOREGRA.N_TIPREGRA_TIPREGRA = 4
												OR
												TIPOREGRA.N_TIPREGRA_TIPREGRA = 8
												OR
												TIPOREGRA.N_TIPREGRA_TIPREGRA = 29
												OR
												( TIPOREGRA.N_TIPREGRA_TIPREGRA = 11 AND RQ.N_TIPREQ_TIPREQ = 31 AND RQ.S_ATEND_REQSIMULPLNBNFPESSOA ='S' )
												
												))
												
			AND TIPOBENEFICIO.S_DCR_TIPBNF = (SELECT TOP 1 MAX(TP3.S_DCR_TIPBNF)
											FROM TIPOBENEFICIO TP3
											WHERE TP3.N_TIPBNF_TIPBNF = TIPOBENEFICIO.N_TIPBNF_TIPBNF)

			AND REGRAETAPABENEFICIOPLANO.N_TIPREGRA_TIPREGRA = (SELECT TOP 1(REGRAETAPABENEFICIOPLANO2.N_TIPREGRA_TIPREGRA)
												FROM REGRAETAPABENEFICIOPLANO REGRAETAPABENEFICIOPLANO2
												WHERE REGRAETAPABENEFICIOPLANO.N_TIPREGRA_TIPREGRA = REGRAETAPABENEFICIOPLANO2.N_TIPREGRA_TIPREGRA)
			
				AND SIMULACAOBENEFICIOESPECIFICACAOPESSOA.N_SEQ_SIMULBNFEPFPESSOA = SPBP.N_SEQ_SIMULBNFEPFPESSOA

				AND TIPOBENEFICIO.N_TIPBNF_TIPBNF NOT IN (1,4,19,107)

				AND REGRAETAPABENEFICIOPLANO.N_TIPREGRA_TIPREGRA NOT IN (1,2,5,6,7,12,13,14,15,16,17,18,19,23,24,25,27,28,30,31,32,33,34,3,36,37,39,40,41,42,43,44,45,46,48,49,50,51,52)

				AND SPBP.DT_DIREITOBNF_SPLNBNFPES <= GETDATE()

				-- TIPO BENEFICIO = 1 ==> INVALIDEZ, 19, PENSÃO POR MORTE, 107 APOSENTADORIA ESPECIAL

				
GROUP BY	
	PESSOA.S_NOM_PESSOA, ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA, ORGANIZACAOPESSOA.N_ORG_ORG, CARGO.S_DCR_CARGO,ORGANIZACAOPESSOA.DT_ADM_ORGPESSOA,
	--OP.N_CODORI_ORGPESSOA, 
	PESSOA.S_CPF_PESSOA, PESSOA.S_SEXO_PESSOA, PESSOA.DT_NASC_PESSOA, PESSOA.S_ESTCIVIL_PESSOA,TIPOBENEFICIO.S_DCR_TIPBNF, PESSOA.S_EMAIL_PESSOA,
	--TELEFONEPESSOA.S_TIP_TELPESSOA, TELEFONEPESSOA.N_DDD_TELPESSOA, TELEFONEPESSOA.N_NUM_TELPESSOA,  
	SPBP.DT_DIREITOBNF_SPLNBNFPES, SIMULACAOBENEFICIOESPECIFICACAOPESSOA.DT_EXE_SIMULBNFEPFPESSOA, SPBP.N_SEQ_SIMULBNFEPFPESSOA,GESTOR_INTERINO.Cargo_Efetivo,PRESIDENTE_INTERINO.Cargo_Efetivo,GESTOR_INTERINO.Matrícula,PRESIDENTE_INTERINO.Matrícula,GESTOR_INTERINO.Gênero,PRESIDENTE_INTERINO.Gênero,GESTOR_INTERINO.Nomenclatura_Cargo,GESTOR_TITULAR.Nomenclatura_Cargo,PRESIDENTE_INTERINO.Nomenclatura_Cargo,PRESIDENTE_TITULAR.Nomenclatura_Cargo,GESTOR_INTERINO.Nome,GESTOR_TITULAR.Nome,
	PRESIDENTE_INTERINO.Nome,PRESIDENTE_TITULAR.Nome,
	SIMULACAOBENEFICIOESPECIFICACAOPESSOA.N_ANOTOTAL_SIMULBNFEPFPESSOA,SIMULACAOBENEFICIOESPECIFICACAOPESSOA.N_MESTOTAL_SIMULBNFEPFPESSOA,SIMULACAOBENEFICIOESPECIFICACAOPESSOA.N_DIATOTAL_SIMULBNFEPFPESSOA,	TIPOREGRA.N_TIPREGRA_TIPREGRA, TIPOREGRA.S_DCR_TIPREGRA
	


ORDER BY 
	
		PESSOA.S_NOM_PESSOA]]>
	</queryString>
