					<paragraph lineSpacing="Double" firstLineIndent="60" leftIndent="14" rightIndent="14" spacingBefore="5" spacingAfter="5"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>DECLARAMOS</style> , para os devidos fins, conforme consta do Processo Administrativo nº  <style isBold='true'>"+$F{PROTOCOLO}+"</style>, que o servidor(a)  <style isBold='true'>"+ $F{Nome}+"</style>, portador do CPF nº  <style isBold='true'>"+$F{CPF} + "</style>, com matrícula funcional nº <style isBold='true'>" +$F{Matricula}+"</style>, na qualidade de funcionário público municipal vinculado à "+$F{Ente}+" onde é titular do cargo efetivo de " +  $F{CARGO} + ", <style isBold='true'> cumpriu/implementou os requisitos para a "+ $F{tipoAposentadoria} +"</style> pela regra prevista no " + $F{TEXTOARTIGO} + ", a partir de " + $F{dataSimulacao} + "."]]></textFieldExpression>
			</textField>
