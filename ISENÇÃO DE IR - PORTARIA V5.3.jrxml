		<band height="692">
			<textField>
				<reportElement x="-9" y="30" width="454" height="400" uuid="7a4e5094-44f2-4a5d-be08-650e75d532ba"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph spacingBefore="14"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>"+UPPER($F{NOME_PRESIDENTE})+"</style>"+$F{COND_PRESIDENTE}+" e <style isBold='true'>"+UPPER($F{NOME_DIRETOR})+"</style>"+$F{COND_DIRETOR}+", usando das atribuições que lhes são conferidas por lei;<br/><br/>"+"Considerando o que consta no Processo Administrativo n° <style isBold='true'>" +$F{NUMPROC}+"</style>"+", instruído com documentos pessoais e Laudo Médico Pericial;<br/><br/>"+"Considerando a Lei Complementar nº 434, de 14 de agosto de 2018 que dispõe sobre o Regime Próprio de Previdência Social RPPS do Município de Barueri e o IPRESB"+".<br/><br/><style isBold='true'>"

+"RESOLVEM:</style><br/><br/>"+

"I - <style isBold='true'>"+$F{INDEFERIR OU CONCEDER}
+"</style> a " + $F{TIPO DE BENEFICIO}
+", atendendo ao Relatório de Exame Médico – Pericial de " + DATEFORMAT($F{ÚLTIMA PERÍCIA REALIZADA},"dd/MM/yyyy")
+", declarando que o(a) servidor(a) aposentado(a) <style isBold='true'>"+$F{NOME}
+"</style>, matrícula " + $F{MATRÍCULA} + ", RG " + $F{RG} + ", CPF "+$F{CPF} +", PIS/PASEP/NIT "+$F{NIT}
+", " + ($F{SITUAÇÃO} !=null ? "<style isBold='true'>NÃO </style>":"")
+"é portador(a) de patologia que está prevista no inciso XIV do artigo 6° da Lei nº 7.713 de 22/12/1988.<br/><br/>"

+$F{TEXTO INCISO II DEFERIDO} 
+"<br/><br/>"+$F{INCISO III}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-9" y="430" width="454" height="24" uuid="86f43020-0f33-4919-940a-407f6a71c5a7"/>
