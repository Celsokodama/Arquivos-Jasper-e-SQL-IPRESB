	<queryString language="SQL">
		<![CDATA[--Coonsulta da Lista de Abono de Permanência que estão lançadas nos assentamentos

SELECT 

			A.N_ORG_ORG AS [Org],
			A.N_CODORI_ORGPESSOA AS [Matrícula],
			P.N_PESSOA_PESSOA AS [Nº Pessoa],
			P.S_NOM_PESSOA AS [Nome],
			P.S_CPF_PESSOA AS [CPF],
			A.N_TIPATO_TIPATO AS [Nº Tipo Ato],
			Case A.N_TIPATO_TIPATO When '22' Then 'Certidão de Abono de Permanência' END AS [Tipo Ato],
			A.N_ATO_ASSENTANEXOCONCES AS [N°],
			BP.N_PROT_BNFPESSOA AS [Beneficio],
			TB.S_DCR_TIPBNF AS [Tipo de beneficio],
			convert(varchar,A.DT_PUBL_ASSENTANEXOCONCES,103) AS [Inicio do direito]

FROM	
		
			ASSENTAMENTOANEXOCONCESSAO A
			LEFT JOIN	ORGANIZACAOPESSOA OP 
				ON		OP.N_ORG_ORG = A.N_ORG_ORG 
				AND		OP.N_CODORI_ORGPESSOA = A.N_CODORI_ORGPESSOA
			LEFT JOIN	PESSOA P 
				ON		P.N_PESSOA_PESSOA = OP.N_PESSOA_PESSOA
			LEFT JOIN	BENEFICIOPESSOA BP 
				ON		OP.N_PESSOA_PESSOA = BP.N_PESSOA_PESSOA 
				AND		A.N_ORG_ORG = BP.N_ORG_ORG 
				AND		A.N_CODORI_ORGPESSOA = BP.N_CODORI_ORGPESSOA
				AND		BP.N_PROT_BNFPESSOA = (	SELECT	MAX(BP2.N_PROT_BNFPESSOA) 
												FROM	BENEFICIOPESSOA BP2 
												WHERE	OP.N_PESSOA_PESSOA = BP2.N_PESSOA_PESSOA 
														AND	A.N_ORG_ORG = BP2.N_ORG_ORG 
														AND	A.N_CODORI_ORGPESSOA = BP2.N_CODORI_ORGPESSOA)
			LEFT JOIN	TIPOBENEFICIO TB 
				ON		TB.N_TIPBNF_TIPBNF = BP.N_TIPBNF_TIPBNF

WHERE		N_TIPATO_TIPATO = 22

ORDER BY	P.S_NOM_PESSOA

--Tabelas utilizadas
--SELECT * FROM ASSENTAMENTOANEXOCONCESSAO WHERE N_TIPATO_TIPATO = 22
--SELECT * FROM ORGANIZACAOPESSOA
--SELECT * FROM PESSOA
--SELECT * FROM BENEFICIOPESSOA
--SELECT * FROM TIPOBENEFICIO]]>
	</queryString>
