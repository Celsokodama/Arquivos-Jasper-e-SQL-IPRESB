	<parameter name="Banco5" class="java.lang.String"/>
	<parameter name="Valor5" class="java.lang.String"/>
	<parameter name="Meshol" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @Protoclo as INT
DECLARE @Ano as INT
DECLARE @Meshol AS VARCHAR(7)


DECLARE @Banco1 as VARCHAR(50)
DECLARE @Valor1 AS VARCHAR(10)
DECLARE @Banco2 as VARCHAR(50)
DECLARE @Valor2 AS VARCHAR(10)
DECLARE @Banco3 as VARCHAR(50)
DECLARE @Valor3 AS VARCHAR(10)
DECLARE @Banco4 as VARCHAR(50)
DECLARE @Valor4 AS VARCHAR(10)
DECLARE @Banco5 as VARCHAR(50)
DECLARE @Valor5 AS VARCHAR(10)

SET @Meshol =  $P{Meshol}
SET @Protoclo =  $P{Protocolo}
SET @Ano = $P{Ano}
SET @Banco1 = $P{Banco1}
SET @Valor1 = $P{Valor1}
SET @Banco2 = $P{Banco2}
SET @Valor2 = $P{Valor2}
SET @Banco3 = $P{Banco3}
SET @Valor3 = $P{Valor3}
SET @Banco4 = $P{Banco4}
SET @Valor4 = $P{Valor4}
SET @Banco5 = $P{Banco5}
SET @Valor5 = $P{Valor5}



SELECT 

P.S_NOM_PESSOA AS NOME,
	LEFT(P.S_CPF_PESSOA,3)+'.'+SUBSTRING(P.S_CPF_PESSOA,4,3)+'.'+SUBSTRING(P.S_CPF_PESSOA,7,3)+'-'+SUBSTRING(P.S_CPF_PESSOA,10,2) AS CPF,
@Meshol AS MESHOLERITE,


@Banco1 AS BANCO1,
@Valor1 AS VALOR1,
@Banco2 AS BANCO2,
@Valor2 AS VALOR2,
@Banco3 AS BANCO3,
@Valor3 AS VALOR3,
@Banco4 AS BANCO4,
@Valor4 AS VALOR4,
@Banco5 AS BANCO5,
@Valor5 AS VALOR5




FROM SERVICOPESSOA S INNER JOIN PESSOA P ON S.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA

WHERE S.N_NUMPROT_SERVPESSOA = @Protoclo AND S.N_ANOREFER_SERVPESSOA = @Ano]]>
	</queryString>
