	</field>
	<field name="INICIO RELACIONAMENTO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="INICIO RELACIONAMENTO"/>
		<property name="com.jaspersoft.studio.field.label" value="INICIO RELACIONAMENTO"/>
	</field>
	<field name="FIM RELACIONAMENTO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="FIM RELACIONAMENTO"/>
		<property name="com.jaspersoft.studio.field.label" value="FIM RELACIONAMENTO"/>
