		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Protocolo" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE PORTUGUESE	

DECLARE @Protocolo AS INT
DECLARE @Ano AS INT
DECLARE @MUsuario AS INT



DECLARE @Ente AS INT
DECLARE @Cargo AS INT
DECLARE @ExtraT AS varchar(1)
DECLARE @Matricula AS INT

SET @Protocolo =  $P{Protocolo}
SET @Ano = $P{Ano}
SET @MUsuario = $P{MUsuario}


--SET @Protocolo =  622
--SET @Ano = 2026
--SET @MUsuario = 96



SET @Ente = (Select SP2.N_ORG_ORG
			FROM SERVICOPESSOA SP2
			WHERE SP2.N_NUMPROT_SERVPESSOA = @Protocolo AND
			SP2.N_ANOREFER_SERVPESSOA = @Ano)

			SET @Matricula = (Select SP3.N_CODORI_ORGPESSOA
			FROM SERVICOPESSOA SP3
			WHERE SP3.N_NUMPROT_SERVPESSOA = @Protocolo AND
			SP3.N_ANOREFER_SERVPESSOA = @Ano)

SET @Cargo = (Select TOP 1 COP3.N_CARGO_CARGO
				FROM CARGOORGANIZACAOPESSOA COP3 INNER JOIN SERVICOPESSOA SP3 ON SP3.N_CODORI_ORGPESSOA = COP3.N_CODORI_ORGPESSOA AND SP3.N_ORG_ORG = COP3.N_ORG_ORG
				WHERE SP3.N_NUMPROT_SERVPESSOA = @Protocolo AND SP3.N_ANOREFER_SERVPESSOA = @Ano  )

SELECT DISTINCT

(CASE	WHEN CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) <=2018 
						THEN 'BI-'+ CONVERT(VarChar(5), SP.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) 
						ELSE 'PA-'+ CONVERT(VarChar(5), SP.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SP.N_ANOREFER_SERVPESSOA) 
						END) AS NOMEPROT,

P.S_NOM_PESSOA AS NOME,
convert(varchar,P.DT_NASC_PESSOA,103) AS NASCIMENTO,

FLOOR(
    DATEDIFF(DAY, P.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0
) AS [IDADE DO SERVIDOR],
RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)	+'.'+SUBSTRING(P.S_CPF_PESSOA,4,3)	+'.'+SUBSTRING(P.S_CPF_PESSOA,7,3)	+'-'+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS [CPF],
COP.N_CODORI_ORGPESSOA AS MATRICULA,
P.DT_FALEC_PESSOA AS OBITO,
SP.DT_SLCT_SERVPESSOA  AS [DATAREQUERIMENTO],

CASE
    WHEN DATEDIFF(DAY,  P.DT_FALEC_PESSOA , SP.DT_SLCT_SERVPESSOA) > 30
        THEN  SP.DT_SLCT_SERVPESSOA
		ELSE P.DT_FALEC_PESSOA
END AS DIB,

O.S_DCR_ORG AS ORGANIZAÇÃO,
CARGO.S_DCR_CARGO AS CARGO,
TIPO.S_DCRSERV_TIPSERV AS SERVIÇO,
@MUsuario as MUsuario,
USUARIO as [Nome IPRESB],
[CARGO USUARIO] AS [Cargo IPRESB],

P2.S_NOM_PESSOA AS NOMEDEP,
CONVERT(VARCHAR,P2.DT_NASC_PESSOA,103) AS [NASCIMENTO DEP],
FLOOR(
    DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0
) AS [IDADE DEP],
LOWER(PARENT.S_DCR_GRAUPARENT) AS parentesco,
CONVERT(VARCHAR,R.DT_INIVIG_RELACPESSOA,103) AS [INICIO RELACIONAMENTO],
CONVERT(VARCHAR,R.DT_FIMVIG_RELACPESSOA,103) AS [FIM RELACIONAMENTO],
(CASE WHEN PARENT.N_GRAUPARENT_GRAUPARENT IN (1,2) THEN 


CONVERT(VARCHAR,FLOOR(
    DATEDIFF(DAY, R.DT_INIVIG_RELACPESSOA, P.DT_FALEC_PESSOA) / 365.0
),103) + ' ANOS' ELSE '' END)AS [TEMPO DE RELACIONAMENTO],

-- DECLARADO OU PARENTE:

(CASE WHEN PARENT.N_GRAUPARENT_GRAUPARENT IN (1,2) THEN 'Declarado:'
	ELSE 'Parentesco:' END) AS TEXTO_PARENTESCO,


--TEXTO DO DEPENDENTE:

(CASE PARENT.N_GRAUPARENT_GRAUPARENT

-- TEMPO DE CONTRIBUIÇÃO
WHEN 1 THEN (CASE WHEN (S.N_ANOTOTAL_SIMULBNFEPFPESSOA * 365 + S.N_MESTOTAL_SIMULBNFEPFPESSOA *30 + S.N_DIATOTAL_SIMULBNFEPFPESSOA) < 540 THEN '4 meses de benefício'
					--TEMPO DE RELACIONAMENTO
			ELSE  (CASE WHEN FLOOR(DATEDIFF(DAY, R.DT_INIVIG_RELACPESSOA, P.DT_FALEC_PESSOA) / 365.0) < 2  THEN '4 meses de benefício'
					-- IDADE DO VIÚVO
					ELSE (CASE 
								WHEN (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 21 THEN '3 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 21 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 27 )THEN '6 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 27 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 30 )THEN '10 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 30 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 41 )THEN '15 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 41 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 43 )THEN '20 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 44 )THEN 'Vitalício'
						END) END) END)



WHEN 2 THEN (CASE WHEN (S.N_ANOTOTAL_SIMULBNFEPFPESSOA * 365 + S.N_MESTOTAL_SIMULBNFEPFPESSOA *30 + S.N_DIATOTAL_SIMULBNFEPFPESSOA) < 540 THEN '4 meses de benefício'
					--TEMPO DE RELACIONAMENTO
			ELSE  (CASE WHEN DATEDIFF(YEAR,R.DT_INIVIG_RELACPESSOA,GETDATE()) < 2  THEN '4 meses de benefício'
					-- IDADE DO VIÚVO
					ELSE (CASE 
								WHEN (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 21 THEN '3 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 21 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 27 )THEN '6 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 27 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 30 )THEN '10 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 30 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 41 )THEN '15 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 41 AND (FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) < 43 )THEN '20 anos de benefício'
								WHEN ((FLOOR(DATEDIFF(DAY, P2.DT_NASC_PESSOA, P.DT_FALEC_PESSOA) / 365.0)) >= 44 )THEN 'Vitalício'
			END) END) END)

-- FILHO OU ENTEADO MENOR DE 21
WHEN 3 THEN convert(varchar,dateadd(YEAR,21,P2.DT_NASC_PESSOA),103)
WHEN 10 THEN convert(varchar,dateadd(YEAR,21,P2.DT_NASC_PESSOA),103)

-- INVÁLIDO
WHEN 4 THEN 'Enquanto perdurar a invalidez'
WHEN 7 THEN 'Enquanto perdurar a invalidez'
WHEN 9 THEN 'Enquanto perdurar a invalidez'

-- OUTROS
ELSE 'Vitalício'

END) AS [TEXTO DEPENDENTE] ,

CONVERT(VARCHAR,S.N_ANOTOTAL_SIMULBNFEPFPESSOA * 365 + S.N_MESTOTAL_SIMULBNFEPFPESSOA *30 + S.N_DIATOTAL_SIMULBNFEPFPESSOA) + ' dias ou ' + CONVERT(VARCHAR,S.N_ANOTOTAL_SIMULBNFEPFPESSOA) + ' ano(s) ' + CONVERT(VARCHAR,S.N_MESTOTAL_SIMULBNFEPFPESSOA) + ' mes(es) ' + CONVERT(VARCHAR,S.N_DIATOTAL_SIMULBNFEPFPESSOA) + ' dia(s)'  AS [TEMPO DE CONTR],
S.N_SEQ_SIMULBNFEPFPESSOA AS [N SIMULAÇÃO],

(CASE WHEN PARENT.N_GRAUPARENT_GRAUPARENT IN (1,2) THEN 'S' ELSE 'N'
END) AS IMPRIME,

DIB.DTDIB AS DIB,
SP.N_TIPSERV_TIPSERV AS TIPOSERV,
				(select count (*) 

				FROM SERVICOPESSOA SP
				INNER JOIN ORGANIZACAO O ON SP.N_ORG_ORG = O.N_ORG_ORG
				INNER JOIN TIPOSERVICO TIPO ON TIPO.N_TIPSERV_TIPSERV = SP.N_TIPSERV_TIPSERV				
				LEFT JOIN PESSOA P ON SP.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA
				LEFT JOIN GRUPOFAMILIAR GFAM ON GFAM.N_PESSOA_PESSOA = SP.N_PESSOA_PESSOA AND GFAM.S_DIREITOCOTA_GRPFAM = 'S'
				
				WHERE 
				SP.N_TIPSERV_TIPSERV IN (21,32,41,42,43,57,66,91) AND
				SP.N_NUMPROT_SERVPESSOA = @Protocolo AND
				SP.N_ANOREFER_SERVPESSOA = @Ano
				) as linhas

FROM SERVICOPESSOA SP
INNER JOIN ORGANIZACAO O ON SP.N_ORG_ORG = O.N_ORG_ORG
INNER JOIN TIPOSERVICO TIPO ON TIPO.N_TIPSERV_TIPSERV = SP.N_TIPSERV_TIPSERV
INNER JOIN SIMULACAOBENEFICIOESPECIFICACAOPESSOA S ON SP.N_PESSOA_PESSOA = S.N_PESSOA_PESSOA
LEFT JOIN CARGOORGANIZACAOPESSOA COP ON SP.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND COP.N_ORG_ORG = SP.N_ORG_ORG AND COP.DT_INIVIG_CARGOORGPESSOA = (SELECT MAX(COP4.DT_INIVIG_CARGOORGPESSOA)
																																									FROM CARGOORGANIZACAOPESSOA COP4
																																									WHERE COP4.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND COP.N_ORG_ORG = COP4.N_ORG_ORG)
LEFT JOIN CARGO ON COP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND COP.N_ORG_ORG = CARGO.N_ORG_ORG 
LEFT JOIN REFERENCIAGRUPO RG ON RG.N_COD_REFERGRP = COP.N_COD_REFERGRP
LEFT JOIN REFERENCIACLASSE RC ON RC.N_COD_REFERCLASS = COP.N_COD_REFERCLASS
LEFT JOIN REFERENCIANIVEL RN ON RN.N_COD_REFERNIV = COP.N_COD_REFERNIV
LEFT JOIN PESSOA P ON SP.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA
LEFT JOIN GRUPOFAMILIAR GFAM ON GFAM.N_PESSOA_PESSOA = SP.N_PESSOA_PESSOA AND GFAM.S_DIREITOCOTA_GRPFAM = 'S'
LEFT JOIN RELACAOPESSOA R ON GFAM.N_PESSOA_PESSOA = R.N_PESSOA_PESSOA AND GFAM.N_PESSOARELAC_PESSOA = R.N_PESSOARELAC_PESSOA
LEFT JOIN GRAUDEPARENTESCO PARENT ON R.N_GRAUPARENT_GRAUPARENT = PARENT.N_GRAUPARENT_GRAUPARENT
LEFT JOIN PESSOA P2 ON GFAM.N_PESSOARELAC_PESSOA = P2.N_PESSOA_PESSOA

	OUTER APPLY 
		(SELECT 
				CASE WHEN DATEDIFF(day, P4.DT_FALEC_PESSOA, SP4.DT_SLCT_SERVPESSOA) <= 30
				THEN P4.DT_FALEC_PESSOA 
				ELSE SP4.DT_SLCT_SERVPESSOA
				END	AS DT_DIB
		FROM SERVICOPESSOA SP4 inner JOIN PESSOA P4 ON P4.N_PESSOA_PESSOA = SP4.N_PESSOA_PESSOA
		WHERE 
		SP4.N_NUMPROT_SERVPESSOA = @Protocolo AND
		SP4.N_ANOREFER_SERVPESSOA = @Ano 
		) DIB(DTDIB)

	OUTER APPLY

		  (SELECT        PESSOA_3.S_NOM_PESSOA AS USUARIO
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS USUARIO,
                             (SELECT       CARGO_3.S_DCR_CARGO AS [CARGO USUARIO]
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS CARGO_USUARIO


	

WHERE 
SP.N_TIPSERV_TIPSERV IN (21,32,41,42,43,57,66,91) AND
SP.N_NUMPROT_SERVPESSOA = @Protocolo AND
SP.N_ANOREFER_SERVPESSOA = @Ano and 
SP.N_PESSOA_PESSOA = S.N_PESSOA_PESSOA AND
COP.DT_INIVIG_CARGOORGPESSOA = (SELECT MAX(COP5.DT_INIVIG_CARGOORGPESSOA)
								FROM CARGOORGANIZACAOPESSOA COP5
								WHERE COP5.N_CODORI_ORGPESSOA = COP.N_CODORI_ORGPESSOA AND COP.N_ORG_ORG = COP5.N_ORG_ORG)

							


												AND  S.N_SEQ_SIMULBNFEPFPESSOA = (SELECT	max(S2.N_SEQ_SIMULBNFEPFPESSOA)
																FROM	SIMULACAOBENEFICIOESPECIFICACAOPESSOA S2
																WHERE	S2.N_PESSOA_PESSOA = S.N_PESSOA_PESSOA)]]>
	</queryString>
	<field name="NOMEPROT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMEPROT"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMEPROT"/>
	</field>
