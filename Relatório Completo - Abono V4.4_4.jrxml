				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA["*Norma mantida por força do disposto no §7º do Art. 10 da Emenda Constitucional nº 103, de 12 de novembro de 2019 e conforme previsto nos Artigos " + $F{COND_MAGISTERIO2} + "."]]></textFieldExpression>
