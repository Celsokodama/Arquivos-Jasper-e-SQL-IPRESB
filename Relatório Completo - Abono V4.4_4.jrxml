		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Ano" class="java.lang.String"/>
	<parameter name="Certidao" class="java.lang.String"/>
	<parameter name="Magist" class="java.lang.String"/>
	<parameter name="Organiz" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<parameter name="PInt" class="java.lang.String"/>
	<parameter name="Matricula" class="java.lang.String"/>
	<parameter name="Parameter1" class="CPF"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE PORTUGUESE

DECLARE @Ano as INT
DECLARE @Certidao as INT
DECLARE @Organiz as INT
DECLARE @Magist as VARCHAR(1)
DECLARE @DInt as VARCHAR(1)
DECLARE @PInt as VARCHAR(1)
DECLARE @Matricula as INT


Set @Ano = $P{Ano}
Set @Certidao =$P{Certidao}
Set @Organiz = $P{Organiz}
Set @Magist = $P{Magist}
Set @DInt = $P{DInt}
Set @PInt = $P{PInt}
Set @Matricula = $P{Matricula}


		SELECT

        
						dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(ORGANIZACAO.S_DCR_ORG)) AS ENTE, 
						
						A.N_CODORI_ORGPESSOA AS MATRICULA, 
						A.N_ATO_ASSENTANEXOCONCES AS [NUM CERTIDAO], 
						A.N_ANOREF_ASSENTANEXOCONCES AS [ANO ASSENTAMENTO], 

						'BI-' + CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) AS PROTOCOLO, 
						 CONVERT(VARCHAR,  A.DT_PUBL_ASSENTANEXOCONCES, 103) AS [DT ASSENTAMENTO], 

						 PESSOA.S_RG_PESSOA AS RG, 

						 	RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF],

                         dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA.S_NOM_PESSOA)) AS NOME,


                         dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(CARGO.S_DCR_CARGO)) AS CARGO,
					  (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'servidor' ELSE 'servidora' END) AS GENERO,
					  (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'o' ELSE 'a' END) AS ARTIGO,
					  (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'funcionário público' ELSE 'funcionária pública' END) AS FUNCIONARIO,
					  (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'portador' ELSE 'portadora' END) AS PORTADOR,
					  (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'vinculado' ELSE 'vinculada' END) AS VINCULADO,
					  (CASE WHEN @DInt = UPPER('S') THEN 'Gestor(a) Interino(a) de Benefícios Previdenciários' ELSE 'Gestor de Benefícios Previdenciários' END) AS CARGO_DIRETOR,
					  (CASE WHEN @PInt = UPPER('S') THEN 'Presidente Interino(a)' ELSE 'Presidente' END) AS CARGO_PRESIDENTE,
					  (CASE WHEN @DInt = UPPER('S') THEN (SELECT dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) ELSE (SELECT dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2)) END) AS NOME_DIRETOR,
					  (CASE WHEN @PInt = UPPER('S') THEN (SELECT dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4)) ELSE (SELECT dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 3)) END) AS NOME_PRESIDENTE,
					  (CASE WHEN CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) <=2018 THEN 'BI-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) ELSE 'PA-'+ CONVERT(VarChar(5), SERVICOPESSOA.N_NUMPROT_SERVPESSOA) + '/' + CONVERT(VarChar(5), SERVICOPESSOA.N_ANOREFER_SERVPESSOA) END) AS NUMPROC,
			          CONVERT(varchar(02), DATEPART(DAY, A.DT_PUBL_ASSENTANEXOCONCES)) + ' de ' + DATENAME(MONTH, A.DT_PUBL_ASSENTANEXOCONCES) 
                         + ' de ' + CONVERT(varchar(04), DATEPART(YEAR, A.DT_PUBL_ASSENTANEXOCONCES)) AS EMISSAO, CASE WHEN @Magist = UPPER('S') 
                         THEN 'artigo 40, §1º, Inciso III, alínea "a", § 5º da Constituição Federal' WHEN @Magist = UPPER('N') 
                         THEN 'artigo 40, §1º, Inciso III, alínea "a" da Constituição Federal' ELSE 'artigo 40, §1º, Inciso III, alínea "a" da Constituição Federal' END AS COND_MAGISTERIO,
                         (CASE WHEN @Magist = UPPER('S') 
                         	THEN '35, 36 e 231 da Lei Complementar nº 434 de 14 de agosto de 2018'
                         	WHEN @Magist = UPPER('N') THEN  '35 e 231 da Lei Complementar nº 434 de 14 de agosto de 2018' ELSE '35 e 231 da Lei Complementar nº 434 de 14 de agosto de 2018'
                       END  ) AS COND_MAGISTERIO2,
                         


						 --- quem emitiu
                          (SELECT        dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA_3.S_NOM_PESSOA)) AS USUARIO
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @Matricula)) AS USUARIO,

                             (SELECT        dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(CARGO_3.S_DCR_CARGO)) AS [CARGO USUARIO]
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @Matricula)) AS CARGO_USUARIO     
							   

	FROM



				
			ASSENTAMENTOANEXOCONCESSAO AS A INNER JOIN
			ORGANIZACAOPESSOA AS OP ON A.N_ORG_ORG = OP.N_ORG_ORG AND A.N_CODORI_ORGPESSOA = OP.N_CODORI_ORGPESSOA INNER JOIN
			CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_ORG_ORG = A.N_ORG_ORG AND CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = A.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.DT_FIMVIG_CARGOORGPESSOA IS NULL AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' 	INNER JOIN
			ORGANIZACAO ON OP.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG INNER JOIN
			CARGO ON CARGO.N_ORG_ORG =  A.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN 
			PESSOA ON OP.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
			SERVICOPESSOA ON SERVICOPESSOA.N_ORG_ORG = A.N_ORG_ORG AND SERVICOPESSOA.N_CODORI_ORGPESSOA = A.N_CODORI_ORGPESSOA


	
WHERE     


			SERVICOPESSOA.N_TIPSERV_TIPSERV =6 AND 
			A.N_ANOREF_ASSENTANEXOCONCES = @Ano AND 
			A.N_ATO_ASSENTANEXOCONCES = @Certidao AND 
			A.N_ORG_ORG = @Organiz AND
			A.N_CODORI_ORGPESSOA = SERVICOPESSOA.N_CODORI_ORGPESSOA AND
			A.N_TIPATO_TIPATO = 22
]]>
	</queryString>
