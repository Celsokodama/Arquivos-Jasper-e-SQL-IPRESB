		<band height="692">
			<printWhenExpression><![CDATA[$F{GERAR}.equals("S")]]></printWhenExpression>
			<textField>
				<reportElement positionType="Float" x="-10" y="30" width="460" height="560" uuid="7a4e5094-44f2-4a5d-be08-650e75d532ba"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph spacingBefore="4"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>"+UPPER($F{NOME_PRESIDENTE})+"</style>"+$F{COND_PRESIDENTE}+" e <style isBold='true'>"+UPPER($F{NOME_DIRETOR})+"</style>"+$F{COND_DIRETOR}+", usando das atribuições que lhes são conferidas por lei;<br/><br/>"+"Considerando que <style isBold='true'>"+$F{NOME}+"</style>"+" "+$F{GENERO}+", RG "+$F{RG}+", CPF "+$F{CPF}+", PIS/PASEP/NIT "+$F{NIT}+", é titular do cargo efetivo de "+UPPER($F{CARGO})+", matrícula "+$F{MATRÍCULA SEGURADO}+", na "+$F{ENTE_EXTENSO}+" e;<br/><br/>"+"Considerando o que consta no Processo Administrativo n° <style isBold='true'>" +$F{NUMPROC}+"</style>"+", instruído com documentos pessoais," +$F{TEXTO_INVALIDEZ1} + " com informações do órgão de pessoal da "  +$F{ENTE_EXTENSO}+" e com parecer jurídico favorável à concessão do benefício da "+$F{TIPO DE APOSENTADORIA}+".<br/><br/><style isBold='true'>"

+"RESOLVEM:</style><br/><br/>"

+"I - Conceder a <style isBold='true'>"+$F{NOME}+"</style>"+", "+$F{GENERO}+", <style isBold='true'>"+$F{TIPO DE APOSENTADORIA}+"</style>"+", no valor de <style isBold='true'>"+$F{PROVENTO}+"</style>"+" ("+LOWER($F{PROVENTO EXTENSO})+") mensais, nos termos do "+$F{FUNDAMENTO LEGAL}+".<br/><br/>"

+"II - O valor da Aposentadoria não será inferior ao salário mínimo do País.<br/><br/>"

+ $F{INCISO III} +"<br/><br/>"

+ $F{INCISO IV} +"<br/><br/>"

+ $F{INCISO V} +"<br/><br/>"

+ $F{INCISO VI} +"<br/><br/>"

+ $F{INCISO VII} +"<br/><br/>" 

+$F{INCISO VIII}  + "<br/>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="-10" y="575" width="460" height="42" uuid="86f43020-0f33-4919-940a-407f6a71c5a7"/>
