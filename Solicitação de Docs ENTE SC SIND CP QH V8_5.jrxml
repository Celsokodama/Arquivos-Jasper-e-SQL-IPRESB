	<detail>
		<band height="686" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="440" height="20" uuid="b8bcd072-e914-4d61-aece-41f7fcd0ccf8"/>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="64" width="459" height="116" uuid="bda60040-5264-44d9-a9ac-f085530c4745"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="true"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["De: IPRESB – Instituto de Previdência Social dos Servidores Municipais de Barueri"+"<br/>Unidade de Gestão de Benefícios Previdenciários"+"<br/><br/>Para: "+$F{DESTINATÁRIO}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="180" width="459" height="506" uuid="b66aaa8a-cb7f-46fd-bb6c-79b518441900"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Ref.: Solicitação de informações - "+ $F{DESCRIÇÃO BENEFÍCIO}+"</style><br/><br/>	Solicitamos as informações abaixo para darmos prosseguimento ao processo de <style isBold='true'>"+UPPER($F{DESCRIÇÃO BENEFÍCIO})+ "</style> do(a) servidor(a) <style isBold='true'>"+$F{NOME}+"</style>, matrícula <style isBold='true'>"+$F{MATRICULA}+"</style>.<br/><br/>"

+($F{SALARIO} !=null ? ("\u2022   " +$F{SALARIO} + "<br/>"): "")
+($F{SINDICANCIA} !=null ? ("\u2022   " +$F{SINDICANCIA} + "<br/>"): "")
+($F{COMISSÃO PROCESSANTE} !=null ? ("\u2022   " +$F{COMISSÃO PROCESSANTE} + "<br/>"): "")
+($F{QUADRO DE HORAS} !=null ? ("\u2022   Quadro com carga horária dos últimos 120 meses (" +$F{QUADRO DE HORAS} +")<br/>"): "")+"<br/><br/>Atenciosamente,<br/><br/><style isBold='true'>"+$F{USUARIO}+"<br/>Matrícula "+$F{MATRICULA_USUARIO_IPRESB}+"</style>"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="65" splitType="Stretch">
			<componentElement>
				<reportElement x="-20" y="10" width="490" height="55" uuid="d9e30884-fbee-43cb-b497-3cfa76808906"/>
