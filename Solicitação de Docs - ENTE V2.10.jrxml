	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="NumProt" class="java.lang.String"/>
	<parameter name="AnoProt" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<parameter name="InfAdic1" class="java.lang.String"/>
	<parameter name="InfAdic2" class="java.lang.String"/>
	<parameter name="InfAdic3" class="java.lang.String"/>
	<parameter name="CTS" class="java.lang.String"/>
	<parameter name="PortNom" class="java.lang.String"/>
	<parameter name="FichaReg" class="java.lang.String"/>
	<parameter name="Acumulo" class="java.lang.String"/>
	<parameter name="DocsAdic" class="java.lang.String"/>
	<parameter name="ProcAdm" class="java.lang.String"/>
	<parameter name="Salario" class="java.lang.String"/>
	<parameter name="Concurso" class="java.lang.String"/>
	<parameter name="AP_def" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[USE aspprev2_baruerisp_prd

DECLARE @numprot INT
SET @numprot = $P{NumProt}

DECLARE @anoprot INT
SET @anoprot = $P{AnoProt}

DECLARE @MUsuario INT
SET @MUsuario = $P{MUsuario}

DECLARE @InfAdic1 AS VARCHAR(1000)
SET @InfAdic1 = $P{InfAdic1}

DECLARE @InfAdic2 AS VARCHAR(1000)
SET @InfAdic2 = $P{InfAdic2}

DECLARE @InfAdic3 AS VARCHAR(1000)
SET @InfAdic3 = $P{InfAdic3}

DECLARE @CTS AS VARCHAR(1)
DECLARE @Texto_CTS AS VARCHAR(1000)
SET @CTS = $P{CTS}
SET @Texto_CTS = 'Certidão de Tempo de Serviço (CTS)'

DECLARE @Concurso AS VARCHAR(1)
DECLARE @Texto_concurso AS VARCHAR(1000)
SET @Concurso = $P{Concurso}
SET @Texto_Concurso = 'Número do concurso e ano do concurso'

DECLARE @PortNom AS VARCHAR(1)
DECLARE @Texto_PortNom AS VARCHAR(1000)
SET @PortNom = $P{PortNom}
SET @Texto_PortNom = 'Portaria de nomeação ou contrato de trabalho'

DECLARE @FichaReg AS VARCHAR(1)
DECLARE @Texto_FichaReg AS VARCHAR(1000)
SET @FichaReg = $P{FichaReg}
SET @Texto_FichaReg = 'Cópia da Ficha de Registro'

DECLARE @Acumulo AS VARCHAR(1)
DECLARE @Texto_Acumulo AS VARCHAR(1000)
SET @Acumulo = $P{Acumulo}
SET @Texto_Acumulo = 'Cópia da Declaração de Acúmulo de Cargo Público preenchida e assinada no momento da admissão  '

DECLARE @DocsAdic AS VARCHAR(1)
DECLARE @Texto_DocsAdic AS VARCHAR(1000)
SET @DocsAdic = $P{DocsAdic}
SET @Texto_DocsAdic = 'Documentos referentes a eventuais modificações na vida funcional que impactem na aposentadoria'

DECLARE @ProcAdm AS VARCHAR(1)
DECLARE @Texto_ProcAdm AS VARCHAR(1000)
SET @ProcAdm = $P{ProcAdm}
SET @Texto_ProcAdm = 'Se for o caso, cópia de processo administrativo disciplinar em andamento'

DECLARE @Salario AS VARCHAR(1)
DECLARE @Texto_Salario AS VARCHAR(1000)
SET @Salario = $P{Salario}
SET @Texto_Salario = 'Salário de contribuição do cargo efetivo'

DECLARE @AP_def AS VARCHAR(1)
DECLARE @Texto_AP_def AS VARCHAR(1000)
SET @AP_def = $P{Concurso}
SET @Texto_AP_def = 'Se for o caso, laudos e/ou relatórios médicos admissionais incluindo avaliação admissional'



SELECT    TOP 1	 @numprot AS NUMPROT

				,@anoprot AS ANOPROT

				,FORMAT(SERVICOPESSOA.DT_SLCT_SERVPESSOA,'dd/MM/yyyy') AS DATA_SOLICITAÇAO

				,TIPOSERVICO.S_DCRSERV_TIPSERV AS BENEFICIO

				,TIPOBENEFICIO.S_DCR_TIPBNF AS [BENEFICIO DETALHADO]

				,(CASE	WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,32,41,42,43,57,66,91,99,100) THEN 'Aposentadoria'
						WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (6) THEN 'Abono de Permanência'
						WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (7,58) THEN 'Emissão de CTC'
						WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (21,88) THEN 'Pensão por Morte'
						WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (10) THEN 'Averbação de CTC'
						WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (64) THEN 'Contribuição Facultativa'
						WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (96) THEN 'Declaração de Implemento de regra de aposentadoria'
						ELSE 'DESCREVER O BENEFÍCIO'
						END) AS [DESCRIÇÃO BENEFÍCIO]

				,SERVICOPESSOA.N_PESSOA_PESSOA AS PESSOA
				,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRICULA
				,PESSOA.S_NOM_PESSOA AS NOME
				,@MUsuario AS MATRICULA_USUARIO_IPRESB
				,USUARIO_IPRESB.Nome AS USUARIO
				,USUARIO_IPRESB.Cargo AS CARGO_USUARIO
				
				,(CASE	ORGANIZACAOPESSOA.N_ORG_ORG 
						WHEN 1 THEN 'Secretaria de Administração / Div. Tec. Afast. E Controle de Inativo'
						WHEN 2 THEN 'Câmara Municipal de Barueri / Departamento de Recursos Humanos'
						WHEN 3 THEN 'FIEB / Departamento de Recursos Humanos'
						WHEN 4 THEN 'IPRESB / Unidade de Gestão de Administração'
						END) AS [DESTINATÁRIO]

				,(CASE @CTS WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,21,32,41,42,43,57,66,6,88,96,7,58,10,91,99,100) THEN @Texto_CTS ELSE null END) END) AS [CTS]
				,(CASE @Concurso WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,32,41,42,43,57,66,6,96,21,88,10,91,99,100)THEN @Texto_Concurso ELSE null END) END) AS [Concurso]
				,(CASE @PortNom WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,32,41,42,43,57,66,6,96,21,88,10,91,99,100) THEN @Texto_PortNom ELSE null END) END) AS [PORTARIA NOMEAÇÃO]
				,(CASE @FichaReg WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,32,41,42,43,57,66,6,96,21,88,10,91,99,100) THEN @Texto_FichaReg ELSE null END) END) AS [FICHA REGISTRO]
				,(CASE @Acumulo WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,32,41,42,43,57,66,6,96,21,88,10,91,99,100) THEN @Texto_Acumulo ELSE null END) END) AS [ACUMULO]
				,(CASE @DocsAdic WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,32,41,42,43,57,66,6,96,21,88,10,91,99,100) THEN @Texto_DocsAdic ELSE null END) END) AS [DOCS ADIC]
				,(CASE @Salario WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (21,88) THEN @Texto_Salario ELSE null END) END) AS [SALARIO]
				,(CASE @AP_def WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (91,99,100) THEN @Texto_AP_def ELSE null END) END) AS [AP_DEF]

				,(case when TIPOSERVICO.N_TIPSERV_TIPSERV IN (6) THEN NULL ELSE (CASE 
				ORGANIZACAOPESSOA.N_ORG_ORG WHEN 3 THEN 'Se o(a) servidor(a) está respondendo sindicância ou processo disciplinar, tendo em vista o Art. 174 da LC nº 277/2011' ELSE null end) END) as ente
				--,(CASE @Declaracao WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (21,88) THEN @Texto_Declaracao + 
				--		(CASE	ORGANIZACAOPESSOA.N_ORG_ORG 
				--		WHEN 1 THEN 'PMB'
				--		WHEN 2 THEN 'Câmara Municipal de Barueri'
				--		WHEN 3 THEN 'FIEB'
				--		WHEN 4 THEN 'IPRESB'
				--		END) ELSE null END) END) AS [DECLARACAO]
				,(CASE @InfAdic1 WHEN '' THEN null ELSE @InfAdic1 END) AS [InfAdic1]
				,(CASE @InfAdic2 WHEN '' THEN null ELSE @InfAdic2 END) AS [InfAdic2]
				,(CASE @InfAdic3 WHEN '' THEN null ELSE @InfAdic3 END) AS [InfAdic3]
				,(CASE @ProcAdm WHEN 'N' THEN null ELSE (CASE WHEN TIPOSERVICO.N_TIPSERV_TIPSERV IN (8,9,32,41,42,43,57,66,6,91,96) THEN @Texto_ProcAdm ELSE null END) END) AS [PROC ADM]


FROM            

				SERVICOPESSOA 
                INNER JOIN TIPOSERVICO ON SERVICOPESSOA.N_TIPSERV_TIPSERV = TIPOSERVICO.N_TIPSERV_TIPSERV 
				INNER JOIN ORGANIZACAOPESSOA ON SERVICOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA  
				AND SERVICOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
				INNER JOIN PESSOA ON ORGANIZACAOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA
				FULL OUTER JOIN TIPOBENEFICIO ON SERVICOPESSOA.N_TIPBNF_TIPBNF = TIPOBENEFICIO.N_TIPBNF_TIPBNF

--CONSULTA PARALELA PARA PUXAR DADOS DO USUÁRIO IPRESB
OUTER APPLY

				(SELECT        

								PESSOA_3.S_NOM_PESSOA
								,CARGO_3.S_DCR_CARGO

				FROM           
								PESSOA AS PESSOA_3
								INNER JOIN ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA 
								INNER JOIN CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA
								AND ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG
								INNER JOIN CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO

				WHERE        

								(ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario))
				
								USUARIO_IPRESB(Nome,Cargo)


WHERE 

SERVICOPESSOA.N_NUMPROT_SERVPESSOA = @numprot 
AND SERVICOPESSOA.N_ANOREFER_SERVPESSOA = @anoprot]]>
	</queryString>
