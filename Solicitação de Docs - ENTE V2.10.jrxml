	<detail>
		<band height="686" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="440" height="20" uuid="b8bcd072-e914-4d61-aece-41f7fcd0ccf8"/>
				<textElement textAlignment="Right" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="180" width="459" height="506" uuid="56f12c80-4e9d-4a33-8377-728873908f07"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.5"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>Ref.: Solicitação de documentos - "+ $F{DESCRIÇÃO BENEFÍCIO}+"</style><br/><br/>	Solicitamos deste órgão a documentação abaixo para darmos prosseguimento ao processo de <style isBold='true'>"+UPPER($F{DESCRIÇÃO BENEFÍCIO})+ "</style> do(a) servidor(a) <style isBold='true'>"+$F{NOME}+"</style>, matrícula <style isBold='true'>"+$F{MATRICULA}+"</style>.<br/><br/>"+($F{CTS} !=null ? ("\u2022   " +$F{CTS} + "<br/>"): "") +($F{Concurso} !=null ? ("\u2022   " +$F{Concurso} + "<br/>"): "")+($F{PORTARIA NOMEAÇÃO} !=null ? ("\u2022   " +$F{PORTARIA NOMEAÇÃO} + "<br/>"): "")+($F{FICHA REGISTRO} !=null ? ("\u2022   " +$F{FICHA REGISTRO} + "<br/>"): "")+($F{ACUMULO} !=null ? ("\u2022   " +$F{ACUMULO} + "<br/>"): "")+($F{DOCS ADIC} !=null ? ("\u2022   " +$F{DOCS ADIC} + "<br/>"): "")+($F{SALARIO}!=null ? ("\u2022   " +$F{SALARIO} + "<br/>"): "")+($F{ente}!=null ? ("\u2022   " +$F{ente}+ "<br/>"): "")+($F{InfAdic1}!=null ? ("\u2022   " +$F{InfAdic1} + "<br/>"): "")+($F{InfAdic2}!=null ? ("\u2022   " +$F{InfAdic2} + "<br/>"): "")+($F{InfAdic3}!=null ? ("\u2022   " +$F{InfAdic3} + "<br/>"): "")+"<br/><br/>Atenciosamente,<br/><br/><style isBold='true'>"+$F{USUARIO}+"<br/>Matrícula "+$F{MATRICULA_USUARIO_IPRESB}+"</style>"]]></textFieldExpression>
			</textField>
			<textField>
