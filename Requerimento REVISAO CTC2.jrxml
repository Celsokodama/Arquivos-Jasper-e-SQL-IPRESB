	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matricula" class="java.lang.String"/>
	<parameter name="Ente" class="java.lang.String"/>
	<parameter name="N_CTC" class="java.lang.String"/>
	<parameter name="DT_CTC" class="java.lang.String"/>
	<parameter name="EMISS_CTC" class="java.lang.String"/>
	<parameter name="MOTIVO_CTC" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @Matricula AS INTEGER
SET @Matricula = $P{Matricula}

DECLARE @Ente AS VARCHAR(2)
SET @Ente = $P{Ente}

DECLARE @N_CTC AS VARCHAR(30)
SET @N_CTC = $P{N_CTC}

DECLARE @DT_CTC AS VARCHAR(10)
SET @DT_CTC = $P{DT_CTC}

DECLARE @EMISS_CTC AS VARCHAR(100)
SET @EMISS_CTC = $P{EMISS_CTC}

DECLARE @MOTIVO_CTC AS VARCHAR(8000)
SET @MOTIVO_CTC = $P{MOTIVO_CTC}


SELECT			TOP 1

				P.S_NOM_PESSOA AS Nome,
	
				RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF,

				COP.N_CODORI_ORGPESSOA AS Matrícula,
				(CASE COP.N_ORG_ORG 
				WHEN 1 THEN 'Prefeitura Municipal de Barueri'
				WHEN 2 THEN 'Câmara Municipal de Barueri'
				WHEN 3 THEN 'FIEB'
				WHEN 4 THEN 'IPRESB'
				END)AS [ENTE],
				CARGO.S_DCR_CARGO AS Cargo,
				@N_CTC AS [NUMERO CTC],
				@DT_CTC AS [DATA EMISSAO CTC],
				@EMISS_CTC AS [EMISS_CTC],
				@MOTIVO_CTC AS [MOTIVO CTC]






FROM CARGOORGANIZACAOPESSOA COP
LEFT JOIN PESSOA P ON COP.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA
LEFT JOIN CARGO ON COP.N_CARGO_CARGO = CARGO.N_CARGO_CARGO AND COP.N_ORG_ORG = CARGO.N_ORG_ORG

WHERE COP.N_CODORI_ORGPESSOA = @Matricula AND COP.N_ORG_ORG = @Ente]]>
	</queryString>
