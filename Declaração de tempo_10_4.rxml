<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="454" leftMargin="85" rightMargin="56" topMargin="14" bottomMargin="0" uuid="d946ebe6-2e92-44c5-aed7-8f7380925278">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ASPPREV"/>
	<property name="com.jaspersoft.studio.unit." value="cm"/>
	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="MATR" class="java.lang.String"/>
	<parameter name="ENTE" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @MATR AS INT
DECLARE @ENTE AS INT
DECLARE @DInt as VARCHAR(30)

SET @MATR = $P{MATR}
SET @ENTE = $P{ENTE}
SET @DInt = $P{DInt}

--SET @MATR = 685
--SET @ENTE = 3
--SET @DInt = ''

		--SELECT *
		 --TEMPO DE CTC INSS
		(SELECT 
		P.S_NOM_PESSOA AS NOME, 
		BP.N_CODORI_ORGPESSOA AS MATRICULA,
		P.S_RG_PESSOA AS RG,
		substring(P.S_CPF_PESSOA,1,3)+'.'+substring(P.S_CPF_PESSOA,4,3)+'.'+substring(P.S_CPF_PESSOA,7,3)+'-'+substring(P.S_CPF_PESSOA,10,2) AS CPF,
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento],

		CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) AS DIB,
		T.S_DCR_TIPBNF AS BENEFICIO,
		CARGO.S_DCR_CARGO AS CARGO,
		CONVERT(VARCHAR(6),A.N_ATO_ASSENTANEXOCONCES) + '/' + CONVERT(VARCHAR(4),A.N_ANOREF_ASSENTANEXOCONCES) AS PORTARIA,
		COP.S_DCRORG_CARGOORGPESSOA AS EMPRESA, 
		CTC.INSS AS [NUM CTC],
		'INSS' AS [ORGAO EXPEDIDOR],
		COP.S_REGIME_REGIMETRAB AS REGIME,
		CONVERT(DATE,COP.DT_INIVIG_CARGOORGPESSOA) AS INICIO, 
		CONVERT(VARCHAR,COP.DT_INIVIG_CARGOORGPESSOA,103) AS INICIO2,

		CONVERT(DATE,COP.DT_FIMVIG_CARGOORGPESSOA) AS FIM,
		CONVERT(VARCHAR,COP.DT_FIMVIG_CARGOORGPESSOA,103) AS FIM2,

		CONVERT(VARCHAR,COP.DT_EMISSCTC_CARGOORGPESSOA,103) AS [DT_EMISSAO],

			--NOMENCLATURA DO CARGO DE GESTOR
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nomenclatura_Cargo 
							ELSE GESTOR_TITULAR.Nomenclatura_Cargo
							END) AS CARGO_DIRETOR,


				--NOME DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nome
							ELSE GESTOR_TITULAR.Nome
							END) AS NOME_DIRETOR,

				--CPF DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.CPF
							ELSE GESTOR_TITULAR.CPF
							END) AS CPF_GESTOR,

				--RG DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.RG
							ELSE GESTOR_TITULAR.RG
							END) AS RG_GESTOR,
							
				--NASCIMENTO DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nascimento
							ELSE GESTOR_TITULAR.Nascimento
							END) AS NASC_GESTOR
		

		FROM SIMULACAOBENEFICIOESPECIFICACAOPESSOA S2 
		INNER JOIN BENEFICIOPESSOA BP ON BP.N_CODORI_ORGPESSOA = S2.N_CODORI_ORGPESSOA AND BP.N_ORG_ORG = S2.N_ORG_ORG
		INNER JOIN TIPOBENEFICIO T ON BP.N_TIPBNF_TIPBNF = T.N_TIPBNF_TIPBNF
		INNER JOIN CARGOORGANIZACAOPESSOA COP ON COP.N_PESSOA_PESSOA = S2.N_PESSOA_PESSOA
		INNER JOIN CARGO ON CARGO.N_CARGO_CARGO = BP.N_CARGO_CARGO AND CARGO.N_ORG_ORG = BP.N_ORG_ORG
		LEFT JOIN ASSENTAMENTOANEXOCONCESSAO A ON A.N_PROT_BNFPESSOA = BP.N_PROT_BNFPESSOA AND A.N_TIPATO_TIPATO = 2
		LEFT JOIN PESSOA P ON S2.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA

		
OUTER APPLY

			--DADOS DO GESTOR TITULAR
			(SELECT
						(PESSOA.S_NOM_PESSOA) AS [NOME]
						
						,(CARGO.S_DCR_CARGO) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_TITULAR(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento)

OUTER APPLY

			--DADOS DO GESTOR INTERINO
			(SELECT
						PESSOA.S_NOM_PESSOA AS [NOME]
						
						,CARGO.S_DCR_CARGO AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]
			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_INTERINO(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento)

	
		OUTER APPLY
		(SELECT COP2.S_NUMCTFTEMPOCTB_CARGOORGPESSOA
		FROM CARGOORGANIZACAOPESSOA COP2
		WHERE COP2.N_PESSOA_PESSOA = COP.N_PESSOA_PESSOA AND COP2.S_REGIME_REGIMETRAB = 'G' AND COP2.S_NUMCTFTEMPOCTB_CARGOORGPESSOA IS NOT NULL) CTC(INSS)


		WHERE 
		S2.N_CODORI_ORGPESSOA = @MATR AND S2.N_ORG_ORG = @ENTE
		AND S2.N_PROT_BNFPESSOA IS NOT NULL AND BP.S_SITPGTO_BNFPESSOA = 1
		AND BP.N_TIPBNF_TIPBNF IN (1,2,3,4,5,6,14,17,107,1009)
		AND COP.S_REGIME_REGIMETRAB = 'G'
		AND COP.S_MRCUTICARGO_CARGOORGPESSOA = 'S'
		--AND COP.DT_ULTATLZ_CARGOORGPESSOA IS NOT NULL
		

		UNION 

		--TEMPO CTC ORGAO PUBLICO
		--SELECT *
		(SELECT 
		P.S_NOM_PESSOA AS NOME, 
		BP.N_CODORI_ORGPESSOA AS MATRICULA,
		P.S_RG_PESSOA AS RG,
		substring(P.S_CPF_PESSOA,1,3)+'.'+substring(P.S_CPF_PESSOA,4,3)+'.'+substring(P.S_CPF_PESSOA,7,3)+'-'+substring(P.S_CPF_PESSOA,10,2) AS CPF,
		CONVERT(VARCHAR,P.DT_NASC_PESSOA,103) AS [DataNascimento],
		CONVERT(VARCHAR,BP.DT_DIB_BNFPESSOA,103) AS DIB,
		T.S_DCR_TIPBNF AS BENEFICIO,
		CARGO.S_DCR_CARGO AS CARGO,
		CONVERT(VARCHAR(6),A.N_ATO_ASSENTANEXOCONCES) + '/' + CONVERT(VARCHAR(4),A.N_ANOREF_ASSENTANEXOCONCES) AS PORTARIA,
		COP.S_DCRORG_CARGOORGPESSOA AS EMPRESA, 
		CTC.NUMCTC AS [NUM CTC],
		CTC.ORGAOEXPEDIDOR AS [ORGAO EXPEDIDOR],
		COP.S_REGIME_REGIMETRAB AS REGIME,
		CTC.INICO AS INICIO, 
		CONVERT(VARCHAR,CTC.INICO,103) AS INICIO2,
		CTC.FIM AS FIM,
		CONVERT(VARCHAR,CTC.FIM,103) AS FIM2,
		CONVERT(VARCHAR,CTC.DT_EMISSAO,103) AS [DT_EMISSAO],
			--NOMENCLATURA DO CARGO DE GESTOR
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nomenclatura_Cargo 
							ELSE GESTOR_TITULAR.Nomenclatura_Cargo
							END) AS CARGO_DIRETOR,

				--NOME DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nome
							ELSE GESTOR_TITULAR.Nome
							END) AS NOME_DIRETOR,

				--CPF DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.CPF
							ELSE GESTOR_TITULAR.CPF
							END) AS CPF_GESTOR,

				--RG DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.RG
							ELSE GESTOR_TITULAR.RG
							END) AS RG_GESTOR,

				--NASCIMENTO DO GESTOR EM EXERCÍCIO
				(CASE		WHEN @DInt = UPPER('S') 
							THEN GESTOR_INTERINO.Nascimento
							ELSE GESTOR_TITULAR.Nascimento
							END) AS NASC_GESTOR
		

		FROM SIMULACAOBENEFICIOESPECIFICACAOPESSOA S2 
		INNER JOIN BENEFICIOPESSOA BP ON BP.N_CODORI_ORGPESSOA = S2.N_CODORI_ORGPESSOA AND BP.N_ORG_ORG = S2.N_ORG_ORG
		INNER JOIN TIPOBENEFICIO T ON BP.N_TIPBNF_TIPBNF = T.N_TIPBNF_TIPBNF
		INNER JOIN CARGOORGANIZACAOPESSOA COP ON COP.N_PESSOA_PESSOA = S2.N_PESSOA_PESSOA
		INNER JOIN CARGO ON CARGO.N_CARGO_CARGO = BP.N_CARGO_CARGO AND CARGO.N_ORG_ORG = BP.N_ORG_ORG
		LEFT JOIN ASSENTAMENTOANEXOCONCESSAO A ON A.N_PROT_BNFPESSOA = BP.N_PROT_BNFPESSOA AND A.N_TIPATO_TIPATO = 2
		LEFT JOIN PESSOA P ON S2.N_PESSOA_PESSOA = P.N_PESSOA_PESSOA


OUTER APPLY

			--DADOS DO GESTOR TITULAR
			(SELECT
						(PESSOA.S_NOM_PESSOA) AS [NOME]
						
						,(CARGO.S_DCR_CARGO) AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]

			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_TITULAR(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento)

OUTER APPLY

			--DADOS DO GESTOR INTERINO
			(SELECT
						PESSOA.S_NOM_PESSOA AS [NOME]
						
						,CARGO.S_DCR_CARGO AS [CARGO EFETIVO]

						,ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS [MATRÍCULA]

						,(CASE	WHEN PESSOA.S_SEXO_PESSOA = 'M' 
									THEN 'designado' 
									ELSE 'designada' 
									END) AS [GÊNERO]

						,AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT AS [NOMENCLATURA CARGO DIREÇÃO]

						,PESSOA.S_RG_PESSOA AS [RG]

						,RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS [CPF]

						,FORMAT(PESSOA.DT_NASC_PESSOA,'dd/MM/yyyy') AS [DATA NASCIMENTO]
			FROM

						PESSOA 
						INNER JOIN	ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA 
						INNER JOIN	CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA
								AND	CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA 
								AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG 
						INNER JOIN	CARGO ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG 
								AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO 
						INNER JOIN	AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA 
								AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG 
								AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA
						INNER JOIN	HISTORICOENDERECOPESSOA ON PESSOA.N_PESSOA_PESSOA = HISTORICOENDERECOPESSOA.N_PESSOA_PESSOA

			WHERE		AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5 AND HISTORICOENDERECOPESSOA.DT_FIMVIG_HISTENDPESSOA IS NULL)

			GESTOR_INTERINO(Nome,Cargo_Efetivo,Matrícula,Gênero,Nomenclatura_Cargo,RG,CPF,Nascimento)



		OUTER APPLY
		(SELECT 
		CTC_RPPS.NUM_CTCRPPS,
		CTC_RPPS.ORGAOEXPEDIDORCTCRPPS,
		CTC_RPPS.DT_EMISSAO,
		CONVERT(DATE,COP2.DT_INIVIG_CARGOORGPESSOA) AS INICIO,	
		CONVERT(DATE,COP2.DT_FIMVIG_CARGOORGPESSOA) AS FIM 
			
			FROM CARGOORGANIZACAOPESSOA COP2		

				--TERCIARIO
				OUTER APPLY
				(SELECT COP3.S_NUMCTFTEMPOCTB_CARGOORGPESSOA,
					COP3.S_ORGAOEXPEDCTC_CARGOORGPESSOA,
					COP3.DT_EMISSCTC_CARGOORGPESSOA
				FROM CARGOORGANIZACAOPESSOA COP3
				WHERE COP3.N_PESSOA_PESSOA = COP2.N_PESSOA_PESSOA AND COP3.S_REGIME_REGIMETRAB = 'P' AND COP3.S_DCRORG_CARGOORGPESSOA = COP2.S_DCRORG_CARGOORGPESSOA AND COP3.S_NUMCTFTEMPOCTB_CARGOORGPESSOA IS NOT NULL AND COP3.N_CODORI_ORGPESSOA IS NULL AND COP3.S_MRCUTICARGO_CARGOORGPESSOA = 'S') CTC_RPPS(NUM_CTCRPPS,ORGAOEXPEDIDORCTCRPPS,DT_EMISSAO)
			

		WHERE COP2.N_PESSOA_PESSOA = COP.N_PESSOA_PESSOA AND COP2.S_REGIME_REGIMETRAB = 'P' AND COP2.N_SEQ_CARGOORGPESSOA = COP.N_SEQ_CARGOORGPESSOA AND COP2.N_CODORI_ORGPESSOA IS NULL AND COP2.S_MRCUTICARGO_CARGOORGPESSOA = 'S') CTC(NUMCTC,ORGAOEXPEDIDOR,DT_EMISSAO,INICO,FIM)
		


		--MAIN
		WHERE 
		S2.N_CODORI_ORGPESSOA = @MATR AND S2.N_ORG_ORG = @ENTE
		AND S2.N_PROT_BNFPESSOA IS NOT NULL AND BP.S_SITPGTO_BNFPESSOA = 1
		AND BP.N_TIPBNF_TIPBNF IN (1,2,3,4,5,6,14,17,107,1009)
		AND COP.S_REGIME_REGIMETRAB = 'P' 
		AND COP.N_CODORI_ORGPESSOA IS NULL
		AND COP.S_MRCUTICARGO_CARGOORGPESSOA = 'S'
		
		))
		
		ORDER BY
		REGIME, INICIO, FIM]]>
	</queryString>
