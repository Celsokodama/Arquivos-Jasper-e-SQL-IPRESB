	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="NumProt" class="java.lang.String"/>
	<parameter name="AnoProt" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @numprot INTEGER
SET @numprot = $P{NumProt}

DECLARE @anoprot INTEGER
SET @anoprot = $P{AnoProt}

SELECT        TOP (1) @numprot AS NUMPROT, 
					  @anoprot AS ANOPROT, 
					  FORMAT(SERVICOPESSOA.DT_SLCT_SERVPESSOA, 'dd/MM/yyyy') AS DATA_SOLICITAÇAO, 
					  TIPOSERVICO.S_DCRSERV_TIPSERV AS BENEFICIO, 
                      SERVICOPESSOA.N_PESSOA_PESSOA AS PESSOA, 
					  CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRICULA, 
					  PESSOA.S_NOM_PESSOA AS NOME, 
					  PESSOA.S_RG_PESSOA AS RG, 
                      RTRIM(SUBSTRING(PESSOA.S_PISPASEP_PESSOA, 1, 3) + '.' + SUBSTRING(PESSOA.S_PISPASEP_PESSOA, 4, 5) + '.' + SUBSTRING(PESSOA.S_PISPASEP_PESSOA, 9, 2) + '-' + SUBSTRING(PESSOA.S_PISPASEP_PESSOA, 11, 1)) AS NIT, 
					  RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA, 1, 3) + '.' + SUBSTRING(PESSOA.S_CPF_PESSOA, 4, 3) + '.' + SUBSTRING(PESSOA.S_CPF_PESSOA, 7, 3) + '-' + SUBSTRING(PESSOA.S_CPF_PESSOA, 10, 2)) AS CPF, 
                      CONVERT(VARCHAR(11), CARGOORGANIZACAOPESSOA.DT_INIVIG_CARGOORGPESSOA, 103) AS ADMISSAO,
					  ORGANIZACAO.S_DCR_ORG AS ENTE,

					  SERVICOPESSOA.N_TIPSERV_TIPSERV AS TIPO,
					  (CASE SERVICOPESSOA.N_TIPSERV_TIPSERV WHEN 6 THEN 'ABONO'
					  WHEN 7 THEN 'CTC'
					  WHEN 8 THEN 'Revisão de AP'
					  WHEN 9 THEN 'Aposentadoria Especial'
					  WHEN 10 THEN 'Averbação de CTC'
					  WHEN 21 THEN 'Pensão por Morte'
					  WHEN 32 THEN 'AP. por Invalidez'
					  WHEN 41 THEN 'Aposentadoria'
					  WHEN 42 THEN 'Aposentadoria'
					  WHEN 43 THEN 'AP. Compulsória'
					  WHEN 57 THEN 'Aposentadoria'
					  WHEN 58 THEN 'Revisão de CTC' 
					  WHEN 59 THEN 'Extração de Cópias do Processo'
					  WHEN 60 THEN 'Extrato de Contribuições' 
					  WHEN 63 THEN 'Isenção de IR'
					  WHEN 66 THEN 'Aposentadoria Especial'
					  WHEN 64 THEN 'Contribuição Facultativa'
					  WHEN 90 THEN 'Comunicação Acum.'
					  WHEN 91 THEN 'Apos.  Especial Deficiente' END) AS DESCRICAO,
					  CARGO.S_DCR_CARGO AS CARGO

FROM            SERVICOPESSOA INNER JOIN
						ORGANIZACAOPESSOA ON SERVICOPESSOA.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND 
						SERVICOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN
						PESSOA ON SERVICOPESSOA.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
						TIPOSERVICO ON SERVICOPESSOA.N_TIPSERV_TIPSERV = TIPOSERVICO.N_TIPSERV_TIPSERV INNER JOIN
                        CARGOORGANIZACAOPESSOA ON SERVICOPESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND
						SERVICOPESSOA.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA INNER JOIN
                        ORGANIZACAO ON SERVICOPESSOA.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG  INNER JOIN CARGO ON
						 CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND
						 CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO

WHERE        (SERVICOPESSOA.N_NUMPROT_SERVPESSOA = @numprot) AND (SERVICOPESSOA.N_ANOREFER_SERVPESSOA = @anoprot)]]>
	</queryString>
