		<band height="701">
			<textField>
				<reportElement x="-15" y="194" width="131" height="76" uuid="8ee88470-b1ba-433d-bb45-fbd22390dcd4">
					<property name="com.jaspersoft.studio.unit.height" value="cm"/>
					<property name="com.jaspersoft.studio.unit.firstLineIndent" value="cm"/>
				</reportElement>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Top" markup="html">
					<font fontName="Times New Roman" size="8" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.2" leftIndent="5" rightIndent="5" spacingBefore="5"/>
				</textElement>
				<textFieldExpression><![CDATA[" DEPENDENTE<br><b>"+
($F{NOME DEP 1} !=null ? $F{NOME DEP 1} + "<br>" : "")+
($F{NOME DEP 2} !=null ? $F{NOME DEP 2} + "<br>" : "")+
($F{NOME DEP 3} !=null ? $F{NOME DEP 3} + "<br>" : "")+
($F{NOME DEP 4} !=null ? $F{NOME DEP 4} + "<br>" : "")+"</b>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="175" y="85" width="91" height="49" uuid="13d2a02d-fcda-4d2c-a12c-79a6ee310cb4">
