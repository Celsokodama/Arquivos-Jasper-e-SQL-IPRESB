		<band height="701">
			<textField>
				<reportElement x="-22" y="30" width="483" height="591" uuid="7a4e5094-44f2-4a5d-be08-650e75d532ba"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="11" isBold="false"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="0.9" spacingAfter="0"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>"+UPPER($F{NOME_PRESIDENTE})+"</style>"+$F{COND_PRESIDENTE}+" e <style isBold='true'>"+UPPER($F{NOME_DIRETOR})+"</style>"+$F{COND_DIRETOR}+", usando das atribuições que lhes são conferidas por lei;<br/><br/>"+

"Considerando que "+ $F{SEGURADO(A)}+" <style isBold='true'>"+$F{NOME}+",</style> "+$F{DESCRIÇÃO ATIVO APOSENTADO}+" da "+ $F{ENTE EXTENSO}+", no cargo efetivo de " + UPPER($F{CARGO})+", matrícula "+$F{MATRICULA}+", RG "+$F{RG}+", CPF "+$F{CPF}+", PIS/PASEP/NIT "+$F{NIT}+"<style isBold='true'>, faleceu em "+$F{DATA FALECIMENTO}+"</style>"+";<br/><br/>"+

"Considerando que "+$F{SEGURADO(A)} +" deixou na qualidade de dependente " +$F{PREFIXO DEPENDENTE 1}+" "+$F{PARANTESCO DEP 1}+", <style isBold='true'>"+$F{NOME DEP 1}+"</style>, "+$F{NASCIDO(A) DEPENDENTE 1}+" em "+$F{NASCIMENTO DEP 1}+", RG "+$F{RG DEP 1}+", CPF "+$F{CPF DEP 1}+", PIS/PASEP/NIT "+$F{PISPASEP DEP 1}+$F{DIVISOR 2}+ ($F{NOME DEP 2} !=null ? $F{PREFIXO DEPENDENTE 2}+" "+$F{PARANTESCO DEP 2}+", <style isBold='true'>"+$F{NOME DEP 2}+"</style>, "+$F{NASCIDO(A) DEPENDENTE 2}+" em "+$F{NASCIMENTO DEP 2}+", RG "+$F{RG DEP 2}+", CPF "+$F{CPF DEP 2}+", PIS/PASEP/NIT "+$F{PISPASEP DEP 2}: "")+$F{DIVISOR 3}+($F{NOME DEP 3} !=null ? $F{PREFIXO DEPENDENTE 3}+" "+$F{PARANTESCO DEP 3}+", <style isBold='true'>"+$F{NOME DEP 3}+"</style>, "+$F{NASCIDO(A) DEPENDENTE 3}+" em "+$F{NASCIMENTO DEP 3}+", RG "+$F{RG DEP 3}+", CPF "+$F{CPF DEP 3}+", PIS/PASEP/NIT "+$F{PISPASEP DEP 3}: "")+$F{DIVISOR 4}+($F{NOME DEP 4} !=null ? $F{PREFIXO DEPENDENTE 4}+" "+$F{PARANTESCO DEP 4}+", <style isBold='true'>"+$F{NOME DEP 4}+"</style>, "+$F{NASCIDO(A) DEPENDENTE 4}+" em "+$F{NASCIMENTO DEP 4}+", RG "+$F{RG DEP 4}+", CPF "+$F{CPF DEP 4}+", PIS/PASEP/NIT "+$F{PISPASEP DEP 4}: "")+";<br/><br/>"+

"Considerando o que consta no Processo Administrativo n° <style isBold='true'>" 

+$F{NUMPROC}
+($F{PROCESSO ADICIONAL 1} !=null ? (" / " + $F{PROCESSO ADICIONAL 1}): "")
+($F{PROCESSO ADICIONAL 2} !=null ? (" / " + $F{PROCESSO ADICIONAL 2}): "")

+"</style>"+", instruído com documentos pessoais, com informações do órgão de pessoal da "+$F{ENTE EXTENSO}+" e com parecer jurídico favorável à concessão do benefício da Pensão por Morte."

+"<br/><br/><style isBold='true'>RESOLVEM:</style><br/><br/>"

+"I - Conceder a <style isBold='true'>"+$F{LISTA DEPENDENTES}+"</style>"+", "+$F{DEPENDENTES PLURAL}+" de <style isBold='true'>"+$F{NOME}+"</style>, "+$F{SEGURADO(A) FALECIDO(A)}+" aos "+$F{DATA FALECIMENTO}+"<style isBold='true'>, PENSÃO POR MORTE</style>"+" no valor de <style isBold='true'>"+$F{PROVENTO TOTAL}+"</style> ("+$F{PROVENTO EXTENSO}+") mensais, nos termos do artigo 72 e seguintes da Lei Complementar n° 434, de 14 de agosto de 2018.<br/><br/>"+

$F{INCISO II}+"<br/><br/>"+
($F{INCISO III} !=null ? $F{INCISO III} + "<br/><br/>" : "") +
$F{NUMERACAO INCISO IV}+$F{DESCRIÇÃO INCISO IV}+"<br/><br/>"+
$F{NUMERACAO INCISO V}+$F{DESCRIÇÃO INCISO V}+"<br/><br/>"+
$F{NUMERACAO INCISO VI}+$F{DESCRIÇÃO INCISO VI}+"<br/><br/>"+
$F{NUMERACAO INCISO VII}+$F{DESCRIÇÃO INCISO VII} +
($F{DESCRIÇÃO INCISO xx} !=null ? "<br/><br/>" + $F{DESCRIÇÃO INCISO xx} : "")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-22" y="621" width="483" height="24" uuid="86f43020-0f33-4919-940a-407f6a71c5a7"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+$F{DATA HOJE EXTENSO}+"."]]></textFieldExpression>
			</textField>
