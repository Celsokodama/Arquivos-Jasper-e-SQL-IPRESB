	<detail>
		<band height="672" splitType="Stretch">
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="269" width="454" height="60" uuid="70f5347a-482c-4ceb-859a-0c3da00b9ede"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["I - Deferir a <style isBold='true'>"+$F{NOME}+"</style>"+", "+"portador(a) do <style isBold='true'>"+"RG "+ $F{RG}+"</style>"+", titular do cargo efetivo de <style isBold='true'>"+UPPER($F{CARGO})+"</style>"+" na "+$F{ENTE}+", matrícula funcional nº <style isBold='true'>"+$F{MATRICULA SERV}+"</style>"+", a <style isUnderline='true'>"+"AVERBAÇÃO"+"</style>"+" para efeito de aposentadoria, conforme o tempo de contribuição abaixo discriminado:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="239" width="454" height="24" uuid="f16190e1-609e-4654-8c7c-c65b43ed1dfd"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["RESOLVEM:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="0" width="454" height="24" uuid="af6ef8b8-a6ab-4252-89ca-6cd8be9b7c9c"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["PORTARIA Nº "+$F{PORTARIA}+", DE "+UPPER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="20" y="399" width="434" height="68" uuid="29e97f8c-691b-4b48-8af9-5e4a200e4c82"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["b) XX anos, XX meses e XX dias ou X.XXX (Extenso) dias correspondentes ao(s) período(s) de XX/XX/XXXX a XX/XX/XXXX, conforme Certidão Original de Tempo de Contribuição nº XXXXXX/XXXX, emitida em XX/XX/XXXX pelo Governo do Estado de São Paulo - Secretaria de Estado da Educação e homologada em XX/XX/XXXX pelo SPPREV."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="257" y="630" width="197" height="15" uuid="d3790161-3bcc-42ef-8baa-90c07f83bb8a"/>
				<box>
					<topPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{NOME_PRESIDENTE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="645" width="232" height="15" uuid="10665b3a-d22f-432f-9e4e-6635fd033841"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CARGO_DIRETOR}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="30" width="452" height="208" uuid="19227461-9db7-4c45-89c5-9f3da1511014"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true'>"+$F{NOME_PRESIDENTE}+"</style>"+$F{COND_PRESIDENTE}+", e <style isBold='true'>"+$F{NOME_DIRETOR}+"</style>"+$F{COND_DIRETOR}+", usando das atribuições que lhes são conferidas por lei, e;<br/><br/>"+"Considerando os termos do art. 119 da Lei Complementar nº 434, de 14 de agosto de 2018;<br/><br/>"+"Considerando o que consta no Processo Administrativo n° <style isBold='true'>" +$F{NUMPROC}+"</style>"+", instruído com documentos pessoais, com informações do órgão de pessoal da "+$F{ENTE}+" e com a Certidão Original de Tempo de Contribuição do XXXXXXX e do XXXXXX."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="560" width="454" height="24" uuid="fb335e17-988e-4f19-9a0a-50744917c9f4"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="479" width="454" height="30" uuid="a0927551-764a-43da-a40c-cc9ed0d7530e"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["II - Esta portaria entrará em vigor na data de sua publicação;"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="630" width="232" height="15" uuid="86f6f9c3-0697-4cc9-bf2b-51245a98b93c"/>
				<box>
					<topPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{NOME_DIRETOR}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="509" width="454" height="30" uuid="96a87787-6c32-4f61-b7c1-afa8df8341b8"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["III - Publique-se e cumpra-se a presente Portaria."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement x="20" y="329" width="434" height="70" uuid="1466dbe8-d321-4276-87bf-14d32856d523"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" markup="styled">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["a) XX anos, XX meses e XX dias ou X.XXX (Extenso) dias correspondentes ao(s) período(s) de XX/XX/XXXX a XX/XX/XXXX, conforme Certidão Original de Tempo de Contribuição nº XXXXXXXX.X.XXXXX/XX-X, emitida em XX/XX/XXXX pelo Instituto Nacional do Seguro Social - INSS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="257" y="645" width="197" height="15" uuid="ec5dbc43-4b54-43dd-a5b4-b3d561c37e4e"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false"/>
