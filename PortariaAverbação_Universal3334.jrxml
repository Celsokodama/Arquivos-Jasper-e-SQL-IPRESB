	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matricula" class="java.lang.String"/>
	<parameter name="Organiz" class="java.lang.String"/>
	<parameter name="Portaria" class="java.lang.String"/>
	<parameter name="NumProc" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<parameter name="PInt" class="java.lang.String"/>
	<parameter name="PortDInt" class="java.lang.String"/>
	<parameter name="PortPInt" class="java.lang.String"/>
	<parameter name="Ano" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT        PESSOA.S_NOM_PESSOA AS NOME, ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRICULA, C.S_DCR_CARGO AS CARGO, PESSOA.S_RG_PESSOA AS RG, PESSOA.S_CPF_PESSOA AS CPF, 
                         PESSOA.S_PISPASEP_PESSOA AS NIT, CONVERT(VARCHAR(11), PESSOA.DT_NASC_PESSOA, 103) AS NASCIMENTO, PESSOA.S_NOMMAE_PESSOA AS [NOME MAE], CONVERT(VARCHAR(11), 
                         COP.DT_INIVIG_CARGOORGPESSOA, 103) AS ADMISSAO, ORGANIZACAO.S_DCR_ORG AS ENTE, $P{Portaria} AS [PORTARIA],$P{Matricula} AS [MATRICULA SERV], $P{Ano} AS [Ano], $P{NumProc} AS [NUM PROCESSO],
              (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) AS [DIRETOR INTERINO], 
			  (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4)) AS [PRESIDENTE INTERINO],
			  (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) AS [CARGO DO DIRETOR INTERINO], 
			  (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4)) AS [CARGO DO PRESIDENTE INTERINO],
			  (SELECT CONVERT(VarChar(5), ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) AS [MATRICULA DO DIRETOR INTERINO], 
			  (SELECT CONVERT(VarChar(5), ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4)) AS [MATRICULA DO PRESIDENTE INTERINO],
			  (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) AS [NOMENCLATURA DO DIRETOR INTERINO], 
			  (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(AUTORIDADECOMPETENTE.S_DCRCARGO_AUTDCOMPTT)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4)) AS [NOMENCLATURA DO PRESIDENTE INTERINO],
			  (SELECT CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'designado' ELSE 'designada' END FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) AS [GENERO DO DIRETOR INTERINO], 
			  (SELECT CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'designado' ELSE 'designada' END FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4)) AS [GENERO DO PRESIDENTE INTERINO],
			  (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2)) AS DIRETOR, 
			  (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 3)) AS PRESIDENTE,
			  (CASE WHEN $P{DInt} = UPPER('S') THEN ', '+(SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5))+', matrícula '+(SELECT CONVERT(VarChar(5), ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5))+', desempenhando, interinamente, as funções do cargo de Gestor de Benefícios Previdenciários, conforme a portaria n.º '+$P{PortDInt} ELSE ', Gestor de Benefícios Previdenciários' END) AS COND_DIRETOR,
			  (CASE WHEN $P{PInt} = UPPER('S') THEN ', '+(SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(CARGO.S_DCR_CARGO)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4))+', matrícula '+(SELECT CONVERT(VarChar(5), ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4))+', desempenhando, interinamente, as funções de Presidente do IPRESB - Instituto de Previdência Social dos Servidores Municipais de Barueri, conforme a portaria n.º '+$P{PortPInt} ELSE ', Presidente do IPRESB - Instituto de Previdência Social dos Servidores Municipais de Barueri' END) AS COND_PRESIDENTE,
			  (CASE WHEN $P{DInt} = UPPER('S') THEN 'Gestor Interino de Benefícios Previdenciários' ELSE 'Gestor de Benefícios Previdenciários' END) AS CARGO_DIRETOR,
			  (CASE WHEN $P{PInt} = UPPER('S') THEN 'Presidente Interino(a)' ELSE 'Presidente' END) AS CARGO_PRESIDENTE,
			  (CASE WHEN $P{DInt} = UPPER('S') THEN (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) ELSE (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2)) END) AS NOME_DIRETOR,
			  (CASE WHEN $P{PInt} = UPPER('S') THEN (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 4)) ELSE (SELECT PESSOA.S_NOM_PESSOA FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 3)) END) AS NOME_PRESIDENTE,
			  (CASE WHEN $P{Ano} <=2018 THEN 'BI-'+ $P{NumProc} + '/' + $P{Ano} ELSE 'PA-'+ $P{NumProc} + '/' + $P{Ano} END) AS NUMPROC             
			              
FROM            PESSOA INNER JOIN
                         ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA AS COP ON COP.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND COP.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND 
                         COP.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN
                         CARGO AS C ON C.N_ORG_ORG = COP.N_ORG_ORG AND C.N_CARGO_CARGO = COP.N_CARGO_CARGO INNER JOIN
                         ORGANIZACAO ON ORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG
WHERE        (ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = $P{Matricula}) AND (ORGANIZACAOPESSOA.N_ORG_ORG = $P{Organiz}) AND (COP.N_VINC_CARGOORGPESSOA = 2) AND (COP.DT_FIMVIG_CARGOORGPESSOA IS NULL) AND 
                         (COP.N_SEQ_CARGOORGPESSOA =
                             (SELECT        MAX(N_SEQ_CARGOORGPESSOA) AS Expr1
                               FROM            CARGOORGANIZACAOPESSOA AS COP2
                               WHERE        (N_PESSOA_PESSOA = COP.N_PESSOA_PESSOA) AND (N_VINC_CARGOORGPESSOA = 2) AND (DT_FIMVIG_CARGOORGPESSOA IS NULL)))]]>
	</queryString>
