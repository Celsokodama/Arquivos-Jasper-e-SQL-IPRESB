				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{ENTE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="384" y="0" width="80" height="45" uuid="2f070d3c-e686-47fe-8180-7141207f6eea"/>
