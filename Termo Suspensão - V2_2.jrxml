				<textElement textAlignment="Justified" markup="html">
					<font fontName="Arial" size="12"/>
					<paragraph firstLineIndent="28" leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Conforme solicitação, informamos que o processo: " + $F{PROTOCOLO} + " terá a tramitação suspensa por 30 dias, prorrogáveis por igual período, conforme o § 1º do Art. 96 da Resolução nº 40, de 02 de agosto de 2019 (Regulamento do RPPS)." + "<br>" +"Decorrido esse prazo sem manifestação de sua parte, o processo será arquivado."]]></textFieldExpression>
