	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="848c67d2-d15a-4bee-a03e-4616d865bbac">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matricula" class="java.lang.String"/>
	<parameter name="Organiz" class="java.lang.String"/>
	<parameter name="admEnte" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[DECLARE @MUsuario as VARCHAR(30)
SET @MUsuario = $P{MUsuario}

SELECT        PESSOA.S_NOM_PESSOA AS NOME, 
		ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRICULA, 
		C.S_DCR_CARGO AS CARGO, 
		PESSOA.S_RG_PESSOA AS RG, 
		PESSOA.S_CPF_PESSOA AS CPF, 
        PESSOA.S_PISPASEP_PESSOA AS NIT, 
        CONVERT(VARCHAR(11), PESSOA.DT_NASC_PESSOA, 103 ) AS NASCIMENTO, 
        PESSOA.S_NOMMAE_PESSOA AS [NOME MAE], 
        CONVERT(VARCHAR(11),  COP.DT_INIVIG_CARGOORGPESSOA, 103) AS ADMISSAO,  
        $P{admEnte} AS [ADMISSAO ENTE], 
        ORGANIZACAO.S_DCR_ORG AS ENTE,
        	--NOME DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				USUARIO_IPRESB.Nome AS USUARIO,

				--CARGO DO USUÁRIO DO IPRESB RESPONSÁVEL PELO DOCUMENTO
				USUARIO_IPRESB.Matricula AS MATRICULAipresb
        
        
        
FROM            PESSOA INNER JOIN
                         ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA AS COP ON COP.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND COP.N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND 
                         COP.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN
                         CARGO AS C ON C.N_ORG_ORG = COP.N_ORG_ORG AND C.N_CARGO_CARGO = COP.N_CARGO_CARGO INNER JOIN
                         ORGANIZACAO ON ORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAO.N_ORG_ORG
                         
                         
OUTER APPLY
	
				(SELECT        

								dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA_3.S_NOM_PESSOA)),
								 ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA

				FROM           
								PESSOA AS PESSOA_3
								INNER JOIN ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA 
								INNER JOIN CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA
								AND ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG
								INNER JOIN CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO

				WHERE        

								(ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario))
				
								USUARIO_IPRESB(Nome,Matricula)
                         
WHERE        (ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = $P{Matricula}) 
					AND (ORGANIZACAOPESSOA.N_ORG_ORG = $P{Organiz})
					AND (COP.DT_FIMVIG_CARGOORGPESSOA IS NULL) 


AND 
                         (COP.N_SEQ_CARGOORGPESSOA =
                             (SELECT        MAX(N_SEQ_CARGOORGPESSOA) AS Expr1
                               FROM            CARGOORGANIZACAOPESSOA AS COP2
                               WHERE        (N_PESSOA_PESSOA = COP.N_PESSOA_PESSOA) AND (N_VINC_CARGOORGPESSOA = 2) AND (DT_FIMVIG_CARGOORGPESSOA IS NULL)))]]>
	</queryString>
