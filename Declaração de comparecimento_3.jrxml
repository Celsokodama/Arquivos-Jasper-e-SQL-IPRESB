				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Assunto: Declaração de comparecimento"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-6" y="7" width="452" height="20" uuid="0da0edad-cdb1-43da-928a-95b26f124fce"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Barueri, "+LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy")+".")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-6" y="148" width="454" height="81" uuid="5a1c0d09-f656-4ce0-ace5-c8cdec449a56">
					<property name="com.jaspersoft.studio.unit.leftIndent" value="cm"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph firstLineIndent="85"/>
				</textElement>
				<textFieldExpression><![CDATA["Declaro para os devidos fins que " + $F{GENERO} + $F{NOME} +", CPF: "+$F{CPF}  + ", compareceu ao IPRESB das " + $F{Hinicial} + " às " + $F{Hfinal}+" " + $F{ASSUNTO} +  $F{Assunto2}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-6" y="63" width="454" height="20" uuid="07678fd2-d957-4a8f-9736-6f812a92d96e"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Interessado(a): "+$F{NOME}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="-6" y="229" width="451" height="30" uuid="fbb607c6-c864-47a5-8586-f95d45999a88"/>
				<textElement>
					<font fontName="Times New Roman" size="12"/>
					<paragraph firstLineIndent="85"/>
				</textElement>
				<text><![CDATA[Colocamo-nos à disposição para mais informações.]]></text>
			</staticText>
			<staticText>
				<reportElement x="-2" y="280" width="451" height="30" uuid="b6f38208-45fa-4038-af63-3e65ecea3653"/>
				<textElement>
					<font fontName="Times New Roman" size="12"/>
					<paragraph firstLineIndent="14"/>
				</textElement>
				<text><![CDATA[Atenciosamente,]]></text>
			</staticText>
			<textField>
