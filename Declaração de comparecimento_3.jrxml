	<subDataset name="Logo" uuid="e9f90e01-6f3f-44b6-9906-95c12f91afd0">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<queryString language="SQL">
			<![CDATA[Select  IMG_IMGFUNDO_IMGORG
 from dbo."IMAGEMORGANIZACAO"  
 where  "N_ORG_ORG" = 42]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<subDataset name="Rodape" uuid="6faeb3da-4b82-4ebb-bf15-6b631cf2c980">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IPRESB"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<queryString>
			<![CDATA[Select dbo."IMAGEMORGANIZACAO"."IMG_IMGFUNDO_IMGORG" 
 from dbo."IMAGEMORGANIZACAO" 
 where  dbo."IMAGEMORGANIZACAO"."N_ORG_ORG" = 43]]>
		</queryString>
		<field name="IMG_IMGFUNDO_IMGORG" class="java.awt.Image"/>
	</subDataset>
	<parameter name="Matr" class="java.lang.String"/>
	<parameter name="Ente" class="java.lang.String"/>
	<parameter name="Assunto" class="java.lang.String"/>
	<parameter name="Hinicial" class="java.lang.String"/>
	<parameter name="Hfinal" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<parameter name="Assunto2" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[--Matrícula servidor
DECLARE @Matr as VARCHAR(30)
SET @Matr = $P{Matr}

--Ente servidor
DECLARE @Ente as VARCHAR(30)
SET @Ente = $P{Ente}

--Horário Inicial
DECLARE @Hinicial as VARCHAR(30)
SET @Hinicial = $P{Hinicial}

--Horário Final
DECLARE @Hfinal as VARCHAR(30)
SET @Hfinal = $P{Hfinal}

--Assunto
DECLARE @Assunto as VARCHAR(30)
SET @Assunto = $P{Assunto}

--Assunto2
DECLARE @Assunto2 as VARCHAR(1000)
SET @Assunto2 = $P{Assunto2}

--Usuario IPRESB
DECLARE @MUsuario INT
SET @MUsuario = $P{MUsuario}

SELECT 

P.S_NOM_PESSOA AS NOME,
P.S_RG_PESSOA AS RG,
	--CPF
				RTRIM(SUBSTRING(P.S_CPF_PESSOA,1,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,4,3)
				+'.'
				+SUBSTRING(P.S_CPF_PESSOA,7,3)
				+'-'
				+SUBSTRING(P.S_CPF_PESSOA,10,2)) AS CPF,


(CASE P.S_SEXO_PESSOA
WHEN 'M' THEN 'o senhor '
WHEN 'F' THEN 'a senhora '
END) AS [GENERO],

(CASE @Assunto
WHEN '1' THEN 'para tratar de sua aposentadoria.'
WHEN '2' THEN 'para realizar a perícia médica.'
WHEN '3' THEN 'para tratar sobre pensão por morte.'
WHEN '4' THEN ' '
END) AS [ASSUNTO],



@MUsuario AS MATRICULAIPRESB,
@HInicial AS [Hinicial],
@HFinal AS [Hfinal],
@Assunto2 AS [Assunto2],

  (SELECT        PESSOA_3.S_NOM_PESSOA AS USUARIO
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS USUARIO,
                             (SELECT       CARGO_3.S_DCR_CARGO AS [CARGO USUARIO]
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS CARGO_USUARIO




FROM 
PESSOA AS P
INNER JOIN ORGANIZACAOPESSOA ON P.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA

WHERE 
ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @Matr 
AND ORGANIZACAOPESSOA.N_ORG_ORG = @Ente]]>
	</queryString>
