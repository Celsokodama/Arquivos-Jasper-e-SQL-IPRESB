	</subDataset>
	<parameter name="Matricula" class="java.lang.String"/>
	<parameter name="Organiz" class="java.lang.String"/>
	<parameter name="MUsuario" class="java.lang.String"/>
	<parameter name="DInt" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SET LANGUAGE Português

USE aspprev2_baruerisp_prd

--Variável para declarar a matrícula
DECLARE @matricula INT
SET @matricula = $P{Matricula}

--Variável para declarar o ente
DECLARE @ente INT
SET @ente = $P{Organiz}

DECLARE @MUsuario INT
SET @MUsuario = $P{MUsuario}

DECLARE @DInt varchar
SET @DInt = $P{DInt}



----Variável para declarar a matrícula
--DECLARE @matricula INT
--SET @matricula = 1301

----Variável para declarar o ente
--DECLARE @ente INT
--SET @ente = 3

--DECLARE @MUsuario INT
--SET @MUsuario = 96

--DECLARE @DInt varchar
--SET @DInt = ''

--Variável para declarar as faltas
DECLARE @faltas_simplificado365	INT
SET @faltas_simplificado365 = 			ISNULL((select SUM((CONVERT (INT,SITUACAOFUNCIONAL.DT_FIMVIG_SITFUNC-SITUACAOFUNCIONAL.DT_INIVIG_SITFUNC+1))) 
										FROM SITUACAOFUNCIONAL INNER JOIN
										CARGOORGANIZACAOPESSOA ON SITUACAOFUNCIONAL.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
										SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA 
										WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' AND SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND (SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 12 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 13 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 261 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 6 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 904 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 908)),0)


DECLARE @faltas_ANO INT
SET @faltas_ANO =		ISNULL((SELECT SUM((CONVERT (INT,(dbo.FN_CALCULARDIFDIASINSSANO(SITUACAOFUNCIONAL.DT_INIVIG_SITFUNC,SITUACAOFUNCIONAL.DT_FIMVIG_SITFUNC,360))))) 
						 FROM SITUACAOFUNCIONAL INNER JOIN
                         CARGOORGANIZACAOPESSOA ON SITUACAOFUNCIONAL.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA 
						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P'AND SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND (SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 12 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 13 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 261 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 6 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 904 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 908)),0)


DECLARE @faltas_MES INT
SET @faltas_MES =		ISNULL((SELECT SUM((CONVERT (INT,(dbo.FN_CALCULARDIFDIASINSSMES(SITUACAOFUNCIONAL.DT_INIVIG_SITFUNC,SITUACAOFUNCIONAL.DT_FIMVIG_SITFUNC,360))))) 
						 FROM SITUACAOFUNCIONAL INNER JOIN
                         CARGOORGANIZACAOPESSOA ON SITUACAOFUNCIONAL.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA 
						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' AND SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND (SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 12 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 13 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 261 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 6 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 904 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 908)),0)


DECLARE @faltas_DIA INT
SET @faltas_DIA =		ISNULL((SELECT SUM((CONVERT (INT,(dbo.FN_CALCULARDIFDIASINSSDIA(SITUACAOFUNCIONAL.DT_INIVIG_SITFUNC,SITUACAOFUNCIONAL.DT_FIMVIG_SITFUNC,360))))) 
						 FROM SITUACAOFUNCIONAL INNER JOIN
                         CARGOORGANIZACAOPESSOA ON SITUACAOFUNCIONAL.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA 
						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' AND SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND (SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 12 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 13 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 261 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 6 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 904 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 908)),0)


DECLARE @faltas INT
SET @faltas = (@faltas_ANO*365)+(@faltas_MES*30)+(@faltas_DIA)

--PARA FINS DE CÁLCULO
DECLARE @faltas360 INT
SET @faltas360 = (@faltas_ANO*360)+(@faltas_MES*30)+(@faltas_DIA)


--Variável para declarar as faltas
DECLARE @diastotais INT
SET @diastotais =		(SELECT TOP 1 TEMPOSERVICOCALCULADO.N_TOTDIAS_TEMPOSERVCALC
						 
						 FROM  
						 
						 TEMPOSERVICOCALCULADO INNER JOIN
                         PESSOA ON TEMPOSERVICOCALCULADO.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA ON TEMPOSERVICOCALCULADO.N_PESSOACARGO_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         TEMPOSERVICOCALCULADO.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND 
                         PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA

						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' AND S_RESPTEMPO_TEMPOSERVCALC = 'I' AND N_ORG_ORG = @ente
						 
						 ORDER BY N_SEQ_SIMULBNFEPFPESSOA DESC)

--Variável para declarar as faltas
DECLARE @ANOdiastotais INT
SET @ANOdiastotais =		(SELECT TOP 1 TEMPOSERVICOCALCULADO.N_ANO_TEMPOSERVCALC
						 
						 FROM  
						 
						 TEMPOSERVICOCALCULADO INNER JOIN
                         PESSOA ON TEMPOSERVICOCALCULADO.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA ON TEMPOSERVICOCALCULADO.N_PESSOACARGO_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         TEMPOSERVICOCALCULADO.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND 
                         PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA

						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' AND S_RESPTEMPO_TEMPOSERVCALC = 'I' AND N_ORG_ORG = @ente
						 
						 ORDER BY N_SEQ_SIMULBNFEPFPESSOA DESC)

						 --Variável para declarar as faltas
DECLARE @MESdiastotais INT
SET @MESdiastotais =		(SELECT TOP 1 TEMPOSERVICOCALCULADO.N_MES_TEMPOSERVCALC
						 
						 FROM  
						 
						 TEMPOSERVICOCALCULADO INNER JOIN
                         PESSOA ON TEMPOSERVICOCALCULADO.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA ON TEMPOSERVICOCALCULADO.N_PESSOACARGO_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         TEMPOSERVICOCALCULADO.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND 
                         PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA

						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' AND S_RESPTEMPO_TEMPOSERVCALC = 'I' AND N_ORG_ORG = @ente
						 
						 ORDER BY N_SEQ_SIMULBNFEPFPESSOA DESC)

--Variável para declarar as faltas
DECLARE @DIASdiastotais INT
SET @DIASdiastotais =		(SELECT TOP 1 TEMPOSERVICOCALCULADO.N_DIA_TEMPOSERVCALC
						 
						 FROM  
						 
						 TEMPOSERVICOCALCULADO INNER JOIN
                         PESSOA ON TEMPOSERVICOCALCULADO.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA ON TEMPOSERVICOCALCULADO.N_PESSOACARGO_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         TEMPOSERVICOCALCULADO.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND 
                         PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA

						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND CARGOORGANIZACAOPESSOA.S_REGIME_REGIMETRAB = 'P' AND S_RESPTEMPO_TEMPOSERVCALC = 'I' AND N_ORG_ORG = @ente
						 
						 ORDER BY N_SEQ_SIMULBNFEPFPESSOA DESC)

--Variável para declarar os dias líquidos
DECLARE @diastotaisliq360 FLOAT
SET @diastotaisliq360 = ((360*@ANOdiastotais)+(30*@MESdiastotais)+@DIASdiastotais)-@faltas360

--Variável para declarar os anos líquidos
DECLARE @anosliq360 FLOAT
SET @anosliq360 = ROUND(@diastotaisliq360/360,0,1)

--Variável para declarar os meses líquidos
DECLARE @mesliq360 FLOAT
SET @mesliq360 = ROUND(((@diastotaisliq360/360)-ROUND(@diastotaisliq360/360,0,1))*360/30,0,1)

--Variável para declarar os meses líquidos
DECLARE @diasliq360 FLOAT
SET @diasliq360 = ROUND((((@diastotaisliq360/360)-ROUND(@diastotaisliq360/360,0,1))*360/30-(ROUND(((@diastotaisliq360/360)-ROUND(@diastotaisliq360/360,0,1))*360/30,0,1)))*30,0)

--365 SÓ PARA MOSTRAR NO RESULTADO FINAL, TODOS OS CÁLCULOS PRECISAM SER FEITOS COM 360 DIAS
DECLARE @diastotaisliq365 FLOAT
SET @diastotaisliq365 = (365*@anosliq360)+(30*@mesliq360)+@diasliq360


--Variável para declarar os dias líquidos
DECLARE @diastotaisliq FLOAT
SET @diastotaisliq = @diastotais - @faltas

--Variável para declarar os anos líquidos
DECLARE @anosliq FLOAT
SET @anosliq = ROUND(@diastotaisliq/365,0,1)

--Variável para declarar os meses líquidos
DECLARE @mesliq FLOAT
SET @mesliq = ROUND(((@diastotaisliq/365)-ROUND(@diastotaisliq/365,0,1))*365/30,0,1)

--Variável para declarar os meses líquidos
DECLARE @diasliq FLOAT
SET @diasliq = ROUND((((@diastotaisliq/365)-ROUND(@diastotaisliq/365,0,1))*365/30-(ROUND(((@diastotaisliq/365)-ROUND(@diastotaisliq/365,0,1))*365/30,0,1)))*30,0)

SELECT        TOP 1		 TEMPOSERVICOCALCULADO.N_PESSOA_PESSOA AS NUMPESSOA, 
						 CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AS MATRICULA, 
						 TEMPOSERVICOCALCULADO.N_SEQ_SIMULBNFEPFPESSOA AS SIMULACAO, 
                         TEMPOSERVICOCALCULADO.N_TOTDIAS_TEMPOSERVCALC AS DIASTOTAL,
						 @ANOdiastotais AS ANO_DIASTOTAL,
						 @MESdiastotais AS MES_DIASTOTAL,
						 @DIASdiastotais AS DIA_MESTOTAL,
                         (SELECT min(COP.DT_INIVIG_CARGOORGPESSOA )
						 FROM CARGOORGANIZACAOPESSOA COP
						 WHERE COP.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND COP.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND COP.S_REGIME_REGIMETRAB = 'P'
						 )AS DATAINICIOIPRESB,


						 (CASE WHEN TEMPOSERVICOCALCULADO.DT_FIMVIGCARGO_TEMPOSERVCALC IS NULL THEN 'a presente data'
						 ELSE CONVERT(VARCHAR,TEMPOSERVICOCALCULADO.DT_FIMVIGCARGO_TEMPOSERVCALC,103) END) AS DATAFIMIPRESB,


						 TEMPOSERVICOCALCULADO.S_RESPTEMPO_TEMPOSERVCALC, 
                         PESSOA.S_NOM_PESSOA AS NOME, 
						 PESSOA.S_SEXO_PESSOA AS SEXO, 
						 PESSOA.S_RG_PESSOA AS RG, 
						 RTRIM(SUBSTRING(PESSOA.S_CPF_PESSOA,1,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,4,3)
						+'.'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,7,3)
						+'-'
						+SUBSTRING(PESSOA.S_CPF_PESSOA,10,2)) AS CPF,
                         PESSOA.S_PISPASEP_PESSOA AS PIS, 
						 CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA, 
						 CARGOORGANIZACAOPESSOA.N_ORG_ORG, 
                         CARGO.S_DCR_CARGO AS CARGO, 
						 @MUsuario AS MATRICULAIPRESB,

						 @faltas AS FALTAS,

						 @faltas_ANO AS [FALTAS ANOS],

						 @faltas_MES AS [FALTAS MESES],

						 @faltas_DIA AS [FALTAS DIAS],

 						 CONVERT(int,@diastotaisliq) AS DIASTOTALLIQ,
						 CONVERT(int,@diastotaisliq365) AS DIASTOTALLIQ365,
						 CONVERT(int,@anosliq360) AS ANOLIQ360,
						 CONVERT(int,@mesliq360) AS MESLIQ360,
						 CONVERT(int,@diasliq360) AS DIASLIQ360,

                             (SELECT        dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA_2.S_NOM_PESSOA)) AS Expr1
                               FROM            AUTORIDADECOMPETENTE AS AUTORIDADECOMPETENTE_1 INNER JOIN
                                                         PESSOA AS PESSOA_2 ON AUTORIDADECOMPETENTE_1.N_PESSOA_PESSOA = PESSOA_2.N_PESSOA_PESSOA
                               WHERE        (AUTORIDADECOMPETENTE_1.N_SEQ_AUTDCOMPTT = 2)) AS DIRETOR,
                             (SELECT        dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(PESSOA_3.S_NOM_PESSOA)) AS USUARIO
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS USUARIO,
                             (SELECT        dbo.FN_PRIMEIRALETRAMAIUSCULA(LOWER(CARGO_3.S_DCR_CARGO)) AS [CARGO USUARIO]
                               FROM            PESSOA AS PESSOA_3 INNER JOIN
                                                         ORGANIZACAOPESSOA AS ORGANIZACAOPESSOA_3 ON PESSOA_3.N_PESSOA_PESSOA = ORGANIZACAOPESSOA_3.N_PESSOA_PESSOA INNER JOIN
                                                         CARGOORGANIZACAOPESSOA AS CARGOORGANIZACAOPESSOA_3 ON ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = CARGOORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA AND 
                                                         ORGANIZACAOPESSOA_3.N_ORG_ORG = CARGOORGANIZACAOPESSOA_3.N_ORG_ORG INNER JOIN
                                                         CARGO AS CARGO_3 ON CARGOORGANIZACAOPESSOA_3.N_ORG_ORG = CARGO_3.N_ORG_ORG AND CARGOORGANIZACAOPESSOA_3.N_CARGO_CARGO = CARGO_3.N_CARGO_CARGO
                               WHERE        (ORGANIZACAOPESSOA_3.N_ORG_ORG = 4) AND (ORGANIZACAOPESSOA_3.N_CODORI_ORGPESSOA = @MUsuario)) AS CARGO_USUARIO,
                               
							   (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'o Sr.' ELSE 'a Sra.' END) AS GENERO_SR,
							   (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'segurado' ELSE 'segurada' END) AS SEGURADOA,
							   (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'portador' ELSE 'portadora' END) AS GENERO_PORTADOR,
							   (CASE WHEN PESSOA.S_SEXO_PESSOA = 'M' THEN 'inscrito' ELSE 'inscrita' END) AS GENERO_INSCRITO,
							   (CASE WHEN CARGOORGANIZACAOPESSOA.N_ORG_ORG = 1 OR CARGOORGANIZACAOPESSOA.N_ORG_ORG = 2 THEN 'Administração Municipal Direta' ELSE 'Administração Municipal Indireta' END) AS ADM_MUNIC,
							   
						--CONVERT(int,@anosliq) AS ANO,					   
						--CONVERT(int,@mesliq) AS MES,
						--CONVERT(int,@diasliq) AS DIA,

							   (CASE WHEN 	(SELECT SUM((CONVERT (INT,SITUACAOFUNCIONAL.DT_FIMVIG_SITFUNC-SITUACAOFUNCIONAL.DT_INIVIG_SITFUNC+1))) 
						 FROM SITUACAOFUNCIONAL INNER JOIN
                         CARGOORGANIZACAOPESSOA ON SITUACAOFUNCIONAL.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA 
						 WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND SITUACAOFUNCIONAL.N_SEQ_CARGOORGPESSOA = 1 AND (SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 12 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 13 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 261 OR SITUACAOFUNCIONAL.N_TIPSITFUNC_TIPSITFUNC = 6)) IS NULL THEN ', já considerando as faltas e afastamentos dedutíveis.' ELSE ', já considerando as faltas e afastamentos dedutíveis.' END) AS CONDFALTAS,
						 
						(CASE WHEN @DInt = UPPER('S') THEN 'Gestor(a) Interino(a) de Benefícios Previdenciários' ELSE 'Gestor de Benefícios Previdenciários' END) AS CARGO_DIRETOR,
			  			(CASE WHEN @DInt = UPPER('S') THEN (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 5)) ELSE (SELECT dbo.[FN_PRIMEIRALETRAMAIUSCULA](LOWER(PESSOA.S_NOM_PESSOA)) FROM PESSOA INNER JOIN ORGANIZACAOPESSOA ON PESSOA.N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGOORGANIZACAOPESSOA ON CARGOORGANIZACAOPESSOA .N_PESSOA_PESSOA = ORGANIZACAOPESSOA.N_PESSOA_PESSOA AND CARGOORGANIZACAOPESSOA .N_CODORI_ORGPESSOA = ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = ORGANIZACAOPESSOA.N_ORG_ORG INNER JOIN CARGO  ON CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO INNER JOIN AUTORIDADECOMPETENTE ON PESSOA.N_PESSOA_PESSOA = AUTORIDADECOMPETENTE.N_PESSOA_PESSOA AND ORGANIZACAOPESSOA.N_ORG_ORG = AUTORIDADECOMPETENTE.N_ORG_ORG AND ORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = AUTORIDADECOMPETENTE.N_CODORI_ORGPESSOA WHERE (AUTORIDADECOMPETENTE.N_SEQ_AUTDCOMPTT = 2)) END) AS NOME_DIRETOR
						 						 	   							   							   						 						 	   							   							   
FROM            TEMPOSERVICOCALCULADO INNER JOIN
                         PESSOA ON TEMPOSERVICOCALCULADO.N_PESSOA_PESSOA = PESSOA.N_PESSOA_PESSOA INNER JOIN
                         CARGOORGANIZACAOPESSOA ON TEMPOSERVICOCALCULADO.N_PESSOACARGO_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA AND 
                         TEMPOSERVICOCALCULADO.N_SEQ_CARGOORGPESSOA = CARGOORGANIZACAOPESSOA.N_SEQ_CARGOORGPESSOA AND 
                         PESSOA.N_PESSOA_PESSOA = CARGOORGANIZACAOPESSOA.N_PESSOA_PESSOA INNER JOIN CARGO ON
						 CARGO.N_ORG_ORG = CARGOORGANIZACAOPESSOA.N_ORG_ORG AND
						 CARGO.N_CARGO_CARGO = CARGOORGANIZACAOPESSOA.N_CARGO_CARGO

WHERE CARGOORGANIZACAOPESSOA.N_CODORI_ORGPESSOA = @matricula AND TEMPOSERVICOCALCULADO.S_RESPTEMPO_TEMPOSERVCALC = 'I' AND CARGOORGANIZACAOPESSOA.N_ORG_ORG = @ente

ORDER BY N_SEQ_SIMULBNFEPFPESSOA DESC]]>
	</queryString>
