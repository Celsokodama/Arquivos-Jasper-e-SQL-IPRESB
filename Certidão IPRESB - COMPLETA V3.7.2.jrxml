			<textField>
				<reportElement x="-11" y="22" width="460" height="30" uuid="d95e8383-9820-4837-8baa-109eec176f5d"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["CERTIDÃO"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-11" y="73" width="461" height="308" uuid="b998975e-d92b-499f-ac13-bab6e1080608"/>
				<box>
					<pen lineWidth="0.0"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Arial" size="12" isBold="false"/>
					<paragraph lineSpacing="Double" firstLineIndent="60" leftIndent="14" rightIndent="14" spacingBefore="5" spacingAfter="5"/>
				</textElement>
				<textFieldExpression><![CDATA["Certifico, à vista dos assentamentos arquivados, que "+$F{GENERO_SR}+" <style isBold='true'>"+$F{NOME}+"</style>, "+$F{GENERO_PORTADOR}+" do <style isBold='true'>CPF nº "+$F{CPF} +"</style> " +$F{GENERO_INSCRITO}+" no <style isBold='true'>PIS/PASEP</style> sob o <style isBold='true'>nº "+$F{PIS}.substring(0, 3)+"."+$F{PIS}.substring(3, 8)+"."+$F{PIS}.substring(8, 10)+"-"+$F{PIS}.substring(10, 11)+"</style>, com matrícula funcional nº <style isBold='true'>"+$F{MATRICULA}+"</style> na <style isBold='true'>"+$F{ADM_MUNIC}+"</style> e com o cargo efetivo de  <style isBold='true'>"+$F{CARGO}+",</style> é "+$F{SEGURADOA}+" do <style isBold='true'>IPRESB – Instituto de Previdência Social dos Servidores Municipais de Barueri</style>, Regime Próprio de Previdência Social, criado pela Lei Complementar Municipal nº 171, de 26/10/2006, atualmente regulamentado pela Lei Complementar Municipal nº 434 de 14 de agosto de 2018, desde <style isBold='true'>"+DATEFORMAT($F{DATAINICIOIPRESB},"dd/MM/yyyy")+"</style>" + " até " + "<style isBold='true'>" + $F{DATAFIMIPRESB} +"</style>, com um tempo de contribuição total de <style isBold='true'>"+$F{DIASTOTALLIQ365} +"</style> dias ou <style isBold='true'>"+$F{ANOLIQ360}+"</style> ano(s), <style isBold='true'>"+$F{MESLIQ360}+" </style>mes(es) e <style isBold='true'>"+$F{DIASLIQ360}+" </style>dia(s)"+$F{CONDFALTAS}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="-11" y="381" width="461" height="31" uuid="3568dc3e-6b7d-47c0-ae79-5ab4b72bc074">
					<property name="com.jaspersoft.studio.unit.tabStopWidth" value="cm"/>
				</reportElement>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Arial" size="12"/>
					<paragraph leftIndent="11" rightIndent="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Local e Data: Barueri, "+ LOWER(DATEFORMAT(TODAY(),"d 'de' MMMM 'de' yyyy"))+"."]]></textFieldExpression>
			</textField>
